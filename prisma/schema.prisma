generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum TrainingSessionStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  TRIAL_ACTIVE
  PAYMENT_REQUIRED
  CONFIRMED
  CANCELLED
  PAYMENT_FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum CourseType {
  GENERAL_ENGLISH
  BUSINESS_ENGLISH
  ENGLISH_FOR_BANKERS
  CONVERSATION
  IELTS_PREPARATION
  BEGINNER_ENGLISH
  OTHER
}

enum DurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
}

enum ClassMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum LessonResourceType {
  PDF
  VIDEO_LINK
  EXTERNAL_LINK
  DOCUMENT
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

model User {
  id               Int               @id @default(autoincrement())
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  phoneNumber      String            @unique @map("phone_number")
  passwordHash     String            @map("password_hash")
  role             Role              @default(STUDENT)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  trainingSessions TrainingSession[]
  progress         Progress[]
  enrollments      Enrollment[]

  @@map("users")
}

model TrainingSession {
  id                   Int                   @id @default(autoincrement())
  name                 String
  courseId             Int                   @map("course_id")
  startDate            DateTime              @map("start_date")
  endDate              DateTime              @map("end_date")
  registrationDeadline DateTime              @map("registration_deadline")
  capacity             Int
  weekDays             String[]              @default([]) @map("week_days")
  startTime            String                @default("00:00") @map("start_time")
  endTime              String                @default("00:00") @map("end_time")
  platform             String?
  timezone             String                @default("Africa/Kinshasa")
  status               TrainingSessionStatus @default(DRAFT)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  classMeetings        ClassMeeting[]
  user                 User?                 @relation(fields: [userId], references: [id])
  userId               Int?

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

model Course {
  id               Int               @id @default(autoincrement())
  title            String
  slug             String            @unique
  description      String?
  shortDescription String?           @map("short_description")
  courseType       CourseType        @default(OTHER) @map("course_type")
  level            String?
  duration         String?
  durationValue    Int?              @map("duration_value")
  durationUnit     DurationUnit?     @map("duration_unit")
  objectives       String?
  targetAudience   String?           @map("target_audience")
  prerequisites    String?
  price            Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")
  trainingMode     String?           @map("training_mode")
  isPublished      Boolean           @default(false) @map("is_published")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  modules          CourseModule[]
  enrollments      Enrollment[]
  schedules        Schedule[]
  documents        Document[]
  trainingSessions TrainingSession[]
  assignments      Assignment[]

  @@map("courses")
}

model CourseModule {
  id          Int          @id @default(autoincrement())
  courseId    Int          @map("course_id")
  title       String
  description String?
  position    Int
  isPublished Boolean      @default(false) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id               Int              @id @default(autoincrement())
  courseModuleId   Int              @map("course_module_id")
  title            String
  description      String?
  content          String?
  position         Int
  estimatedMinutes Int?             @map("estimated_minutes")
  isPublished      Boolean          @default(false) @map("is_published")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  courseModule     CourseModule     @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  resources        LessonResource[]
  lessonProgress   LessonProgress[]
  progress         Progress[]
  documents        Document[]
  assignments      Assignment[]
  classMeetings    ClassMeeting[]

  @@unique([courseModuleId, position])
  @@index([courseModuleId])
  @@map("lessons")
}

model LessonResource {
  id        Int                @id @default(autoincrement())
  lessonId  Int                @map("lesson_id")
  title     String
  type      LessonResourceType
  url       String
  position  Int
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  lesson    Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
  @@map("lesson_resources")
}

model Enrollment {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @map("user_id")
  trainingSessionId     Int                    @map("training_session_id")
  status                EnrollmentStatus       @default(TRIAL_ACTIVE)
  enrolledAt            DateTime               @default(now()) @map("enrolled_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSession       TrainingSession        @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  course                Course?                @relation(fields: [courseId], references: [id])
  courseId              Int?
  payments              Payment[]
  attendances           Attendance[]
  lessonProgress        LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]

  @@unique([userId, trainingSessionId])
  @@index([trainingSessionId])
  @@map("enrollments")
}

model Assignment {
  id                  Int                    @id @default(autoincrement())
  courseId            Int                    @map("course_id")
  courseModuleId      Int?                   @map("course_module_id")
  lessonId            Int?                   @map("lesson_id")
  title               String
  instructions        String
  maxScore            Decimal                @map("max_score") @db.Decimal(6, 2)
  dueAt               DateTime?              @map("due_at")
  isPublished         Boolean                @default(false) @map("is_published")
  allowLateSubmission Boolean                @default(false) @map("allow_late_submission")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModule        CourseModule?          @relation(fields: [courseModuleId], references: [id], onDelete: SetNull)
  lesson              Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions         AssignmentSubmission[]

  @@index([courseId])
  @@index([courseModuleId])
  @@index([lessonId])
  @@index([isPublished])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id                  Int                        @id @default(autoincrement())
  assignmentId        Int                        @map("assignment_id")
  enrollmentId        Int                        @map("enrollment_id")
  answerText          String?                    @map("answer_text")
  answerUrl           String?                    @map("answer_url")
  status              AssignmentSubmissionStatus @default(DRAFT)
  submittedAt         DateTime?                  @map("submitted_at")
  score               Decimal?                   @db.Decimal(6, 2)
  feedback            String?
  gradedAt            DateTime?                  @map("graded_at")
  feedbackPublishedAt DateTime?                  @map("feedback_published_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  assignment          Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollment          Enrollment                 @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, enrollmentId])
  @@index([assignmentId])
  @@index([enrollmentId])
  @@index([status])
  @@map("assignment_submissions")
}

model LessonProgress {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @map("enrollment_id")
  lessonId     Int        @map("lesson_id")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model ClassMeeting {
  id                Int                @id @default(autoincrement())
  title             String?
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime           @map("ends_at")
  privateMeetingUrl String             @map("private_meeting_url")
  platform          MeetingPlatform    @default(OTHER)
  lessonId          Int?               @map("lesson_id")
  status            ClassMeetingStatus @default(SCHEDULED)
  trainingSessionId Int                @map("training_session_id")
  trainingSession   TrainingSession    @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  lesson            Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attendances       Attendance[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([trainingSessionId, startsAt])
  @@index([trainingSessionId])
  @@index([lessonId])
  @@map("class_meetings")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  enrollmentId   Int              @map("enrollment_id")
  classMeetingId Int              @map("class_meeting_id")
  status         AttendanceStatus
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classMeeting   ClassMeeting     @relation(fields: [classMeetingId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([enrollmentId, classMeetingId])
  @@index([classMeetingId])
  @@map("attendances")
}

model Payment {
  id                Int           @id @default(autoincrement())
  reference         String        @unique
  provider          String
  providerReference String?       @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  expiresAt         DateTime?     @map("expires_at")
  metadata          Json?
  enrollmentId      Int           @map("enrollment_id")
  enrollment        Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([enrollmentId])
  @@index([status])
  @@map("payments")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  meetingUrl String?  @map("meeting_url")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("schedules")
}

model Progress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  lessonId    Int       @map("lesson_id")
  percentage  Int       @default(0)
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("progress")
}

model Document {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  lessonId  Int?     @map("lesson_id")
  title     String
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@map("documents")
}
