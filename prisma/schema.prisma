  trainingSessionId Int                @map("training_session_id")
  trainingSession   TrainingSession    @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  lesson            CourseLesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attendances       Attendance[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([trainingSessionId, startsAt])
  @@index([trainingSessionId])
  @@index([lessonId])
  @@map("class_meetings")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  enrollmentId   Int              @map("enrollment_id")
  classMeetingId Int              @map("class_meeting_id")
  status         AttendanceStatus
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classMeeting   ClassMeeting     @relation(fields: [classMeetingId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([enrollmentId, classMeetingId])
  @@index([classMeetingId])
  @@map("attendances")
}

model Payment {
  id                Int               @id @default(autoincrement())
  reference         String            @unique
  provider          String
  providerReference String?           @map("provider_reference")
  amount            Decimal           @db.Decimal(10, 2)
  baseAmount        Decimal           @map("base_amount") @db.Decimal(10, 2)
  registrationFee   Decimal           @default(0) @map("registration_fee") @db.Decimal(10, 2)
  currency          String
  pricingMode       CoursePricingMode @map("pricing_mode")
  status            PaymentStatus     @default(PENDING)
  failureReason     String?           @map("failure_reason")
  paidAt            DateTime?         @map("paid_at")
  expiresAt         DateTime?         @map("expires_at")
  metadata          Json?
  enrollmentId      Int               @map("enrollment_id")
  courseId          Int               @map("course_id")
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([enrollmentId])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

model ManualPaymentMethod {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  type            String
  label           String
  beneficiaryName String?  @map("beneficiary_name")
  accountNumber   String?  @map("account_number")
  accountHolder   String?  @map("account_holder")
  bankName        String?  @map("bank_name")
  swiftCode       String?  @map("swift_code")
  bankBranch      String?  @map("bank_branch")
  currency        String   @default("USD")
  instructionsFr  String?  @map("instructions_fr")
  instructionsEn  String?  @map("instructions_en")
  isEnabled       Boolean  @default(false) @map("is_enabled")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isEnabled, displayOrder])
  @@map("manual_payment_methods")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  meetingUrl String?  @map("meeting_url")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("schedules")
}

model Progress {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  lessonId    Int          @map("lesson_id")
  percentage  Int          @default(0)
  completedAt DateTime?    @map("completed_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("progress")
}

model Document {
  id        Int           @id @default(autoincrement())
  courseId  Int           @map("course_id")
  lessonId  Int?          @map("lesson_id")
  title     String
  fileName  String        @map("file_name")
  filePath  String        @map("file_path")
  mimeType  String?       @map("mime_type")
  createdAt DateTime      @default(now()) @map("created_at")
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@map("documents")
}
