generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum TrainingSessionStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  TRIAL_ACTIVE
  PAYMENT_REQUIRED
  CONFIRMED
  CANCELLED
  PAYMENT_FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum CourseType {
  GENERAL_ENGLISH
  BUSINESS_ENGLISH
  ENGLISH_FOR_BANKERS
  CONVERSATION
  IELTS_PREPARATION
  BEGINNER_ENGLISH
  OTHER
}

enum DurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model User {
  id               Int               @id @default(autoincrement())
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  phoneNumber      String            @unique @map("phone_number")
  passwordHash     String            @map("password_hash")
  role             Role              @default(STUDENT)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  trainingSessions TrainingSession[]
  progress         Progress[]
  enrollments      Enrollment[]

  @@map("users")
}

model TrainingSession {
  id                   Int                   @id @default(autoincrement())
  name                 String
  courseId             Int                   @map("course_id")
  startDate            DateTime              @map("start_date")
  endDate              DateTime              @map("end_date")
  registrationDeadline DateTime              @map("registration_deadline")
  capacity             Int
  weekDays             String[]              @default([]) @map("week_days")
  startTime            String                @default("00:00") @map("start_time")
  endTime              String                @default("00:00") @map("end_time")
  platform             String?
  timezone             String                @default("Africa/Kinshasa")
  status               TrainingSessionStatus @default(DRAFT)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  classMeetings        ClassMeeting[]
  user                 User?                 @relation(fields: [userId], references: [id])
  userId               Int?

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

model Course {
  id               Int               @id @default(autoincrement())
  title            String
  slug             String            @unique
  description      String?
  shortDescription String?           @map("short_description")
  courseType       CourseType        @default(OTHER) @map("course_type")
  level            String?
  duration         String?
  durationValue    Int?              @map("duration_value")
  durationUnit     DurationUnit?     @map("duration_unit")
  objectives       String?
  targetAudience   String?           @map("target_audience")
  prerequisites    String?
  price            Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")
  trainingMode     String?           @map("training_mode")
  isPublished      Boolean           @default(false) @map("is_published")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  lessons          Lesson[]
  enrollments      Enrollment[]
  schedules        Schedule[]
  documents        Document[]
  trainingSessions TrainingSession[]

  @@map("courses")
}

model Lesson {
  id        Int        @id @default(autoincrement())
  courseId  Int        @map("course_id")
  title     String
  content   String?
  position  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Progress[]
  documents Document[]

  @@index([courseId])
  @@map("lessons")
}

model Enrollment {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  trainingSessionId Int              @map("training_session_id")
  status            EnrollmentStatus @default(TRIAL_ACTIVE)
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSession   TrainingSession  @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  course            Course?          @relation(fields: [courseId], references: [id])
  courseId          Int?
  payments          Payment[]
  attendances       Attendance[]

  @@unique([userId, trainingSessionId])
  @@index([trainingSessionId])
  @@map("enrollments")
}

model ClassMeeting {
  id                Int             @id @default(autoincrement())
  title             String?
  startsAt          DateTime        @map("starts_at")
  endsAt            DateTime        @map("ends_at")
  privateMeetingUrl String          @map("private_meeting_url")
  trainingSessionId Int             @map("training_session_id")
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  attendances       Attendance[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([trainingSessionId])
  @@map("class_meetings")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  enrollmentId   Int              @map("enrollment_id")
  classMeetingId Int              @map("class_meeting_id")
  status         AttendanceStatus
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classMeeting   ClassMeeting     @relation(fields: [classMeetingId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([enrollmentId, classMeetingId])
  @@index([classMeetingId])
  @@map("attendances")
}

model Payment {
  id                Int           @id @default(autoincrement())
  reference         String        @unique
  provider          String
  providerReference String?       @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  expiresAt         DateTime?     @map("expires_at")
  metadata          Json?
  enrollmentId      Int           @map("enrollment_id")
  enrollment        Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([enrollmentId])
  @@index([status])
  @@map("payments")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  meetingUrl String?  @map("meeting_url")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("schedules")
}

model Progress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  lessonId    Int       @map("lesson_id")
  percentage  Int       @default(0)
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("progress")
}

model Document {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  lessonId  Int?     @map("lesson_id")
  title     String
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@map("documents")
}
