  PENDING
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

model User {
  id                           Int                         @id @default(autoincrement())
  firstName                    String                      @map("first_name")
  lastName                     String                      @map("last_name")
  phoneNumber                  String                      @unique @map("phone_number")
  email                        String?                     @unique
  passwordHash                 String                      @map("password_hash")
  whatsappNumber               String?                     @map("whatsapp_number")
  mustChangePassword           Boolean                     @default(false) @map("must_change_password")
  role                         Role                        @default(STUDENT)
  isActive                     Boolean                     @default(true) @map("is_active")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  trainingSessions             TrainingSession[]
  progress                     Progress[]
  enrollments                  Enrollment[]
  teachingAssignments          TrainingSessionTeacher[]
  registrationGroupsTaught     RegistrationGroup[]
  passwordResetTokens          PasswordResetToken[]
  notifications                Notification[]
  scheduledReminders           ScheduledReminder[]
  createdAnnouncements         Announcement[]              @relation("AnnouncementCreator")
  whatsappPreference           WhatsAppPreference?
  whatsappDeliveries           WhatsAppDelivery[]
  certificatePayments          CertificatePayment[]        @relation("CertificateStudent")
  confirmedCertificatePayments CertificatePayment[]        @relation("CertificatePaymentConfirmer")
  waivedCertificateFees        CertificateRequest[]        @relation("CertificateFeeWaiverAdmin")
  issuedCertificates           Certificate[]               @relation("CertificateIssuer")
  revokedCertificates          Certificate[]               @relation("CertificateRevoker")
  createdAssessments           Assessment[]                @relation("AssessmentCreator")
  assessmentEvaluations        AssessmentEvaluation[]      @relation("AssessmentEvaluator")
  liveOralSessionsCreated      LiveOralSession[]           @relation("LiveOralSessionCreator")
  liveOralSessionsRescheduled  LiveOralSession[]           @relation("LiveOralSessionRescheduler")
  liveOralSessionsCancelled    LiveOralSession[]           @relation("LiveOralSessionCanceller")
  liveOralExaminerAssignments  LiveOralExaminer[]
  liveOralAttendancesMarked    LiveOralAttendance[]        @relation("LiveOralAttendanceMarker")
  oralSessionEvents            OralSessionEvent[]          @relation("OralSessionEventActor")
  lmsCoursesCreated            Course[]                    @relation("LmsCourseCreator")
  academicCohortsManaged       AcademicCohort[]            @relation("AcademicCohortManager")
  academicEnrollments          AcademicEnrollment[]        @relation("AcademicStudent")
  academicTeacherAssignments   AcademicTeacherAssignment[] @relation("AcademicTeacher")
  academicTeacherAssignmentsBy AcademicTeacherAssignment[] @relation("AcademicTeacherAssigner")
  academicSessionsTaught       AcademicSession[]           @relation("AcademicSessionTeacher")
  academicAttendancesRecorded  AcademicAttendance[]        @relation("AcademicAttendanceRecorder")
  academicAuditEvents          AcademicAuditLog[]          @relation("AcademicAuditActor")
  academicGroupTransfers       AcademicGroupTransfer[]
  studentInvoices              StudentInvoice[]            @relation("FinancialStudent")
  studentPaymentsRecorded      StudentPayment[]            @relation("StudentPaymentRecorder")
  financialAuditEvents         FinancialAuditLog[]         @relation("FinancialAuditActor")
  centerSettingsUpdates        CenterSettings[]            @relation("CenterSettingsUpdater")
  centerSettingsAudits         CenterSettingsAudit[]       @relation("CenterSettingsAuditActor")
  privateSettingFiles          PrivateSettingFile[]        @relation("PrivateSettingFileUploader")
  databaseBackups              DatabaseBackup[]            @relation("DatabaseBackupCreator")
  backupAuditEvents            BackupAuditLog[]            @relation("BackupAuditActor")

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model Notification {
  id                 Int                  @id @default(autoincrement())
  userId             Int                  @map("user_id")
  type               NotificationType
  priority           NotificationPriority @default(NORMAL)
  channel            NotificationChannel  @default(IN_APP)
  title              String
  message            String
  actionUrl          String?              @map("action_url")
  relatedEntity      String?              @map("related_entity")
  relatedId          Int?                 @map("related_id")
  deduplicationKey   String?              @unique @map("deduplication_key")
  readAt             DateTime?            @map("read_at")
  deletedAt          DateTime?            @map("deleted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappDeliveries WhatsAppDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model WhatsAppPreference {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  phoneNumber String?   @map("phone_number")
  isEnabled   Boolean   @default(false) @map("is_enabled")
  hasOptedIn  Boolean   @default(false) @map("has_opted_in")
  optedInAt   DateTime? @map("opted_in_at")
  optedOutAt  DateTime? @map("opted_out_at")
  verifiedAt  DateTime? @map("verified_at")
  source      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_preferences")
}

model WhatsAppDelivery {
  id                  Int                    @id @default(autoincrement())
  notificationId      Int?                   @map("notification_id")
  userId              Int                    @map("user_id")
  phoneNumber         String                 @map("phone_number")
  templateName        String                 @map("template_name")
  templateLanguage    String                 @map("template_language")
  templateParameters  Json?                  @map("template_parameters")
  status              WhatsAppDeliveryStatus @default(PENDING)
  providerMessageId   String?                @unique @map("provider_message_id")
  deduplicationKey    String                 @unique @map("deduplication_key")
  attempts            Int                    @default(0)
  scheduledFor        DateTime               @default(now()) @map("scheduled_for")
  processingStartedAt DateTime?              @map("processing_started_at")
  acceptedAt          DateTime?              @map("accepted_at")
  sentAt              DateTime?              @map("sent_at")
  deliveredAt         DateTime?              @map("delivered_at")
  readAt              DateTime?              @map("read_at")
  failedAt            DateTime?              @map("failed_at")
  cancelledAt         DateTime?              @map("cancelled_at")
  failureCode         String?                @map("failure_code")
  failureReason       String?                @map("failure_reason")
  lastAttemptAt       DateTime?              @map("last_attempt_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  notification        Notification?          @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@index([notificationId])
  @@map("whatsapp_deliveries")
}

model ScheduledReminder {
  id               Int                  @id @default(autoincrement())
  userId           Int                  @map("user_id")
  type             NotificationType
  priority         NotificationPriority @default(NORMAL)
  title            String
  message          String
  actionUrl        String?              @map("action_url")
  relatedEntity    String?              @map("related_entity")
  relatedId        Int?                 @map("related_id")
  scheduledFor     DateTime             @map("scheduled_for")
  status           ReminderStatus       @default(PENDING)
  attempts         Int                  @default(0)
  processedAt      DateTime?            @map("processed_at")
  failureReason    String?              @map("failure_reason")
  deduplicationKey String               @unique @map("deduplication_key")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([relatedEntity, relatedId])
  @@map("scheduled_reminders")
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  message        String
  actionUrl      String?  @map("action_url")
  audienceType   String   @map("audience_type")
  audienceRef    String?  @map("audience_ref")
  recipientCount Int      @default(0) @map("recipient_count")
  createdById    Int      @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("announcements")
}

model TrainingSession {
  id                   Int                      @id @default(autoincrement())
  name                 String
  courseId             Int                      @map("course_id")
  startDate            DateTime                 @map("start_date")
  endDate              DateTime                 @map("end_date")
  registrationDeadline DateTime                 @map("registration_deadline")
  capacity             Int
  weekDays             String[]                 @default([]) @map("week_days")
  startTime            String                   @default("00:00") @map("start_time")
  endTime              String                   @default("00:00") @map("end_time")
  platform             String?
  timezone             String                   @default("Africa/Kinshasa")
  status               TrainingSessionStatus    @default(DRAFT)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  course               Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  classMeetings        ClassMeeting[]
  user                 User?                    @relation(fields: [userId], references: [id])
  userId               Int?
  teachers             TrainingSessionTeacher[]
  assignments          Assignment[]
  certificateFee       Decimal?                 @map("certificate_fee") @db.Decimal(10, 2)
  assessments          Assessment[]
  liveOralSessions     LiveOralSession[]
  registrationGroups   RegistrationGroup[]

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

model RegistrationGroup {
  id                Int             @id @default(autoincrement())
  trainingSessionId Int             @map("training_session_id")
  name              String
  weekDays          String[]        @default([]) @map("week_days")
  startTime         String          @map("start_time")
  endTime           String          @map("end_time")
  capacity          Int
  isActive          Boolean         @default(true) @map("is_active")
  teacherId         Int?            @map("teacher_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  teacher           User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]

  @@unique([trainingSessionId, name])
  @@index([trainingSessionId, isActive])
  @@index([teacherId])
  @@map("registration_groups")
}

model Course {
  id               Int                @id @default(autoincrement())
  title            String
  slug             String             @unique
  description      String?
  shortDescription String?            @map("short_description")
  courseType       CourseType         @default(OTHER) @map("course_type")
  level            String?
  duration         String?
  durationValue    Int?               @map("duration_value")
  durationUnit     DurationUnit?      @map("duration_unit")
  objectives       String?
  targetAudience   String?            @map("target_audience")
  prerequisites    String?
  price            Decimal?           @db.Decimal(10, 2)
  currency         String             @default("USD")
  pricingMode      CoursePricingMode? @default(ONE_TIME) @map("pricing_mode")
  pricingActive    Boolean            @default(true) @map("pricing_active")
  registrationFee  Decimal            @default(0) @map("registration_fee") @db.Decimal(10, 2)
  maxInstallments  Int                @default(1) @map("max_installments")
  pricingStartsAt  DateTime?          @map("pricing_starts_at")
  pricingEndsAt    DateTime?          @map("pricing_ends_at")
  trainingMode     String?            @map("training_mode")
  isPublished      Boolean            @default(false) @map("is_published")
  lmsStatus        LmsCourseStatus    @default(DRAFT) @map("lms_status")
  createdById      Int?               @map("created_by_id")
  publishedAt      DateTime?          @map("published_at")
  closedAt         DateTime?          @map("closed_at")
  archivedAt       DateTime?          @map("archived_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  modules          CourseModule[]
  enrollments      Enrollment[]
  schedules        Schedule[]
  documents        Document[]
  trainingSessions TrainingSession[]
  assignments      Assignment[]
  certificateFee   Decimal?           @map("certificate_fee") @db.Decimal(10, 2)
  assessments      Assessment[]
  createdBy        User?              @relation("LmsCourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  academicCohorts  AcademicCohort[]
  payments         Payment[]

  @@index([lmsStatus])
  @@index([createdById])
  @@map("courses")
}

model CourseModule {
  id                   Int             @id @default(autoincrement())
  courseId             Int             @map("course_id")
  title                String
  description          String?
  position             Int
  isPublished          Boolean         @default(false) @map("is_published")
  availableAt          DateTime?       @map("available_at")
  prerequisiteModuleId Int?            @map("prerequisite_module_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  course               Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons              CourseLesson[]
  assignments          Assignment[]
  chapters             CourseChapter[]
  prerequisiteModule   CourseModule?   @relation("CourseModulePrerequisite", fields: [prerequisiteModuleId], references: [id], onDelete: SetNull)
  dependentModules     CourseModule[]  @relation("CourseModulePrerequisite")

  @@unique([courseId, position])
  @@index([courseId])
  @@index([prerequisiteModuleId])
  @@map("course_modules")
}

model CourseChapter {
  id             Int            @id @default(autoincrement())
  courseModuleId Int            @map("course_module_id")
  title          String
  description    String?
  position       Int
  isPublished    Boolean        @default(false) @map("is_published")
  availableAt    DateTime?      @map("available_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  courseModule   CourseModule   @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  lessons        CourseLesson[]

  @@unique([courseModuleId, position])
  @@index([courseModuleId])
  @@map("course_chapters")
}

model CourseLesson {
  id               Int                  @id @default(autoincrement())
  courseModuleId   Int                  @map("course_module_id")
  courseChapterId  Int?                 @map("course_chapter_id")
  assessmentId     Int?                 @map("assessment_id")
  type             LessonType           @default(TEXT)
  completionRule   LessonCompletionRule @default(IMMEDIATE) @map("completion_rule")
  title            String
  description      String?
  content          String?
  externalUrl      String?              @map("external_url")
  position         Int
  estimatedMinutes Int?                 @map("estimated_minutes")
  isPublished      Boolean              @default(false) @map("is_published")
  availableAt      DateTime?            @map("available_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  courseModule     CourseModule         @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  courseChapter    CourseChapter?       @relation(fields: [courseChapterId], references: [id], onDelete: SetNull)
  assessment       Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  resources        LessonResource[]
  lessonProgress   LessonProgress[]
  progress         Progress[]
  documents        Document[]
  assignments      Assignment[]
  classMeetings    ClassMeeting[]
  academicSessions AcademicSession[]

  @@unique([courseChapterId, position])
  @@index([courseModuleId])
  @@index([courseChapterId])
  @@index([assessmentId])
  @@map("lessons")
}

model AcademicCohort {
  id                 Int                         @id @default(autoincrement())
  name               String
  code               String                      @unique
  level              AcademicLevel
  courseId           Int                         @map("course_id")
  startDate          DateTime                    @map("start_date")
  endDate            DateTime                    @map("end_date")
  capacity           Int
  status             CohortStatus                @default(DRAFT)
  academicManagerId  Int?                        @map("academic_manager_id")
  description        String?
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  course             Course                      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicManager    User?                       @relation("AcademicCohortManager", fields: [academicManagerId], references: [id], onDelete: SetNull)
  groups             AcademicGroup[]
  enrollments        AcademicEnrollment[]
  teacherAssignments AcademicTeacherAssignment[]

  @@index([level, status])
  @@index([courseId, status])
  @@index([academicManagerId])
  @@index([startDate, endDate])
  @@map("academic_cohorts")
}

model AcademicGroup {
  id             Int                         @id @default(autoincrement())
  cohortId       Int                         @map("cohort_id")
  name           String
  code           String
  capacity       Int
  modality       AcademicGroupModality
  locationOrUrl  String?                     @map("location_or_url")
