generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
}

enum TrainingSessionStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  TRIAL_ACTIVE
  PAYMENT_REQUIRED
  CONFIRMED
  CANCELLED
  PAYMENT_FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum CourseType {
  GENERAL_ENGLISH
  BUSINESS_ENGLISH
  ENGLISH_FOR_BANKERS
  CONVERSATION
  IELTS_PREPARATION
  BEGINNER_ENGLISH
  OTHER
}

enum DurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
}

enum ClassMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum LessonResourceType {
  PDF
  VIDEO_LINK
  EXTERNAL_LINK
  DOCUMENT
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum NotificationType {
  LIVE_CLASS_REMINDER
  LIVE_CLASS_CANCELLED
  LIVE_CLASS_RESCHEDULED
  ASSIGNMENT_PUBLISHED
  ASSIGNMENT_DEADLINE_REMINDER
  ASSIGNMENT_GRADED
  FEEDBACK_PUBLISHED
  PAYMENT_REQUIRED
  PAYMENT_CONFIRMED
  ENROLLMENT_CONFIRMED
  TRIAL_ENDING
  TEACHER_ASSIGNED
  TEACHER_UNASSIGNED
  GENERAL_ANNOUNCEMENT
  CERTIFICATE_AVAILABLE
  CERTIFICATE_PAYMENT_REQUIRED
  CERTIFICATE_PAYMENT_CONFIRMED
  CERTIFICATE_FEE_WAIVED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
}

enum CertificatePaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum WhatsAppDeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

model User {
  id                           Int                      @id @default(autoincrement())
  firstName                    String                   @map("first_name")
  lastName                     String                   @map("last_name")
  phoneNumber                  String                   @unique @map("phone_number")
  passwordHash                 String                   @map("password_hash")
  role                         Role                     @default(STUDENT)
  isActive                     Boolean                  @default(true) @map("is_active")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  trainingSessions             TrainingSession[]
  progress                     Progress[]
  enrollments                  Enrollment[]
  teachingAssignments          TrainingSessionTeacher[]
  notifications                Notification[]
  scheduledReminders           ScheduledReminder[]
  createdAnnouncements         Announcement[]           @relation("AnnouncementCreator")
  whatsappPreference           WhatsAppPreference?
  whatsappDeliveries           WhatsAppDelivery[]
  certificatePayments          CertificatePayment[]     @relation("CertificateStudent")
  confirmedCertificatePayments CertificatePayment[]     @relation("CertificatePaymentConfirmer")
  waivedCertificateFees        CertificateRequest[]     @relation("CertificateFeeWaiverAdmin")
  issuedCertificates           Certificate[]            @relation("CertificateIssuer")
  revokedCertificates          Certificate[]            @relation("CertificateRevoker")

  @@map("users")
}

model Notification {
  id                 Int                  @id @default(autoincrement())
  userId             Int                  @map("user_id")
  type               NotificationType
  priority           NotificationPriority @default(NORMAL)
  channel            NotificationChannel  @default(IN_APP)
  title              String
  message            String
  actionUrl          String?              @map("action_url")
  relatedEntity      String?              @map("related_entity")
  relatedId          Int?                 @map("related_id")
  deduplicationKey   String?              @unique @map("deduplication_key")
  readAt             DateTime?            @map("read_at")
  deletedAt          DateTime?            @map("deleted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappDeliveries WhatsAppDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model WhatsAppPreference {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  phoneNumber String?   @map("phone_number")
  isEnabled   Boolean   @default(false) @map("is_enabled")
  hasOptedIn  Boolean   @default(false) @map("has_opted_in")
  optedInAt   DateTime? @map("opted_in_at")
  optedOutAt  DateTime? @map("opted_out_at")
  verifiedAt  DateTime? @map("verified_at")
  source      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_preferences")
}

model WhatsAppDelivery {
  id                  Int                    @id @default(autoincrement())
  notificationId      Int?                   @map("notification_id")
  userId              Int                    @map("user_id")
  phoneNumber         String                 @map("phone_number")
  templateName        String                 @map("template_name")
  templateLanguage    String                 @map("template_language")
  templateParameters  Json?                  @map("template_parameters")
  status              WhatsAppDeliveryStatus @default(PENDING)
  providerMessageId   String?                @unique @map("provider_message_id")
  deduplicationKey    String                 @unique @map("deduplication_key")
  attempts            Int                    @default(0)
  scheduledFor        DateTime               @default(now()) @map("scheduled_for")
  processingStartedAt DateTime?              @map("processing_started_at")
  acceptedAt          DateTime?              @map("accepted_at")
  sentAt              DateTime?              @map("sent_at")
  deliveredAt         DateTime?              @map("delivered_at")
  readAt              DateTime?              @map("read_at")
  failedAt            DateTime?              @map("failed_at")
  cancelledAt         DateTime?              @map("cancelled_at")
  failureCode         String?                @map("failure_code")
  failureReason       String?                @map("failure_reason")
  lastAttemptAt       DateTime?              @map("last_attempt_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  notification        Notification?          @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@index([notificationId])
  @@map("whatsapp_deliveries")
}

model ScheduledReminder {
  id               Int                  @id @default(autoincrement())
  userId           Int                  @map("user_id")
  type             NotificationType
  priority         NotificationPriority @default(NORMAL)
  title            String
  message          String
  actionUrl        String?              @map("action_url")
  relatedEntity    String?              @map("related_entity")
  relatedId        Int?                 @map("related_id")
  scheduledFor     DateTime             @map("scheduled_for")
  status           ReminderStatus       @default(PENDING)
  attempts         Int                  @default(0)
  processedAt      DateTime?            @map("processed_at")
  failureReason    String?              @map("failure_reason")
  deduplicationKey String               @unique @map("deduplication_key")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([relatedEntity, relatedId])
  @@map("scheduled_reminders")
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  message        String
  actionUrl      String?  @map("action_url")
  audienceType   String   @map("audience_type")
  audienceRef    String?  @map("audience_ref")
  recipientCount Int      @default(0) @map("recipient_count")
  createdById    Int      @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("announcements")
}

model TrainingSession {
  id                   Int                      @id @default(autoincrement())
  name                 String
  courseId             Int                      @map("course_id")
  startDate            DateTime                 @map("start_date")
  endDate              DateTime                 @map("end_date")
  registrationDeadline DateTime                 @map("registration_deadline")
  capacity             Int
  weekDays             String[]                 @default([]) @map("week_days")
  startTime            String                   @default("00:00") @map("start_time")
  endTime              String                   @default("00:00") @map("end_time")
  platform             String?
  timezone             String                   @default("Africa/Kinshasa")
  status               TrainingSessionStatus    @default(DRAFT)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  course               Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  classMeetings        ClassMeeting[]
  user                 User?                    @relation(fields: [userId], references: [id])
  userId               Int?
  teachers             TrainingSessionTeacher[]
  assignments          Assignment[]
  certificateFee       Decimal?                 @map("certificate_fee") @db.Decimal(10, 2)

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

model Course {
  id               Int               @id @default(autoincrement())
  title            String
  slug             String            @unique
  description      String?
  shortDescription String?           @map("short_description")
  courseType       CourseType        @default(OTHER) @map("course_type")
  level            String?
  duration         String?
  durationValue    Int?              @map("duration_value")
  durationUnit     DurationUnit?     @map("duration_unit")
  objectives       String?
  targetAudience   String?           @map("target_audience")
  prerequisites    String?
  price            Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")
  trainingMode     String?           @map("training_mode")
  isPublished      Boolean           @default(false) @map("is_published")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  modules          CourseModule[]
  enrollments      Enrollment[]
  schedules        Schedule[]
  documents        Document[]
  trainingSessions TrainingSession[]
  assignments      Assignment[]
  certificateFee   Decimal?          @map("certificate_fee") @db.Decimal(10, 2)

  @@map("courses")
}

model CourseModule {
  id          Int          @id @default(autoincrement())
  courseId    Int          @map("course_id")
  title       String
  description String?
  position    Int
  isPublished Boolean      @default(false) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id               Int              @id @default(autoincrement())
  courseModuleId   Int              @map("course_module_id")
  title            String
  description      String?
  content          String?
  position         Int
  estimatedMinutes Int?             @map("estimated_minutes")
  isPublished      Boolean          @default(false) @map("is_published")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  courseModule     CourseModule     @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  resources        LessonResource[]
  lessonProgress   LessonProgress[]
  progress         Progress[]
  documents        Document[]
  assignments      Assignment[]
  classMeetings    ClassMeeting[]

  @@unique([courseModuleId, position])
  @@index([courseModuleId])
  @@map("lessons")
}

model LessonResource {
  id        Int                @id @default(autoincrement())
  lessonId  Int                @map("lesson_id")
  title     String
  type      LessonResourceType
  url       String
  position  Int
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  lesson    Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
  @@map("lesson_resources")
}

model Enrollment {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @map("user_id")
  trainingSessionId     Int                    @map("training_session_id")
  status                EnrollmentStatus       @default(TRIAL_ACTIVE)
  enrolledAt            DateTime               @default(now()) @map("enrolled_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSession       TrainingSession        @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  course                Course?                @relation(fields: [courseId], references: [id])
  courseId              Int?
  payments              Payment[]
  attendances           Attendance[]
  lessonProgress        LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  certificateRequest    CertificateRequest?
  certificatePayments   CertificatePayment[]

  @@unique([userId, trainingSessionId])
  @@index([trainingSessionId])
  @@map("enrollments")
}

model CertificateSettings {
  id               Int      @id @default(1)
  certificatesPaid Boolean  @default(false) @map("certificates_paid")
  generalAmount    Decimal  @default(0) @map("general_amount") @db.Decimal(10, 2)
  currency         String   @default("USD")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("certificate_settings")
}

model CertificateRequest {
  id                 Int          @id @default(autoincrement())
  enrollmentId       Int          @unique @map("enrollment_id")
  isFeeWaived        Boolean      @default(false) @map("is_fee_waived")
  feeWaivedByAdminId Int?         @map("fee_waived_by_admin_id")
  feeWaivedAt        DateTime?    @map("fee_waived_at")
  feeWaiverReason    String?      @map("fee_waiver_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  enrollment         Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  feeWaivedByAdmin   User?        @relation("CertificateFeeWaiverAdmin", fields: [feeWaivedByAdminId], references: [id], onDelete: SetNull)
  certificate        Certificate?

  @@index([feeWaivedByAdminId])
  @@map("certificate_requests")
}

model CertificatePayment {
  id                 Int                      @id @default(autoincrement())
  studentId          Int                      @map("student_id")
  enrollmentId       Int                      @map("enrollment_id")
  amount             Decimal                  @db.Decimal(10, 2)
  currency           String
  status             CertificatePaymentStatus @default(PENDING)
  paymentMethod      String                   @map("payment_method")
  reference          String                   @unique
  confirmedAt        DateTime?                @map("confirmed_at")
  confirmedByAdminId Int?                     @map("confirmed_by_admin_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  student            User                     @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  enrollment         Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  confirmedByAdmin   User?                    @relation("CertificatePaymentConfirmer", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId])
  @@index([enrollmentId, status])
  @@index([studentId])
  @@map("certificate_payments")
}

model Certificate {
  id                   Int                @id @default(autoincrement())
  certificateRequestId Int                @unique @map("certificate_request_id")
  serialNumber         String             @unique @map("serial_number")
  status               CertificateStatus  @default(ISSUED)
  issuedAt             DateTime           @default(now()) @map("issued_at")
  issuedByAdminId      Int                @map("issued_by_admin_id")
  revokedAt            DateTime?          @map("revoked_at")
  revokedByAdminId     Int?               @map("revoked_by_admin_id")
  revocationReason     String?            @map("revocation_reason")
  certificateRequest   CertificateRequest @relation(fields: [certificateRequestId], references: [id], onDelete: Restrict)
  issuedByAdmin        User               @relation("CertificateIssuer", fields: [issuedByAdminId], references: [id], onDelete: Restrict)
  revokedByAdmin       User?              @relation("CertificateRevoker", fields: [revokedByAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("certificates")
}

model Assignment {
  id                  Int                    @id @default(autoincrement())
  courseId            Int                    @map("course_id")
  courseModuleId      Int?                   @map("course_module_id")
  lessonId            Int?                   @map("lesson_id")
  trainingSessionId   Int?                   @map("training_session_id")
  title               String
  instructions        String
  maxScore            Decimal                @map("max_score") @db.Decimal(6, 2)
  dueAt               DateTime?              @map("due_at")
  isPublished         Boolean                @default(false) @map("is_published")
  allowLateSubmission Boolean                @default(false) @map("allow_late_submission")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseModule        CourseModule?          @relation(fields: [courseModuleId], references: [id], onDelete: SetNull)
  lesson              Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  trainingSession     TrainingSession?       @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  submissions         AssignmentSubmission[]

  @@index([courseId])
  @@index([courseModuleId])
  @@index([lessonId])
  @@index([trainingSessionId])
  @@index([isPublished])
  @@index([dueAt])
  @@map("assignments")
}

model TrainingSessionTeacher {
  id                Int             @id @default(autoincrement())
  trainingSessionId Int             @map("training_session_id")
  teacherId         Int             @map("teacher_id")
  isLeadTeacher     Boolean         @default(false) @map("is_lead_teacher")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  teacher           User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, teacherId])
  @@index([teacherId])
  @@index([trainingSessionId, isLeadTeacher])
  @@map("training_session_teachers")
}

model AssignmentSubmission {
  id                  Int                        @id @default(autoincrement())
  assignmentId        Int                        @map("assignment_id")
  enrollmentId        Int                        @map("enrollment_id")
  answerText          String?                    @map("answer_text")
  answerUrl           String?                    @map("answer_url")
  status              AssignmentSubmissionStatus @default(DRAFT)
  submittedAt         DateTime?                  @map("submitted_at")
  score               Decimal?                   @db.Decimal(6, 2)
  feedback            String?
  gradedAt            DateTime?                  @map("graded_at")
  feedbackPublishedAt DateTime?                  @map("feedback_published_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  assignment          Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollment          Enrollment                 @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, enrollmentId])
  @@index([assignmentId])
  @@index([enrollmentId])
  @@index([status])
  @@map("assignment_submissions")
}

model LessonProgress {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @map("enrollment_id")
  lessonId     Int        @map("lesson_id")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model ClassMeeting {
  id                Int                @id @default(autoincrement())
  title             String?
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime           @map("ends_at")
  privateMeetingUrl String             @map("private_meeting_url")
  platform          MeetingPlatform    @default(OTHER)
  lessonId          Int?               @map("lesson_id")
  status            ClassMeetingStatus @default(SCHEDULED)
  trainingSessionId Int                @map("training_session_id")
  trainingSession   TrainingSession    @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  lesson            Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attendances       Attendance[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([trainingSessionId, startsAt])
  @@index([trainingSessionId])
  @@index([lessonId])
  @@map("class_meetings")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  enrollmentId   Int              @map("enrollment_id")
  classMeetingId Int              @map("class_meeting_id")
  status         AttendanceStatus
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classMeeting   ClassMeeting     @relation(fields: [classMeetingId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([enrollmentId, classMeetingId])
  @@index([classMeetingId])
  @@map("attendances")
}

model Payment {
  id                Int           @id @default(autoincrement())
  reference         String        @unique
  provider          String
  providerReference String?       @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  expiresAt         DateTime?     @map("expires_at")
  metadata          Json?
  enrollmentId      Int           @map("enrollment_id")
  enrollment        Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([enrollmentId])
  @@index([status])
  @@map("payments")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  title      String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  meetingUrl String?  @map("meeting_url")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("schedules")
}

model Progress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  lessonId    Int       @map("lesson_id")
  percentage  Int       @default(0)
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("progress")
}

model Document {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  lessonId  Int?     @map("lesson_id")
  title     String
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@map("documents")
}
