{
  "name": "english-center",
  "version": "1.0.0",
  "description": "Plateforme simple de centre de formation d'anglais en ligne",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "notifications:process": "node src/jobs/processScheduledReminders.js",
    "notifications:sync-enrollments": "node src/jobs/syncEnrollmentReminders.js",
    "whatsapp:process": "node src/jobs/processWhatsAppDeliveries.js",
    "oral-audio:cleanup": "node src/jobs/cleanupOralAudio.js",
    "backup:create": "node scripts/backupCli.js create",
    "backup:list": "node scripts/backupCli.js list",
    "backup:verify": "node scripts/backupCli.js verify",
    "backup:cleanup": "node scripts/backupCli.js cleanup",
    "backup:restore": "node scripts/backupCli.js restore",
    "production:check": "node scripts/productionCheck.js",
    "test:responsive": "playwright test",
    "audit:responsive:prepare": "node scripts/prepareResponsiveAudit.js"
  },
  "keywords": [
    "english",
    "training",
    "express",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "file-type": "^20.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "music-metadata": "^11.8.3",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0"
  }
}
