<div class="section-heading"><div><p class="eyebrow"><%= item.status %></p><h1><%= item.title %></h1></div><div class="action-row"><% if (item.status === 'DRAFT') { %><a class="button button-secondary" href="<%= base %>/<%= item.id %>/edit">Modifier</a><form method="post" action="<%= base %>/<%= item.id %>/publish"><%- csrfField() %><button class="button">Publier</button></form><% } %><% if (item.status === 'PUBLISHED') { %><form method="post" action="<%= base %>/<%= item.id %>/close"><%- csrfField() %><button class="button button-danger">Fermer</button></form><% } %></div></div>
<article class="card"><p><%= item.instructions %></p><p><%= item.timeLimitMinutes ? `${item.timeLimitMinutes} minutes` : 'Sans limite de temps' %> · <%= item.maxAttempts %> tentative(s)</p></article>
<h2>Questions</h2><% item.questions.forEach(q => { %><article class="card"><p class="eyebrow"><%= q.type %> · <%= q.points %> point(s)</p><h3><%= q.position %>. <%= q.prompt %></h3><% if (q.mediaStorageKey) { %><audio controls src="<%= base %>/<%= item.id %>/questions/<%= q.id %>/audio"></audio><% } %><% if (item.status === 'DRAFT' && ['LISTENING','LISTENING_COMPREHENSION'].includes(q.type)) { %><form method="post" enctype="multipart/form-data" action="<%= base %>/<%= item.id %>/questions/<%= q.id %>/audio"><%- csrfField() %><input type="file" name="audio" accept="audio/*" required><button class="button">Ajouter l’audio privé</button></form><% } %></article><% }) %>
<h2>Tentatives</h2><div class="card-grid"><% attempts.forEach(a => { %><article class="card"><h3><%= a.enrollment.user.firstName %> <%= a.enrollment.user.lastName %></h3><p><%= a.status %> · tentative <%= a.attemptNumber %></p><a class="button button-secondary" href="<%= attemptBase %>/<%= a.id %>">Consulter</a></article><% }) %></div><% if (!attempts.length) { %><p class="empty-state">Aucune tentative.</p><% } %>
