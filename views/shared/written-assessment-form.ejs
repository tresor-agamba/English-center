<form method="post" action="<%= action %>" class="card form-stack">
<label>Titre<input name="title" value="<%= item?.title || '' %>" required></label><label>Formation<select name="courseId" required><% courses.forEach(c => { %><option value="<%= c.id %>" <%= item?.courseId === c.id ? 'selected' : '' %>><%= c.title %></option><% }) %></select></label>
<label>Session<select name="trainingSessionId"><option value="">Toutes les sessions</option><% sessions.forEach(s => { %><option value="<%= s.id %>" <%= item?.trainingSessionId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
<label>Consignes<textarea name="instructions" required><%= item?.instructions || '' %></textarea></label><label>Description<textarea name="description"><%= item?.description || '' %></textarea></label>
<label>Total des points<input type="number" step="0.01" name="totalPoints" value="<%= item?.totalPoints || 20 %>" required></label><label>Seuil de réussite<input type="number" step="0.01" name="passingScore" value="<%= item?.passingScore || 10 %>" required></label>
<label>Temps limite en minutes<input type="number" name="timeLimitMinutes" min="1" value="<%= item?.timeLimitMinutes || '' %>"></label><label>Tentatives autorisées<input type="number" name="maxAttempts" value="<%= item?.maxAttempts || 1 %>" min="1" required></label>
<label>Ouverture<input type="datetime-local" name="openAt" value="<%= item?.openAt ? new Date(item.openAt.getTime() - item.openAt.getTimezoneOffset() * 60000).toISOString().slice(0,16) : '' %>"></label><label>Fermeture<input type="datetime-local" name="closeAt" value="<%= item?.closeAt ? new Date(item.closeAt.getTime() - item.closeAt.getTimezoneOffset() * 60000).toISOString().slice(0,16) : '' %>"></label>
<label>Questions JSON<textarea name="questions" rows="16" required><%= item ? JSON.stringify(item.questions.map(({id,assessmentId,createdAt,updatedAt,parentQuestionId,...q}) => ({...q, ...(parentQuestionId ? {parentPosition:item.questions.find(p => p.id === parentQuestionId)?.position} : {})})), null, 2) : '[{"type":"MULTIPLE_CHOICE","prompt":"Choisissez la bonne réponse.","options":["A","B","C"],"expectedAnswer":"A","points":10,"position":1,"explanation":"A est correcte."},{"type":"LONG_TEXT","prompt":"Expliquez votre réponse.","points":10,"position":2}]' %></textarea></label>
<p class="form-help">Types : MULTIPLE_CHOICE, MULTIPLE_SELECT, TRUE_FALSE, SHORT_TEXT, LONG_TEXT, FILL_IN_THE_BLANK, MATCHING, ORDERING, LISTENING et READING. Utilisez parentPosition pour rattacher une sous-question à un texte ou un audio.</p>
<button class="button">Enregistrer le brouillon</button></form>
