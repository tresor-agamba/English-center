<%- include('partials/header', { title }) %>

<section class="landing-hero">
  <div class="hero-copy reveal">
    <p class="eyebrow" data-i18n="hero.eyebrow">Live online language learning</p>
    <h1 data-i18n="hero.title">Master Languages. Unlock Opportunities.</h1>
    <p class="hero-lead" data-i18n="hero.copy">Follow structured online language programs with live guidance, practical activities and a dedicated student space.</p>
    <div class="hero-actions"><a class="button button-large" href="/register" data-i18n="hero.primary">Start Learning Today</a><a class="button button-large button-outline" href="/formations" data-i18n="hero.secondary">Explore Courses</a></div>
    <ul class="hero-trust" aria-label="Learning benefits" data-i18n-aria="a11y.learningBenefits"><li data-i18n="trust.live">Live Online Classes</li><li data-i18n="trust.path">Level-based pathways</li><li data-i18n="trust.flexible">Published schedules</li><li data-i18n="trust.verify">Verifiable certificates</li></ul>
  </div>
  <div class="hero-visual reveal" aria-label="Illustration of the student learning space" data-i18n-aria="a11y.studentPreview">
    <div class="visual-halo" aria-hidden="true"></div>
    <div class="visual-orbit orbit-one" aria-hidden="true"></div>
    <div class="visual-orbit orbit-two" aria-hidden="true"></div>
    <div class="visual-orbit orbit-three" aria-hidden="true"></div>
    <picture class="hero-photo-frame">
      <source srcset="/images/hero/young-congolese-learner-online-english.webp" type="image/webp" />
      <img class="hero-student-photo" src="/images/hero/young-congolese-learner-online-english.jpg" width="1280" height="853" alt="Étudiant congolais suivant un cours d’anglais en ligne sur son ordinateur" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="visual-card visual-float visual-float-top">
      <span class="visual-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Zm13 3.5 5-3v10l-5-3"/></svg></span>
      <strong data-i18n="visual.session">Upcoming session</strong>
    </div>
    <div class="visual-card visual-float visual-float-side">
      <span class="visual-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h10a2 2 0 0 1 2 2v12H5V5a2 2 0 0 1 2-2Zm2 4h6M9 10h6M8 17v4l4-2 4 2v-4"/></svg></span>
      <strong data-i18n="trust.verify">Verifiable certificates</strong>
    </div>
    <div class="visual-card visual-float visual-float-bottom">
      <span class="visual-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/><circle cx="12" cy="12" r="9"/></svg></span>
      <strong data-i18n="visual.progress">Progress tracked</strong>
    </div>
  </div>
</section>

<section class="trust-strip reveal" aria-label="Why learn with New Vision Academy" data-i18n-aria="a11y.whyGli"><span data-i18n="benefits.online">Online access</span><span data-i18n="benefits.interactive">Live guidance</span><span data-i18n="benefits.schedule">Clear schedules</span><span data-i18n="benefits.speaking">Practical activities</span><span data-i18n="benefits.support">Student follow-up</span></section>

<section class="landing-section courses-showcase" aria-labelledby="featured-courses-title">
  <div class="section-heading section-intro reveal"><div><p class="eyebrow" data-i18n="courses.eyebrow">Our programs</p><h2 id="featured-courses-title" data-i18n="courses.title">Find the course that fits your goals</h2><p data-i18n="courses.copy">Explore currently published programs and choose your next step.</p></div><a class="text-link" href="/formations" data-i18n="courses.all">Explore all courses</a></div>
  <% if (!courses.length) { %><div class="empty-state polished-empty"><strong data-i18n="courses.empty.title">No courses are currently available.</strong><p data-i18n="courses.empty.copy">New programs will be published soon.</p></div><% } else { %>
    <div class="course-grid landing-course-grid"><% courses.forEach((course) => { const typeLabel = formatCourseType(course.courseType); const durationLabel = formatDuration(course); %><article class="course-card premium-card reveal" data-course-id="<%= course.id %>"><div class="course-card-content"><div class="course-meta"><span <% if (!typeLabel) { %>data-i18n="fallback.category"<% } %>><%= typeLabel || 'Category not specified' %></span><% if (course.level) { %><span><%= course.level %></span><% } else { %><span data-i18n="fallback.level">Level not specified</span><% } %><span <% if (!durationLabel) { %>data-i18n="fallback.duration"<% } %>><%= durationLabel || 'Duration not specified' %></span></div><h3><%= course.title %></h3><p><%= course.shortDescription || course.description || '' %></p><% if (course.nextSessionStart) { %><small><span data-i18n="courses.nextSession">Next session</span> · <time data-local-date datetime="<%= course.nextSessionStart.toISOString() %>"><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(course.nextSessionStart) %></time></small><% } %></div><div class="course-card-actions"><a class="button button-small button-outline" href="/formations/<%= course.slug %>" data-i18n="courses.view">View course</a><a class="button button-small" href="/register?course=<%= course.id %>" data-i18n="courses.register">Register</a></div></article><% }) %></div>
  <% } %>
</section>

<section class="landing-section" id="why-us" aria-labelledby="why-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="why.eyebrow">Why choose New Vision Academy</p><h2 id="why-title" data-i18n="why.title">A structured environment for practical progress</h2></div>
  <div class="benefit-grid benefit-grid-six">
    <% [['◉','live'],['↗','progress'],['✓','test'],['▣','devices'],['◇','certificate'],['↔','support']].forEach(([icon,key]) => { %>
      <article class="feature-card reveal"><span class="feature-icon" aria-hidden="true"><%= icon %></span><h3 data-i18n="why.<%= key %>.title"></h3><p data-i18n="why.<%= key %>.copy"></p></article>
    <% }) %>
  </div>
</section>

<section class="landing-section course-format-section" aria-labelledby="course-format-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="format.eyebrow">Course experience</p><h2 id="course-format-title" data-i18n="format.title">How the courses work</h2><p data-i18n="format.copy">The exact schedule and delivery platform are shown only when configured for a published session.</p></div>
  <div class="format-grid">
    <% ['schedule','learning','practice','followup','assessment','certificate'].forEach((key) => { %>
      <article class="format-card reveal"><span class="format-marker" aria-hidden="true"></span><h3 data-i18n="format.<%= key %>.title"></h3><p data-i18n="format.<%= key %>.copy"></p></article>
    <% }) %>
  </div>
</section>

<section class="landing-section journey-section" aria-labelledby="journey-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="journey.eyebrow">Student journey</p><h2 id="journey-title" data-i18n="journey.title">From course choice to certification</h2><p data-i18n="journey.copy">The placement test applies only to requested levels that require it.</p></div>
  <ol class="journey-timeline">
    <% for (let step = 1; step <= 7; step += 1) { %><li class="journey-step reveal"><span><%= step %></span><div><h3 data-i18n="journey.<%= step %>.title"></h3><p data-i18n="journey.<%= step %>.copy"></p></div></li><% } %>
  </ol>
</section>

<section class="landing-section sessions-section" aria-labelledby="upcoming-sessions-title">
  <div class="section-heading section-intro reveal"><div><p class="eyebrow" data-i18n="sessions.eyebrow">Real availability</p><h2 id="upcoming-sessions-title" data-i18n="sessions.title">Upcoming open sessions</h2><p data-i18n="sessions.copy">Only future sessions with open registration are shown.</p></div><a class="text-link" href="/formations" data-i18n="sessions.all">Browse all programs</a></div>
  <% if (!upcomingSessions.length) { %><div class="empty-state polished-empty"><strong data-i18n="sessions.empty.title">No open session is available right now.</strong><p data-i18n="sessions.empty.copy">Explore the programs or contact the academy for future availability.</p><a class="button button-small" href="/contact" data-i18n="nav.contact">Contact</a></div><% } else { %>
    <div class="session-preview-grid"><% upcomingSessions.forEach((session) => { %><article class="session-preview-card reveal" data-session-id="<%= session.id %>"><div class="session-preview-top"><span class="status status-active" data-i18n="detail.open">Registration open</span><% if (session.course.level) { %><span><%= session.course.level %></span><% } else { %><span data-i18n="fallback.level">Level not specified</span><% } %></div><h3><%= session.course.title %></h3><p><%= session.name %></p><dl><div><dt data-i18n="detail.start">Start</dt><dd><time data-local-date datetime="<%= session.startDate.toISOString() %>"><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(session.startDate) %></time></dd></div><div><dt data-i18n="detail.hours">Hours</dt><dd><%= session.startTime %>–<%= session.endTime %> · <%= session.timezone %></dd></div><div><dt data-i18n="detail.platform">Platform</dt><% if (session.platform || session.course.trainingMode) { %><dd><%= session.platform || session.course.trainingMode %></dd><% } else { %><dd data-i18n="fallback.mode">Mode not specified</dd><% } %></div><div><dt data-i18n="sessions.places">Places available</dt><dd><%= session.remainingPlaces %> / <%= session.capacity %></dd></div></dl><a class="button" href="/register?session=<%= session.id %>" data-i18n="nav.register">Register</a></article><% }) %></div>
  <% } %>
</section>

<section class="landing-section dashboard-preview-section" aria-labelledby="dashboard-preview-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="dashboard.eyebrow">Student area preview</p><h2 id="dashboard-preview-title" data-i18n="dashboard.title">Keep your learning in one place</h2><p data-i18n="dashboard.copy">This simplified interface illustrates functions available in the real student area; it is not a learner record or screenshot.</p></div>
  <div class="dashboard-mock reveal" aria-label="Illustrative student dashboard preview" data-i18n-aria="a11y.dashboardPreview">
    <div class="mock-sidebar"><strong>NVA</strong><span data-i18n="dashboard.nav.overview">Overview</span><span data-i18n="dashboard.nav.courses">Courses</span><span data-i18n="dashboard.nav.assessments">Assessments</span></div>
    <div class="mock-content"><div class="mock-heading"><div><small data-i18n="dashboard.preview">Illustrative preview</small><h3 data-i18n="dashboard.welcome">Your learning overview</h3></div><span class="mock-notification" aria-hidden="true">●</span></div><div class="mock-grid"><article><span data-i18n="dashboard.next">Next session</span><strong data-i18n="dashboard.scheduled">See your schedule</strong></article><article><span data-i18n="dashboard.progress">Progress</span><div class="mock-progress"><i></i></div></article><article><span data-i18n="dashboard.certificates">Certificates</span><strong data-i18n="dashboard.verify">Access and verify</strong></article></div></div>
  </div>
</section>

<section class="landing-section faq-section" aria-labelledby="faq-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="faq.eyebrow">Frequently asked questions</p><h2 id="faq-title" data-i18n="faq.title">Clear answers before you begin</h2></div>
  <div class="faq-list" data-faq>
    <% for (let item = 1; item <= 8; item += 1) { const panelId = `faq-panel-${item}`; %><article class="faq-item"><h3><button type="button" aria-expanded="false" aria-controls="<%= panelId %>" id="faq-button-<%= item %>" data-faq-button><span data-i18n="faq.<%= item %>.question"></span><span aria-hidden="true">+</span></button></h3><div id="<%= panelId %>" role="region" aria-labelledby="faq-button-<%= item %>" data-faq-panel hidden><p data-i18n="faq.<%= item %>.answer"></p></div></article><% } %>
  </div>
</section>

<section class="final-cta reveal"><div><h2 data-i18n="cta.title">Ready to start your language journey?</h2><p data-i18n="cta.copy">Create your student account and choose from currently published programs.</p></div><a class="button button-large button-gold" href="/register" data-i18n="cta.button">Create My Account</a></section>

<%- include('partials/footer') %>
