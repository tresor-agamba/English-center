<%- include('partials/header', { title }) %>

<section class="stitch-hero" aria-labelledby="home-hero-title">
  <picture class="stitch-hero-media" aria-hidden="true"><source srcset="/images/hero/young-congolese-learner-online-english.webp" type="image/webp"><img src="/images/hero/young-congolese-learner-online-english.jpg" width="1280" height="853" alt="" loading="eager" fetchpriority="high" decoding="async"></picture>
  <div class="stitch-hero-overlay" aria-hidden="true"></div>
  <div class="stitch-hero-inner reveal">
    <h1 id="home-hero-title"><span data-i18n="stitch.hero.before">Master your future with</span> <span class="hero-accent" data-i18n="stitch.hero.accent">100% online training</span></h1>
    <p data-i18n="stitch.hero.copy">Language and professional development programs designed for your success. Learn at your pace, wherever you are.</p>
    <div class="hero-actions"><a class="button button-large button-gold" href="/formations" data-i18n="stitch.hero.courses">Explore courses</a><a class="button button-large hero-secondary" href="/register" data-i18n="nav.register">Register</a></div>
  </div>
</section>

<section class="trust-strip reveal" aria-label="Why learn with New Vision Academy" data-i18n-aria="a11y.whyGli"><span data-i18n="benefits.online">Online access</span><span data-i18n="benefits.interactive">Live guidance</span><span data-i18n="benefits.schedule">Clear schedules</span><span data-i18n="benefits.speaking">Practical activities</span><span data-i18n="benefits.support">Student follow-up</span></section>

<section class="landing-section stitch-benefits" id="why-us" aria-labelledby="why-title">
  <div class="section-intro centered-intro reveal"><h2 id="why-title" data-i18n="stitch.why.title">Why choose New Vision Academy?</h2><p data-i18n="stitch.why.copy">A modern teaching approach focused on practice and adapted to your professional needs.</p></div>
  <div class="stitch-bento">
    <% [['online','01'],['practice','02'],['support','03'],['flexibility','04'],['professional','05']].forEach(([key,number], index) => { %>
      <article class="stitch-benefit-card <%= index === 4 ? 'stitch-benefit-wide' : '' %> reveal"><span class="stitch-benefit-icon" aria-hidden="true"><%= number %></span><h3 data-i18n="stitch.why.<%= key %>.title"></h3><p data-i18n="stitch.why.<%= key %>.copy"></p></article>
    <% }) %>
  </div>
</section>

<section class="landing-section courses-showcase stitch-courses" aria-labelledby="featured-courses-title">
  <div class="section-heading section-intro reveal"><div><p class="eyebrow" data-i18n="courses.eyebrow">Our programs</p><h2 id="featured-courses-title" data-i18n="courses.title">Find the course that fits your goals</h2></div><a class="button button-small button-outline" href="/formations" data-i18n="courses.all">Explore all courses</a></div>
  <% if (!courses.length) { %><div class="empty-state polished-empty"><strong data-i18n="courses.empty.title">No courses are currently available.</strong><p data-i18n="courses.empty.copy">New programs will be published soon.</p></div><% } else { %>
    <div class="stitch-course-grid"><% courses.forEach((course) => { const typeLabel = formatCourseType(course.courseType); const durationLabel = formatDuration(course); const isOpen = course.upcomingSessionCount > 0; %><article class="stitch-course-card reveal" data-course-id="<%= course.id %>"><div class="stitch-course-top"><% if (course.trainingMode) { %><span><%= course.trainingMode %></span><% } %></div><div class="stitch-course-body"><div class="course-meta"><span <% if (!typeLabel) { %>data-i18n="fallback.category"<% } %>><%= typeLabel || 'Category not specified' %></span><span <% if (!durationLabel) { %>data-i18n="fallback.duration"<% } %>><%= durationLabel || 'Duration not specified' %></span></div><h3><%= course.title %></h3><div class="stitch-course-footer"><span class="course-availability <%= isOpen ? 'is-open' : '' %>" data-i18n="<%= isOpen ? 'stitch.courses.open' : 'stitch.courses.closed' %>"><%= isOpen ? 'Registration open' : 'No open session' %></span><a href="/formations/<%= course.slug %>" data-i18n="courses.view">View course</a></div></div></article><% }) %><a class="catalogue-card reveal" href="/formations"><span aria-hidden="true">&rarr;</span><strong data-i18n="stitch.courses.catalogue">Discover our full catalogue</strong></a></div>
  <% } %>
</section>

<section class="landing-section course-format-section" aria-labelledby="course-format-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="format.eyebrow">Course experience</p><h2 id="course-format-title" data-i18n="format.title">How the courses work</h2><p data-i18n="format.copy">The exact schedule and delivery platform are shown only when configured for a published session.</p></div>
  <div class="format-grid"><% ['schedule','learning','practice','followup','assessment','certificate'].forEach((key) => { %><article class="format-card reveal"><span class="format-marker" aria-hidden="true"></span><h3 data-i18n="format.<%= key %>.title"></h3><p data-i18n="format.<%= key %>.copy"></p></article><% }) %></div>
</section>

<section class="landing-section journey-section" aria-labelledby="journey-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="journey.eyebrow">Student journey</p><h2 id="journey-title" data-i18n="journey.title">From course choice to certification</h2><p data-i18n="journey.copy">The placement test applies only to requested levels that require it.</p></div>
  <ol class="journey-timeline"><% for (let step = 1; step <= 7; step += 1) { %><li class="journey-step reveal"><span><%= step %></span><div><h3 data-i18n="journey.<%= step %>.title"></h3><p data-i18n="journey.<%= step %>.copy"></p></div></li><% } %></ol>
</section>

<section class="landing-section sessions-section" aria-labelledby="upcoming-sessions-title">
  <div class="section-heading section-intro reveal"><div><p class="eyebrow" data-i18n="sessions.eyebrow">Real availability</p><h2 id="upcoming-sessions-title" data-i18n="sessions.title">Upcoming open sessions</h2><p data-i18n="sessions.copy">Only future sessions with open registration are shown.</p></div><a class="text-link" href="/formations" data-i18n="sessions.all">Browse all programs</a></div>
  <% if (!upcomingSessions.length) { %><div class="empty-state polished-empty"><strong data-i18n="sessions.empty.title">No open session is available right now.</strong><p data-i18n="sessions.empty.copy">Explore the programs or contact the academy for future availability.</p><a class="button button-small" href="/contact" data-i18n="nav.contact">Contact</a></div><% } else { %>
    <div class="session-preview-grid"><% upcomingSessions.forEach((session) => { %><article class="session-preview-card reveal" data-session-id="<%= session.id %>"><div class="session-preview-top"><span class="status status-active" data-i18n="detail.open">Registration open</span><% if (session.course.level) { %><span><%= session.course.level %></span><% } else { %><span data-i18n="fallback.level">Level not specified</span><% } %></div><h3><%= session.course.title %></h3><p><%= session.name %></p><dl><div><dt data-i18n="detail.start">Start</dt><dd><time data-local-date datetime="<%= session.startDate.toISOString() %>"><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(session.startDate) %></time></dd></div><div><dt data-i18n="detail.hours">Hours</dt><dd><%= session.startTime %>&ndash;<%= session.endTime %> &middot; <%= session.timezone %></dd></div><div><dt data-i18n="detail.platform">Platform</dt><% if (session.platform || session.course.trainingMode) { %><dd><%= session.platform || session.course.trainingMode %></dd><% } else { %><dd data-i18n="fallback.mode">Mode not specified</dd><% } %></div><div><dt data-i18n="sessions.places">Places available</dt><dd><%= session.remainingPlaces %> / <%= session.capacity %></dd></div></dl><a class="button" href="/register?session=<%= session.id %>" data-i18n="nav.register">Register</a></article><% }) %></div>
  <% } %>
</section>

<section class="landing-section dashboard-preview-section" aria-labelledby="dashboard-preview-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="dashboard.eyebrow">Student area preview</p><h2 id="dashboard-preview-title" data-i18n="dashboard.title">Keep your learning in one place</h2><p data-i18n="dashboard.copy">This simplified interface illustrates functions available in the real student area; it is not a learner record or screenshot.</p></div>
  <div class="dashboard-mock reveal" aria-label="Illustrative student dashboard preview" data-i18n-aria="a11y.dashboardPreview"><div class="mock-sidebar"><strong>NVA</strong><span data-i18n="dashboard.nav.overview">Overview</span><span data-i18n="dashboard.nav.courses">Courses</span><span data-i18n="dashboard.nav.assessments">Assessments</span></div><div class="mock-content"><div class="mock-heading"><div><small data-i18n="dashboard.preview">Illustrative preview</small><h3 data-i18n="dashboard.welcome">Your learning overview</h3></div><span class="mock-notification" aria-hidden="true">&#9679;</span></div><div class="mock-grid"><article><span data-i18n="dashboard.next">Next session</span><strong data-i18n="dashboard.scheduled">See your schedule</strong></article><article><span data-i18n="dashboard.progress">Progress</span><div class="mock-progress"><i></i></div></article><article><span data-i18n="dashboard.certificates">Certificates</span><strong data-i18n="dashboard.verify">Access and verify</strong></article></div></div></div>
</section>

<section class="landing-section faq-section" aria-labelledby="faq-title">
  <div class="section-intro reveal"><p class="eyebrow" data-i18n="faq.eyebrow">Frequently asked questions</p><h2 id="faq-title" data-i18n="faq.title">Clear answers before you begin</h2></div>
  <div class="faq-list" data-faq><% for (let item = 1; item <= 8; item += 1) { const panelId = `faq-panel-${item}`; %><article class="faq-item"><h3><button type="button" aria-expanded="false" aria-controls="<%= panelId %>" id="faq-button-<%= item %>" data-faq-button><span data-i18n="faq.<%= item %>.question"></span><span aria-hidden="true">+</span></button></h3><div id="<%= panelId %>" role="region" aria-labelledby="faq-button-<%= item %>" data-faq-panel hidden><p data-i18n="faq.<%= item %>.answer"></p></div></article><% } %></div>
</section>

<section class="final-cta stitch-final-cta reveal"><div><h2 data-i18n="stitch.cta.title">Ready to develop your skills?</h2><p data-i18n="stitch.cta.copy">Join New Vision Academy and begin your 100% online learning journey.</p></div><a class="button button-large button-gold" href="/register" data-i18n="cta.button">Create My Account</a></section>

<%- include('partials/footer') %>
