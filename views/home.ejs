<%- include('partials/header', { title }) %>

<div class="nva-home">
  <section class="stitch-hero" aria-labelledby="home-hero-title">
    <picture class="stitch-hero-media" aria-hidden="true">
      <source type="image/webp" srcset="/images/optimized/pic-1-640.webp 640w, /images/optimized/pic-1-1290.webp 1290w" sizes="100vw">
      <img src="/images/nva/pic-1.png" width="1290" height="860" alt="" loading="eager" fetchpriority="high" decoding="async">
    </picture>
    <div class="stitch-hero-overlay" aria-hidden="true"></div>
    <div class="stitch-hero-inner nva-home-hero__inner reveal">
      <h1 id="home-hero-title" data-i18n="arena.home.hero.title">New Vision Academy</h1>
      <p data-i18n="arena.home.hero.copy">Des formations pratiques, 100% en ligne, pour apprendre utilement depuis Kinshasa et partout en RDC.</p>
      <div class="hero-actions"><a class="nva-public-button nva-public-button-primary nva-home-button-large" href="/formations" data-i18n="arena.home.hero.primary">Découvrir les formations</a><a class="nva-public-button nva-home-button-large nva-home-button-dark-outline" href="/register" data-i18n="arena.home.hero.secondary">S'inscrire</a></div>
    </div>
  </section>

  <section class="nva-home-visual-story nva-home-visual-story--academy" aria-labelledby="academy-title">
    <img class="nva-home-visual-story__bg" src="/images/nva/pic-2.jpeg" width="1024" height="1024" alt="" aria-hidden="true" loading="lazy" decoding="async">
    <div class="nva-home-visual-story__overlay" aria-hidden="true"></div>
    <div class="nva-home-visual-story__inner reveal">
      <article class="nva-home-visual-story__copy">
        <p class="nva-home-eyebrow">New Vision Academy</p>
        <h2 id="academy-title" data-i18n="arena.home.academy.title">Une académie en ligne pour apprendre utilement, pas seulement regarder des cours.</h2>
        <p data-i18n="arena.home.academy.copy">NVA vous aide à passer des explications à l'action grâce à des formations courtes, suivies et adaptées aux réalités des apprenants en RDC.</p>
      </article>
    </div>
  </section>

  <section class="nva-home-approach" id="approche" aria-labelledby="approach-title"><div class="nva-home-container"><div class="nva-home-approach__composition reveal"><div class="nva-home-approach__photo-frame"><picture><source type="image/webp" srcset="/images/optimized/pic-3-480.webp 480w, /images/optimized/pic-3-768.webp 768w, /images/optimized/pic-3-1024.webp 1024w" sizes="(max-width: 620px) 100vw, 1152px"><img src="/images/nva/pic-3.png" width="1024" height="1024" alt="Apprenante New Vision Academy suivant une formation en ligne" loading="lazy" decoding="async"></picture></div><article class="nva-home-approach__card"><p class="nva-home-eyebrow" data-i18n="arena.home.approach.eyebrow">Approche NVA</p><h2 id="approach-title" data-i18n="arena.home.approach.title">Un cours doit produire une capacité réelle.</h2><p data-i18n="arena.home.approach.copy">Chaque module relie les notions à une action concrète : parler, produire, organiser, résoudre ou présenter quelque chose d'utile.</p></article></div></div></section>

  <section class="nva-home-visual-story nva-home-visual-story--practice" aria-labelledby="practice-title">
    <img class="nva-home-visual-story__bg" src="/images/nva/pic-4.jpeg" width="1024" height="1024" alt="" aria-hidden="true" loading="lazy" decoding="async">
    <div class="nva-home-visual-story__overlay" aria-hidden="true"></div>
    <div class="nva-home-visual-story__inner reveal">
      <article class="nva-home-visual-story__copy">
        <p class="nva-home-eyebrow nva-home-eyebrow--blue" data-i18n="arena.home.practice.eyebrow">Apprentissage pratique</p>
        <h2 id="practice-title" data-i18n="arena.home.practice.title">La pratique avant la théorie passive.</h2>
        <p class="nva-home-visual-story__intro" data-i18n="arena.home.practice.copy">Nous transformons les explications en pratique pour vous aider à utiliser réellement ce que vous apprenez.</p>
        <ol class="nva-home-visual-story__timeline"><% ["Des explications courtes pour comprendre l'essentiel.", "Des exercices guidés pour transformer le cours en action.", "Des retours pour progresser avec plus de confiance."].forEach((point, index) => { %><li><span aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span><p data-i18n="arena.home.practice.step<%= index + 1 %>"><%= point %></p></li><% }) %></ol>
      </article>
    </div>
  </section>

  <section class="nva-home-courses" aria-labelledby="featured-courses-title"><div class="nva-home-container"><div class="nva-home-section-copy nva-home-section-copy--wide reveal"><p class="nva-home-eyebrow" data-i18n="arena.home.courses.eyebrow">Formations</p><h2 id="featured-courses-title" data-i18n="arena.home.courses.title">Programmes à découvrir</h2><p data-i18n="arena.home.courses.copy">Découvrez nos formations pratiques et trouvez celle qui correspond à vos objectifs.</p></div><% if (!courseCards.length) { %><div class="nva-home-empty reveal"><strong data-i18n="courses.empty.title">Aucune formation n'est actuellement disponible.</strong><p data-i18n="courses.empty.copy">De nouveaux programmes seront publiés prochainement.</p></div><% } else { %><div class="stitch-course-grid"><% courseCards.forEach((courseCard) => { %><%- include('partials/public-course-card', { courseCard }) %><% }) %></div><% } %><div class="nva-home-courses__all reveal"><a class="nva-public-button nva-public-button-primary" href="/formations" data-i18n="arena.home.courses.all">Voir toutes les formations</a></div></div></section>

  <section class="nva-home-path" aria-labelledby="path-title"><div class="nva-home-container"><div class="nva-home-path__intro"><div class="nva-home-section-copy nva-home-section-copy--wide reveal"><p class="nva-home-eyebrow" data-i18n="arena.home.path.eyebrow">Comment ça marche</p><h2 id="path-title" data-i18n="arena.home.path.title">Un parcours clair, de l'inscription à la progression.</h2></div><figure class="nva-home-path__visual"><picture><source type="image/webp" srcset="/images/optimized/pic-10-480.webp 480w, /images/optimized/pic-10-768.webp 768w, /images/optimized/pic-10-1024.webp 1024w" sizes="(max-width: 620px) 100vw, 280px"><img src="/images/nva/pic-10.png" width="1024" height="1024" alt="Apprenant New Vision Academy satisfait de sa progression en ligne" loading="lazy" decoding="async"></picture></figure></div><ol class="nva-home-path__steps"><% [
    ['Choisissez votre formation', 'Consultez les programmes publiés et leurs prochaines sessions.'],
    ['Inscrivez-vous', 'Créez votre compte et choisissez le niveau adapté.'],
    ['Suivez vos cours en ligne', 'Accédez à votre parcours depuis votre espace apprenant.'],
    ['Pratiquez', 'Réalisez les activités prévues dans votre formation.'],
    ['Progressez', 'Suivez vos acquis et avancez avec des retours utiles.']
  ].forEach(([stepTitle, stepCopy], index) => { %><li class="reveal"><span aria-hidden="true"><%= index + 1 %></span><h3 data-i18n="arena.home.path.step<%= index + 1 %>.title"><%= stepTitle %></h3><p data-i18n="arena.home.path.step<%= index + 1 %>.copy"><%= stepCopy %></p></li><% }) %></ol></div></section>

  <section class="nva-home-activities" aria-labelledby="activities-title"><div class="nva-home-container"><div class="nva-home-activities__intro"><div class="nva-home-section-copy nva-home-section-copy--wide reveal"><p class="nva-home-eyebrow nva-home-eyebrow--blue" data-i18n="arena.home.activities.eyebrow">Apprentissage pratique</p><h2 id="activities-title" data-i18n="arena.home.activities.title">Des activités qui ressemblent à de vraies situations.</h2><p data-i18n="arena.home.activities.copy">Chaque activité vous aide à appliquer une compétence dans un contexte concret.</p></div><figure class="nva-home-activities__visual"><img src="/images/optimized/pic-6-480.webp" width="480" height="480" alt="Groupe d'apprenants collaborant sur une activité pratique" loading="lazy" decoding="async"></figure></div><div class="nva-home-activities__grid"><% ['Exercices guidés', 'Mises en situation', 'Études de cas', 'Projets pratiques', 'Simulations', 'Feedback', 'Application dans des situations réelles'].forEach((activity, index) => { %><div class="reveal"><span aria-hidden="true"></span><strong data-i18n="arena.home.activities.<%= index + 1 %>"><%= activity %></strong></div><% }) %></div></div></section>

  <section class="nva-home-benefits" id="why-us" aria-labelledby="why-title"><div class="nva-home-container"><div class="nva-home-section-copy nva-home-section-copy--wide reveal"><p class="nva-home-eyebrow" data-i18n="arena.home.why.eyebrow">Pourquoi NVA</p><h2 id="why-title" data-i18n="arena.home.why.title">Pourquoi apprendre avec NVA ?</h2></div><div class="stitch-bento"><% [
    ['100% en ligne', 'Apprenez depuis Kinshasa ou partout en RDC avec des outils accessibles.'],
    ['Accompagnement et feedback', 'Recevez des retours structurés pour progresser avec confiance.'],
    ['Rythme adapté aux personnes occupées', 'Organisez votre apprentissage autour de vos engagements.'],
    ['Compétences directement applicables', 'Transformez chaque notion en capacité utile dans des situations réelles.']
  ].forEach(([benefitTitle, benefitCopy], index) => { %><article class="nva-home-benefit reveal"><span aria-hidden="true"></span><h3 data-i18n="arena.home.why.<%= index + 1 %>.title"><%= benefitTitle %></h3><p data-i18n="arena.home.why.<%= index + 1 %>.copy"><%= benefitCopy %></p></article><% }) %></div></div></section>

  <section class="final-cta stitch-final-cta reveal"><div><h2 data-i18n="arena.home.cta.title">Prêt à développer de nouvelles compétences ?</h2><p data-i18n="arena.home.cta.copy">Découvrez nos formations, choisissez celle qui correspond à vos objectifs et rejoignez la prochaine session disponible.</p></div><div class="nva-home-final-cta__actions"><a class="nva-public-button nva-public-button-primary nva-home-button-large" href="/formations" data-i18n="arena.home.cta.primary">Voir les formations</a><a class="nva-public-button nva-home-button-large nva-home-button-dark-outline" href="/contact" data-i18n="arena.home.cta.secondary">Nous contacter</a></div></section>
</div>

<%- include('partials/footer') %>
