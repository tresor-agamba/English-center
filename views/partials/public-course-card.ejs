<article class="nva-public-course-card nva-public-course-card--<%= courseCard.status %>" data-public-course-card data-course-category="<%= courseCard.category %>" data-course-search="<%= courseCard.searchText %>">
  <div class="nva-public-course-card__media"><img src="/images/public/course-online-learning.jpg" alt="" width="760" height="506" loading="lazy"></div>
  <div class="nva-public-course-card__body"><div class="nva-public-course-card__badges"><span class="nva-public-badge nva-public-badge--category" data-i18n="<%= courseCard.categoryKey %>"><%= courseCard.categoryLabel %></span><span class="nva-public-badge nva-public-badge--<%= courseCard.status %>"><span class="nva-public-badge__dot" aria-hidden="true"></span><span data-i18n="<%= courseCard.statusKey %>"><%= courseCard.statusLabel %></span></span></div>
    <h3 class="nva-public-course-card__title"><%= courseCard.title %></h3><p class="nva-public-course-card__description"><%= courseCard.description %></p>
    <dl class="nva-public-course-card__facts"><% courseCard.facts.forEach((fact) => { %><div><dt data-i18n="<%= fact.labelKey %>"><%= fact.label %></dt><dd<% if (fact.valueKey) { %> data-i18n="<%= fact.valueKey %>"<% } %><% if (fact.durationValue && fact.durationUnit) { %> data-local-duration data-value="<%= fact.durationValue %>" data-unit="<%= fact.durationUnit %>"<% } %><% if (Number.isFinite(fact.amount)) { %> data-local-price data-amount="<%= fact.amount %>" data-currency="<%= fact.currency %>"<% } %>><%= fact.value %></dd></div><% }) %></dl>
    <div class="nva-public-course-card__actions"><a class="nva-public-button nva-public-button-secondary" href="/formations/<%= courseCard.slug %>" data-i18n="courses.view"><%= courseCard.detailsLabel %></a><% if (courseCard.canRegister) { %><a class="nva-public-button nva-public-button-primary" href="/register?course=<%= courseCard.id %>" data-i18n="courses.register"><%= courseCard.registerLabel %></a><% } %></div>
  </div>
</article>
