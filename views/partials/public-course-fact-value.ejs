<span<% if (fact.valueKey) { %> data-i18n="<%= fact.valueKey %>"<% } %><% if (fact.durationValue != null && fact.durationUnit) { %> data-local-duration data-value="<%= fact.durationValue %>" data-unit="<%= fact.durationUnit %>"<% } %><% if (fact.amount != null) { %> data-local-price data-currency-display="code" data-amount="<%= fact.amount %>" data-currency="<%= fact.currency %>"<% } %>><%= fact.value %></span><% if (fact.unitKey) { %> <span data-i18n="<%= fact.unitKey %>"><%= fact.unit %></span><% } %><% if (fact.perLevel) { %> <span data-i18n="structure.perLevel">/ niveau</span><% } %>
