<section class="course-structure-summary">
  <% if (presentation.totals.levelBased) { %><strong data-i18n="structure.complete">Parcours complet</strong><% } %>
  <p class="public-chip-row"><% presentation.programmeFacts.forEach((fact) => { %><span class="public-chip"><span><%- include('public-course-fact-value', { fact }) %></span></span><% }) %></p>
  <% if (presentation.indicativePrice) { %><p><span data-i18n="structure.totalPrice">Prix total indicatif</span> : <strong><%- include('public-course-fact-value', { fact: presentation.indicativePrice }) %></strong></p><% } %>
  <% if (presentation.totals.levelBased) { %><p data-i18n="structure.payment">Le paiement s’effectue niveau par niveau.</p><% } %>
</section>
