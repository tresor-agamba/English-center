<%- include('../partials/header', { title }) %>
<section class="auth-card card">
  <p class="eyebrow">Sécurité du compte</p><h1>Choisissez votre mot de passe</h1>
  <p>Vous utilisez un mot de passe temporaire. Définissez-en un nouveau avant d’accéder à votre espace étudiant.</p>
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/change-password">
    <label for="password">Nouveau mot de passe</label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
    <label for="passwordConfirmation">Confirmation</label><input id="passwordConfirmation" name="passwordConfirmation" type="password" minlength="8" autocomplete="new-password" required>
    <button class="button" type="submit">Enregistrer et continuer</button>
  </form>
</section>
<%- include('../partials/footer') %>
