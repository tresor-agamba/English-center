<%- include('../partials/header', { title }) %>
<% const fr = documentLanguage === 'fr'; %>
<section class="auth-card card">
  <h1 data-i18n="reset.title"><%= fr ? 'Réinitialiser le mot de passe' : 'Reset your password' %></h1>
  <% if (completed) { %>
    <p role="status" data-i18n="reset.done"><%= fr ? 'Votre mot de passe a été modifié.' : 'Your password has been changed.' %></p>
    <a class="button" href="/login" data-i18n="nav.login"><%= fr ? 'Se connecter' : 'Log in' %></a>
  <% } else { %>
    <% if (error) { %><p id="reset-error" class="form-error" role="alert" tabindex="-1" autofocus data-i18n="<%= token ? 'reset.passwordError' : 'reset.invalid' %>"><%= fr ? error : (token ? 'Check your password: at least 10 characters, at most 72 UTF-8 bytes, and matching confirmation.' : 'This link is invalid or has expired.') %></p><% } %>
    <% if (token) { %>
      <form method="post">
        <%- csrfField() %>
        <p id="password-policy" data-i18n="reset.policy"><%= fr ? `Au moins ${passwordMinLength} caractères, maximum 72 octets UTF-8.` : `At least ${passwordMinLength} characters, at most 72 UTF-8 bytes.` %></p>
        <label for="password" data-i18n="reset.password"><%= fr ? 'Nouveau mot de passe' : 'New password' %></label>
        <input id="password" name="password" type="password" minlength="<%= passwordMinLength %>" required autocomplete="new-password" aria-describedby="password-policy<%= error ? ' reset-error' : '' %>" <%= error ? 'aria-invalid=true' : 'autofocus' %>>
        <label for="passwordConfirmation" data-i18n="reset.confirm"><%= fr ? 'Confirmer le nouveau mot de passe' : 'Confirm your new password' %></label>
        <input id="passwordConfirmation" name="passwordConfirmation" type="password" minlength="<%= passwordMinLength %>" required autocomplete="new-password" aria-describedby="password-policy<%= error ? ' reset-error' : '' %>">
        <button class="button" type="submit" data-i18n="reset.submit"><%= fr ? 'Réinitialiser' : 'Reset password' %></button>
      </form>
    <% } else { %><a href="/forgot-password" data-i18n="reset.again"><%= fr ? 'Demander une nouvelle récupération' : 'Request password recovery again' %></a><% } %>
  <% } %>
</section>
<%- include('../partials/footer') %>
