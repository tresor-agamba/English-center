<%- include('../partials/header', { title }) %><section class="auth-card card"><h1>Réinitialiser le mot de passe</h1>
<% if (completed) { %><p role="status">Votre mot de passe a été modifié.</p><a class="button" href="/login">Se connecter</a><% } else { %><% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %><% if (token) { %><form method="post" action="/reset-password/<%= token %>"><label for="password">Nouveau mot de passe</label><input id="password" name="password" type="password" minlength="8" required autocomplete="new-password"><label for="passwordConfirmation">Confirmation</label><input id="passwordConfirmation" name="passwordConfirmation" type="password" minlength="8" required autocomplete="new-password"><button class="button" type="submit">Réinitialiser</button></form><% } else { %><a href="/forgot-password">Demander un nouveau lien</a><% } %><% } %></section><%- include('../partials/footer') %>
