<%- include('../partials/header', { title }) %><section class="auth-card card"><h1>Mot de passe oublié</h1>
<% if (sent) { %><p role="status">Si un compte admissible correspond à ces informations, les instructions de réinitialisation seront envoyées.</p><p><a href="/login">Retour à la connexion</a></p><% } else { %>
<p>Saisissez votre adresse e-mail ou votre numéro de téléphone.</p><form method="post" action="/forgot-password"><%- csrfField() %><label for="identifier">E-mail ou téléphone</label><input id="identifier" name="identifier" required autocomplete="username"><button class="button" type="submit">Demander un nouveau mot de passe</button></form><% } %></section><%- include('../partials/footer') %>
