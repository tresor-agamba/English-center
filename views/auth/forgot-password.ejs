<%- include('../partials/header', { title }) %>
<section class="auth-card card">
  <h1 data-i18n="forgot.title">Mot de passe oublié</h1>
  <% if (sent) { %>
    <p role="status" data-i18n="forgot.sent">Si un compte admissible correspond à ces informations, votre demande de récupération a été enregistrée.</p>
    <p><a href="/login" data-i18n="forgot.back">Retour à la connexion</a></p>
  <% } else { %>
    <p data-i18n="forgot.instructions">Saisissez votre adresse e-mail ou votre numéro de téléphone.</p>
    <form method="post" action="/forgot-password">
      <%- csrfField() %>
      <label for="identifier" data-i18n="forgot.identifier">E-mail ou téléphone</label>
      <input id="identifier" name="identifier" required maxlength="254" autocomplete="username">
      <button class="button" type="submit" data-i18n="forgot.submit">Demander la récupération du mot de passe</button>
    </form>
  <% } %>
</section>
<%- include('../partials/footer') %>
