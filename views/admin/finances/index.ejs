<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Administration</p><h1>Finances simples</h1></div></header>
<div class="dashboard-grid">
<section class="card"><h2>Configurer un frais</h2><form method="post" action="/admin/finances/fees" class="learning-form"><%- csrfField() %><select name="type"><% FEE_TYPES.forEach(x=>{ %><option><%= x %></option><% }) %></select><select name="level"><option value="">Sans niveau</option><% LEVELS.forEach(x=>{ %><option><%= x %></option><% }) %></select><input name="amount" inputmode="decimal" required placeholder="Montant"><select name="currency"><% CURRENCIES.forEach(x=>{ %><option><%= x %></option><% }) %></select><label><input type="checkbox" name="isActive" checked> Actif</label><button class="button">Enregistrer</button></form><ul><% fees.forEach(x=>{ %><li><%= x.type %> <%= x.level || '' %> : <%= x.amount.toFixed(2) %> <%= x.currency %> · <%= x.isActive ? 'Actif' : 'Inactif' %></li><% }) %></ul></section>
<section class="card"><h2>Créer une facture</h2><form method="post" action="/admin/finances/invoices" class="learning-form"><%- csrfField() %><select name="studentId"><% students.forEach(x=>{ %><option value="<%= x.id %>"><%= x.firstName %> <%= x.lastName %></option><% }) %></select><select name="academicEnrollmentId"><% enrollments.forEach(x=>{ %><option value="<%= x.id %>"><%= x.student.firstName %> · <%= x.cohort.name %></option><% }) %></select><label><input type="checkbox" name="types" value="FORMATION"> Formation</label><label><input type="checkbox" name="types" value="SYLLABUS"> Syllabus</label><label><input type="checkbox" name="types" value="CERTIFICATE"> Certificat</label><input name="certificateRequestId" type="number" min="1" placeholder="Demande certificat"><button class="button">Créer</button></form></section>
</div>
<section><h2>Factures</h2><% if(!invoices.length){%><div class="empty-state">Aucune facture.</div><%}%><% invoices.forEach(invoice=>{ %><article class="card"><h3><%= invoice.number %> · <%= invoice.student.firstName %> <%= invoice.student.lastName %></h3><p><%= invoice.totalAmount.toFixed(2) %> <%= invoice.currency %> · payé <%= invoice.paidAmount.toFixed(2) %> · solde <%= invoice.balanceAmount.toFixed(2) %> · <%= invoice.status %></p><form method="post" action="/admin/finances/invoices/<%= invoice.id %>/payments" class="resource-form"><%- csrfField() %><input name="amount" required placeholder="Montant"><input type="hidden" name="currency" value="<%= invoice.currency %>"><select name="method"><% METHODS.forEach(x=>{ %><option><%= x %></option><% }) %></select><input name="reference" placeholder="Référence"><input name="idempotencyKey" required value="admin-<%= invoice.id %>-<%= Date.now() %>"><button class="button">Paiement</button></form><% invoice.payments.forEach(p=>{ %><a href="/admin/finances/receipts/<%= p.receipt.id %>"><%= p.receipt.number %></a> <% }) %></article><% }) %></section>
<%- include('../../partials/footer') %>
