<form action="<%= action %>" method="post" class="meeting-form">
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

  <label for="trainingSessionId">Session de formation</label>
  <select id="trainingSessionId" name="trainingSessionId" required>
    <option value="">Sélectionner une session</option>
    <% sessions.forEach((session) => { %>
      <option value="<%= session.id %>" <%= String(form.trainingSessionId || '') === String(session.id) ? 'selected' : '' %>>
        <%= session.course.title %> — <%= session.name %> (<%= session.timezone %>)
      </option>
    <% }) %>
  </select>

  <label for="title">Titre facultatif</label>
  <input id="title" name="title" value="<%= form.title || '' %>" maxlength="160" placeholder="Séance 1 — Introduction" />

  <div class="form-grid">
    <div><label for="date">Date</label><input id="date" name="date" type="date" value="<%= form.date || '' %>" required /></div>
    <div>
      <label for="status">Statut</label>
      <select id="status" name="status" required>
        <% statuses.forEach((status) => { %><option value="<%= status %>" <%= (form.status || 'SCHEDULED') === status ? 'selected' : '' %>><%= status %></option><% }) %>
      </select>
    </div>
  </div>

  <div class="form-grid">
    <div><label for="startTime">Heure de début</label><input id="startTime" name="startTime" type="time" value="<%= form.startTime || '' %>" required /></div>
    <div><label for="endTime">Heure de fin</label><input id="endTime" name="endTime" type="time" value="<%= form.endTime || '' %>" required /></div>
  </div>

  <label for="privateMeetingUrl">Lien privé Zoom ou Google Meet</label>
  <input id="privateMeetingUrl" name="privateMeetingUrl" type="url" value="<%= form.privateMeetingUrl || '' %>" placeholder="https://…" autocomplete="off" required />
  <p class="form-hint">Ce lien reste réservé à l’administration et aux étudiants autorisés par le serveur.</p>

  <div class="form-actions">
    <button class="button" type="submit"><%= submitLabel %></button>
    <a href="<%= meeting ? `/admin/class-meetings/${meeting.id}` : '/admin/class-meetings' %>">Annuler</a>
  </div>
</form>
