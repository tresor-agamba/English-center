<%- include('../../partials/header',{title}) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow"><%= assignment.title %></p><h1><%= submission.enrollment.user.firstName %> <%= submission.enrollment.user.lastName %></h1><p><%= submission.status %> · <%= submission.submittedAt?.toLocaleString('fr-FR')||'Non envoyée' %></p></div><a href="/admin/assignments/<%= assignment.id %>/submissions">Retour</a></header>
<section class="submission-answer"><h2>Réponse</h2><div class="lesson-content"><%= submission.answerText||'Aucune réponse texte.' %></div><% if(submission.answerUrl){%><a href="<%= submission.answerUrl %>" target="_blank" rel="noopener noreferrer">Ouvrir le lien fourni</a><%}%></section>
<section class="card wide-card"><h2>Correction</h2><%if(error){%><p class="form-error"><%= error %></p><%}%><form method="post" action="/admin/assignments/<%= assignment.id %>/submissions/<%= submission.id %>/grade"><label>Note sur <%= assignment.maxScore %><input name="score" required inputmode="decimal" value="<%= submission.score??'' %>"></label><label>Commentaire<textarea name="feedback" maxlength="20000" rows="8"><%= submission.feedback||'' %></textarea></label><button class="button">Enregistrer sans publier</button></form>
<div class="status-actions"><% if(submission.gradedAt&&!submission.feedbackPublishedAt){%><form method="post" action="/admin/assignments/<%= assignment.id %>/submissions/<%= submission.id %>/publish-feedback"><button class="button">Publier la correction</button></form><%}%><% if(submission.feedbackPublishedAt){%><form method="post" action="/admin/assignments/<%= assignment.id %>/submissions/<%= submission.id %>/unpublish-feedback"><button class="button button-danger">Annuler la publication</button></form><%}%></div></section>
<%- include('../../partials/footer') %>
