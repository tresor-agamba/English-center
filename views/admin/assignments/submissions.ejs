<%- include('../../partials/header',{title}) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Corrections</p><h1><%= assignment.title %></h1></div><a href="/admin/assignments/<%= assignment.id %>">Retour au devoir</a></header>
<section class="assignment-stats"><% [['Étudiants',stats.eligibleStudents],['Soumis',stats.submittedCount],['Manquants',stats.missingCount],['En retard',stats.lateCount],['Corrigés',stats.gradedCount],['Publiés',stats.returnedCount],['Taux',`${stats.submissionRate.toFixed(0)} %`],['Moyenne',`${Number(stats.averageScore).toFixed(2)} / ${assignment.maxScore}`],['Moyenne %',`${Number(stats.averagePercentage).toFixed(1)} %`]].forEach(([label,value])=>{%><article><strong><%= value %></strong><span><%= label %></span></article><%})%></section>
<nav class="filter-tabs"><% [['all','Toutes'],['missing','Non soumises'],['submitted','Soumises'],['late','En retard'],['graded','Corrigées'],['returned','Publiées']].forEach(([key,label])=>{%><a class="<%= filter===key?'active':'' %>" href="?filter=<%= key %>"><%= label %></a><%})%></nav>
<div class="table-wrapper responsive-table"><table><thead><tr><th>Étudiant</th><th>Inscription</th><th>Soumission</th><th>Envoi</th><th>Note</th><th>Correction</th><th></th></tr></thead><tbody><% rows.forEach(row=>{%><tr><td data-label="Étudiant"><strong><%= row.user.firstName %> <%= row.user.lastName %></strong><br><small><%= row.user.phoneNumber %></small></td><td data-label="Inscription"><%= row.status %></td><td data-label="Soumission"><%= row.submission?.status||'Aucune soumission' %></td><td data-label="Envoi"><%= row.submission?.submittedAt?row.submission.submittedAt.toLocaleString('fr-FR'):'—' %></td><td data-label="Note"><%= row.submission?.score??'—' %></td><td data-label="Correction"><%= row.submission?.feedbackPublishedAt?'Publiée':(row.submission?.score!==null&&row.submission?'Non publiée':'—') %></td><td data-label="Action"><% if(row.submission){%><a href="/admin/assignments/<%= assignment.id %>/submissions/<%= row.submission.id %>">Corriger</a><%}%></td></tr><%})%></tbody></table></div>
<%- include('../../partials/footer') %>
