<%- include('../../partials/header',{title}) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Évaluation</p><h1>Devoirs — <%= course.title %></h1></div><a class="button" href="/admin/courses/<%= course.id %>/assignments/new">Créer un devoir</a></header>
<% if(!course.assignments.length){%><div class="empty-state">Aucun devoir pour cette formation.</div><%}else{%><div class="table-wrapper responsive-table"><table><thead><tr><th>Devoir</th><th>Rattachement</th><th>Note</th><th>Échéance</th><th>État</th><th>Soumissions</th><th></th></tr></thead><tbody>
<% course.assignments.forEach(item=>{const graded=item.submissions.filter(s=>['GRADED','RETURNED'].includes(s.status)).length;const returned=item.submissions.filter(s=>s.feedbackPublishedAt).length;%><tr><td data-label="Devoir"><strong><%= item.title %></strong></td><td data-label="Rattachement"><%= item.lesson?.title || item.courseModule?.title || item.course.title %></td><td data-label="Note"><%= item.maxScore %></td><td data-label="Échéance"><%= item.dueAt?item.dueAt.toLocaleString('fr-FR'):'Aucune' %><br><small><%= item.allowLateSubmission?'Retard autorisé':'Retard refusé' %></small></td><td data-label="État"><span class="status <%= item.isPublished?'status-active':'status-inactive' %>"><%= item.isPublished?'Publié':'Brouillon' %></span></td><td data-label="Soumissions"><%= item.submissions.length %> · <%= graded %> corrigée(s) · <%= returned %> publiée(s)</td><td data-label="Action"><a href="/admin/assignments/<%= item.id %>">Ouvrir</a></td></tr><%})%>
</tbody></table></div><%}%><%- include('../../partials/footer') %>
