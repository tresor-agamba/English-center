<%- include('../../partials/header',{title}) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow"><%= assignment.course.title %></p><h1><%= assignment.title %></h1><span class="status <%= assignment.isPublished?'status-active':'status-inactive' %>"><%= assignment.isPublished?'Publié':'Brouillon' %></span></div><div class="heading-actions"><a class="button" href="/admin/assignments/<%= assignment.id %>/submissions">Voir les soumissions</a><a class="button" href="/admin/assignments/<%= assignment.id %>/edit">Modifier</a></div></header>
<section class="details-grid"><article class="card"><strong>Note maximale</strong><span><%= assignment.maxScore %></span></article><article class="card"><strong>Date limite</strong><span><%= assignment.dueAt?assignment.dueAt.toLocaleString('fr-FR'):'Aucune' %></span></article><article class="card"><strong>Module</strong><span><%= assignment.courseModule?.title||'Formation entière' %></span></article><article class="card"><strong>Leçon</strong><span><%= assignment.lesson?.title||'Aucune' %></span></article></section>
<div class="lesson-content"><%= assignment.instructions %></div><div class="status-actions"><form method="post" action="/admin/assignments/<%= assignment.id %>/toggle-published"><%- csrfField() %><button class="button"><%= assignment.isPublished?'Masquer':'Publier' %></button></form><form method="post" action="/admin/assignments/<%= assignment.id %>/delete"><%- csrfField() %><button class="button button-danger">Supprimer ou masquer</button></form></div>
<%- include('../../partials/footer') %>
