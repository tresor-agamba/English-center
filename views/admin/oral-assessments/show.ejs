<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<div class="section-heading"><div><p class="eyebrow"><%= assessment.status %></p><h1><%= assessment.title %></h1></div><% if (assessment.status === 'DRAFT') { %><div><a href="/admin/oral-assessments/<%= assessment.id %>/edit">Modifier</a><form method="post" action="/admin/oral-assessments/<%= assessment.id %>/publish"><%- csrfField() %><button class="button">Publier</button></form></div><% } %></div>
<section class="card"><p><%= assessment.instructions %></p><p><strong><%= assessment.questions.length %></strong> question(s) · <strong><%= assessment.totalPoints %></strong> points</p></section>
<h2>Soumissions</h2><div class="card-grid"><% submissions.forEach(row => { %><article class="card"><h3><%= row.enrollment.user.firstName %> <%= row.enrollment.user.lastName %></h3><p>Tentative <%= row.attemptNumber %> — <%= row.status %></p><p><%= row._count.responses %> réponse(s)</p></article><% }) %></div><% if (!submissions.length) { %><p class="empty-state">Aucune soumission.</p><% } %><%- include('../../partials/footer') %>
