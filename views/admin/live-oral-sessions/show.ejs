<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<h1><%= item.assessment.title %></h1><article class="card"><p><strong>Statut :</strong> <%= item.status %></p><p><%= item.scheduledStartAt.toLocaleString('fr-FR') %> – <%= item.scheduledEndAt.toLocaleString('fr-FR') %></p><p><%= item.participants.length %> participant(s), <%= item.examiners.length %> examinateur(s)</p></article>
<div class="card-grid"><form class="card form-stack" method="post" action="/admin/live-oral-sessions/<%= item.id %>/cancel"><h2>Annuler</h2><label>Motif<textarea name="reason" required></textarea></label><button class="button button-danger">Annuler</button></form>
<form class="card form-stack" method="post" action="/admin/live-oral-sessions/<%= item.id %>/reschedule"><h2>Reporter</h2><label>Nouveau début UTC<input type="datetime-local" name="scheduledStartAt" required></label><label>Nouvelle fin UTC<input type="datetime-local" name="scheduledEndAt" required></label><label>Motif<textarea name="reason" required></textarea></label><button class="button">Reporter</button></form></div><%- include('../../partials/footer') %>
