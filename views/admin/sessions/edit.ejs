<%- include('../../partials/header', { title }) %>
<section class="card wide-card">
  <p class="eyebrow">Administration</p><h1>Modifier la session</h1>
  <%- include('_form', {
    action: `/admin/sessions/${session.id}`, session, form, courses, statuses, weekDays, error,
    submitLabel: 'Enregistrer',
    formatDate: (value) => value instanceof Date ? new Date(value.getTime() - value.getTimezoneOffset() * 60000).toISOString().slice(0, 10) : String(value || '').slice(0, 10),
    formatDateTime: (value) => value instanceof Date ? new Date(value.getTime() - value.getTimezoneOffset() * 60000).toISOString().slice(0, 16) : String(value || '').slice(0, 16)
  }) %>
</section>
<%- include('../../partials/footer') %>
