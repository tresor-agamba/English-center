<%- include('../../partials/header', { title }) %>

<div class="page-heading">
  <div>
    <p class="eyebrow"><%= session.course.title %></p><h1><%= session.name %></h1>
    <span class="status status-<%= session.status.toLowerCase() %>"><%= session.status %></span>
  </div>
  <div class="heading-actions">
    <a class="button" href="/admin/sessions/<%= session.id %>/edit">Modifier</a>
    <% if (session.status !== 'CANCELLED') { %>
      <form action="/admin/sessions/<%= session.id %>/cancel" method="post" onsubmit="return confirm('Annuler cette session ?')">
        <button class="button button-danger" type="submit">Annuler la session</button>
      </form>
    <% } %>
  </div>
</div>

<div class="details-grid">
  <div class="card"><strong>Début</strong><span><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(session.startDate) %></span></div>
  <div class="card"><strong>Fin</strong><span><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(session.endDate) %></span></div>
  <div class="card"><strong>Limite d’inscription</strong><span><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(session.registrationDeadline) %></span></div>
  <div class="card"><strong>Places</strong><span><%= session.enrollments.length %> / <%= session.capacity %></span></div>
  <div class="card"><strong>Jours</strong><span><%= session.weekDays.map((day) => ({ MONDAY: 'Lundi', TUESDAY: 'Mardi', WEDNESDAY: 'Mercredi', THURSDAY: 'Jeudi', FRIDAY: 'Vendredi', SATURDAY: 'Samedi', SUNDAY: 'Dimanche' }[day])).filter(Boolean).join(', ') || 'Non définis' %></span></div>
  <div class="card"><strong>Horaires</strong><span><%= session.startTime %> – <%= session.endTime %> (<%= session.timezone %>)</span></div>
  <div class="card"><strong>Plateforme</strong><span><%= session.platform || 'Non définie' %></span></div>
</div>

<section class="section-block">
  <h2>Changer le statut</h2>
  <div class="status-actions">
    <% ['DRAFT', 'OPEN', 'FULL', 'ONGOING', 'COMPLETED', 'CANCELLED'].forEach((status) => { %>
      <% if (status !== session.status) { %>
        <form action="/admin/sessions/<%= session.id %>/toggle-status" method="post">
          <input type="hidden" name="status" value="<%= status %>" />
          <button class="button button-small" type="submit"><%= status %></button>
        </form>
      <% } %>
    <% }) %>
  </div>
</section>

<section class="section-block">
  <h2>Étudiants inscrits</h2>
  <% if (!session.enrollments.length) { %>
    <p>Aucun étudiant n’est inscrit à cette session.</p>
  <% } else { %>
    <div class="table-wrapper"><table>
      <thead><tr><th>Étudiant</th><th>Séances</th><th>Palier</th><th>Prix / payé / solde</th><th>Seuils</th></tr></thead>
      <tbody><% session.enrollments.forEach((enrollment) => { %><tr>
        <td><%= enrollment.user.firstName %> <%= enrollment.user.lastName %></td>
        <td><%= enrollment.access.attendedSessionCount %>/16</td>
        <td><%= enrollment.access.accessStage %> · <%= enrollment.access.allowed ? 'Actif' : 'Bloqué' %></td>
        <td><%= enrollment.access.expectedTotalAmount %> / <%= enrollment.access.confirmedPaidAmount %> / <%= enrollment.access.remainingAmount %> <%= enrollment.access.expectedCurrency %> (<%= enrollment.access.paidPercentage %> %)</td>
        <td>Séances gratuites : <%= enrollment.access.attendedSessionCount %>/5<br>50 % : <%= enrollment.access.firstHalfReachedAt ? enrollment.access.firstHalfReachedAt.toLocaleDateString('fr-FR') : 'Non' %><br>100 % : <%= enrollment.access.fullyPaidAt ? enrollment.access.fullyPaidAt.toLocaleDateString('fr-FR') : 'Non' %></td>
      </tr><% }) %></tbody>
    </table></div>
  <% } %>
</section>

<p><a href="/admin/sessions">← Retour aux sessions</a></p>
<%- include('../../partials/footer') %>
