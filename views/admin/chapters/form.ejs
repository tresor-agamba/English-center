<%- include('../../partials/header', { title }) %>
<%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Structure LMS</p><h1><%= title %></h1><p>Module : <%= module.title %></p></div></header>
<% if (error) { %><p class="form-error"><%= error %></p><% } %>
<form method="post" action="<%= action %>" class="learning-form">
  <label>Titre<input name="title" maxlength="180" required value="<%= form.title || '' %>"></label>
  <label>Description<textarea name="description" maxlength="2000" rows="4"><%= form.description || '' %></textarea></label>
  <div class="form-grid">
    <label>Position<input name="position" type="number" min="1" required value="<%= form.position || 1 %>"></label>
    <label>Disponible à partir de<input name="availableAt" type="datetime-local" value=""></label>
  </div>
  <label class="checkbox-label"><input name="isPublished" type="checkbox" <%= form.isPublished ? 'checked' : '' %>> Chapitre publié</label>
  <button class="button" type="submit"><%= submitLabel %></button>
</form>
<%- include('../../partials/footer') %>
