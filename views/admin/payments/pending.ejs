<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Finances</p><h1>Paiements manuels</h1><p class="heading-copy">Contrôlez les déclarations avant toute confirmation.</p></div><a class="button button-outline" href="/admin/finances/payment-methods">Configurer les moyens</a></header>
<% if (success) { %><p class="form-success" role="status">Décision enregistrée.</p><% } %>
<form method="get" action="/admin/finances/manual-payments" class="manual-payment-filters card"><label>Statut<select name="status"><% ['PENDING','SUCCESS','FAILED'].forEach(status => { %><option <%= (filters.status || 'PENDING') === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><label>Moyen<select name="methodCode"><option value="">Tous</option><% methods.forEach(method => { %><option value="<%= method.code %>" <%= filters.methodCode === method.code ? 'selected' : '' %>><%= method.label %></option><% }) %></select></label><label>Formation<select name="courseId"><option value="">Toutes</option><% courses.forEach(course => { %><option value="<%= course.id %>" <%= Number(filters.courseId) === course.id ? 'selected' : '' %>><%= course.title %></option><% }) %></select></label><label>Étudiant<input name="student" value="<%= filters.student || '' %>" placeholder="Nom ou téléphone"></label><label>Devise<select name="currency"><option value="">Toutes</option><option <%= filters.currency === 'USD' ? 'selected' : '' %>>USD</option><option <%= filters.currency === 'CDF' ? 'selected' : '' %>>CDF</option></select></label><label>Du<input type="date" name="from" value="<%= filters.from || '' %>"></label><label>Au<input type="date" name="to" value="<%= filters.to || '' %>"></label><button class="button" type="submit">Filtrer</button></form>
<% if (!payments.length) { %><div class="empty-state">Aucune déclaration pour ces filtres.</div><% } %>
<section class="pending-payment-grid"><% payments.forEach(payment => { const meta = payment.metadata || {}; %><article class="pending-payment-card card"><header><div><h2><%= payment.enrollment.user.firstName %> <%= payment.enrollment.user.lastName %></h2><p><%= payment.enrollment.trainingSession.course.title %> · <%= payment.enrollment.trainingSession.course.level || 'Niveau non précisé' %></p></div><span class="status payment-status-<%= payment.status.toLowerCase() %>"><%= payment.status %></span></header><dl><div><dt>Montant déclaré</dt><dd><strong><%= payment.amount %> <%= payment.currency %></strong></dd></div><div><dt>Moyen</dt><dd><%= meta.manualMethodLabel || meta.manualMethodCode %></dd></div><div><dt>Numéro payeur</dt><dd><%= meta.payerNumber %></dd></div><div><dt>Référence</dt><dd><%= payment.providerReference || 'Non fournie' %></dd></div><div><dt>Date du paiement</dt><dd><%= meta.declaredPaidAt ? new Date(meta.declaredPaidAt).toLocaleString('fr-FR') : 'Non précisée' %></dd></div><div><dt>Soumis le</dt><dd><%= new Date(meta.manualDeclaredAt || payment.createdAt).toLocaleString('fr-FR') %></dd></div><div><dt>Commentaire</dt><dd><%= meta.comment || '—' %></dd></div><div><dt>Preuve</dt><dd><% if (meta.proof?.key) { %><a href="/admin/finances/manual-payments/<%= payment.reference %>/proof" target="_blank" rel="noopener">Voir la preuve</a><% } else { %>Non fournie<% } %></dd></div><% if (meta.receiptNumber) { %><div><dt>Reçu</dt><dd><a href="/admin/finances/manual-payments/<%= payment.reference %>/receipt"><%= meta.receiptNumber %></a></dd></div><% } %></dl><% if (payment.status === 'PENDING') { %><div class="payment-admin-actions"><form method="post" action="/admin/finances/manual-payments/<%= payment.reference %>/confirm" onsubmit="return confirm('Confirmer ce paiement après vérification ?')"><%- csrfField() %><button class="button" type="submit">✓ Confirmer</button></form><form method="post" action="/admin/finances/manual-payments/<%= payment.reference %>/refuse"><%- csrfField() %><label>Motif du refus<input name="reason" maxlength="500" required></label><button class="button button-danger" type="submit">✗ Refuser</button></form></div><% } %></article><% }) %></section>
<%- include('../../partials/footer') %>
