<%- include('../../partials/header', { title }) %>
<%- include('../_nav') %>
<% const mask = (value) => { const text = String(value || ''); return text.length < 5 ? '••••' : `${text.slice(0, 3)}••••${text.slice(-2)}`; }; %>
<header class="page-heading"><div><p class="eyebrow">Finances</p><h1>Moyens de paiement manuels</h1><p class="heading-copy">Créez, modifiez, ordonnez et activez les coordonnées affichées aux étudiants.</p></div><a href="/admin/finances/manual-payments">Voir les déclarations</a></header>
<% if (success) { %><p class="form-success" role="status">Modification enregistrée.</p><% } %><% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
<details class="card payment-method-create"><summary>Ajouter un moyen manuel</summary><form method="post" action="/admin/finances/payment-methods" class="payment-method-admin-form">
  <label>Code unique<input name="code" placeholder="AUTRE_MOYEN" maxlength="40" required></label><label>Nom public<input name="label" maxlength="100" required></label><label>Type<select name="type"><% METHOD_TYPES.forEach(type => { %><option value="<%= type %>"><%= type.replaceAll('_',' ') %></option><% }) %></select></label><label>Devise<select name="currency"><% CURRENCIES.forEach(currency => { %><option><%= currency %></option><% }) %></select></label>
  <label>Bénéficiaire<input name="beneficiaryName" maxlength="160"></label><label>Numéro ou compte<input name="accountNumber" maxlength="100"></label><label>Titulaire du compte<input name="accountHolder" maxlength="160"></label><label>Banque<input name="bankName" maxlength="160"></label><label>SWIFT<input name="swiftCode" maxlength="40"></label><label>Agence<input name="bankBranch" maxlength="160"></label>
  <label>Instructions FR<textarea name="instructionsFr" maxlength="1500"></textarea></label><label>Instructions EN<textarea name="instructionsEn" maxlength="1500"></textarea></label><label>Ordre<input type="number" name="displayOrder" min="0" max="1000" value="10" required></label><label class="toggle-row"><input type="checkbox" name="isEnabled"> Activer immédiatement</label><button class="button" type="submit">Ajouter</button>
</form></details>
<section class="payment-method-admin-list"><% methods.forEach(method => { %><article class="card payment-setting-card">
  <header><div><h2><%= method.label %></h2><p><%= method.type.replaceAll('_',' ') %> · <%= mask(method.accountNumber) %></p></div><span class="status <%= method.isEnabled ? 'status-active' : '' %>"><%= method.isEnabled ? 'Actif' : 'Inactif' %></span></header>
  <form method="post" action="/admin/finances/payment-methods/<%= method.id %>" class="payment-method-admin-form">
    <label>Nom public<input name="label" maxlength="100" value="<%= method.label %>" required></label><label>Type<select name="type"><% METHOD_TYPES.forEach(type => { %><option value="<%= type %>" <%= method.type === type ? 'selected' : '' %>><%= type.replaceAll('_',' ') %></option><% }) %></select></label><label>Devise<select name="currency"><% CURRENCIES.forEach(currency => { %><option <%= method.currency === currency ? 'selected' : '' %>><%= currency %></option><% }) %></select></label>
    <label>Bénéficiaire<input name="beneficiaryName" maxlength="160" value="<%= method.beneficiaryName || '' %>"></label><label>Numéro ou compte<input name="accountNumber" maxlength="100" value="<%= method.accountNumber || '' %>"></label><label>Titulaire<input name="accountHolder" maxlength="160" value="<%= method.accountHolder || '' %>"></label><label>Banque<input name="bankName" maxlength="160" value="<%= method.bankName || '' %>"></label><label>SWIFT<input name="swiftCode" maxlength="40" value="<%= method.swiftCode || '' %>"></label><label>Agence<input name="bankBranch" maxlength="160" value="<%= method.bankBranch || '' %>"></label>
    <label>Instructions FR<textarea name="instructionsFr" maxlength="1500"><%= method.instructionsFr || '' %></textarea></label><label>Instructions EN<textarea name="instructionsEn" maxlength="1500"><%= method.instructionsEn || '' %></textarea></label><label>Ordre<input type="number" name="displayOrder" min="0" max="1000" value="<%= method.displayOrder %>" required></label><input type="hidden" name="isEnabled" value="<%= method.isEnabled %>"><button class="button button-secondary" type="submit">Enregistrer</button>
  </form>
  <form method="post" action="/admin/finances/payment-methods/<%= method.id %>/toggle" class="payment-method-toggle"><input type="hidden" name="enabled" value="<%= method.isEnabled ? 'false' : 'true' %>"><% if (method.isEnabled && pendingCounts[method.id]) { %><label><input type="checkbox" name="confirmation" value="DISABLE_WITH_PENDING" required> Confirmer malgré <%= pendingCounts[method.id] %> demande(s) en attente</label><% } %><button class="button <%= method.isEnabled ? 'button-danger' : '' %>" type="submit"><%= method.isEnabled ? 'Désactiver' : 'Activer' %></button></form>
</article><% }) %></section>
<%- include('../../partials/footer') %>
