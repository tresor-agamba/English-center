<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Pilotage</p><h1>Rapports simples</h1></div></header>
<form method="get" action="/admin/reports" class="resource-form"><select name="period"><% periods.forEach(x=>{ %><option <%= (query.period||'THIS_MONTH')===x?'selected':'' %>><%= x %></option><% }) %></select><input type="date" name="startDate" value="<%= query.startDate||'' %>"><input type="date" name="endDate" value="<%= query.endDate||'' %>"><select name="level"><option value="">Tous niveaux</option><% ['LEVEL_1','LEVEL_2','LEVEL_3'].forEach(x=>{ %><option <%= query.level===x?'selected':'' %>><%= x %></option><% }) %></select><select name="cohortId"><option value="">Toutes cohortes</option><% cohorts.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(query.cohortId)===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><select name="groupId"><option value="">Tous groupes</option><% groups.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(query.groupId)===x.id?'selected':'' %>><%= x.name %></option><% }) %></select><select name="teacherId"><option value="">Tous enseignants</option><% teachers.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(query.teacherId)===x.id?'selected':'' %>><%= x.firstName %> <%= x.lastName %></option><% }) %></select><button class="button">Filtrer</button></form>
<nav class="report-tabs"><a href="#summary">Résumé</a><a href="#students">Étudiants</a><a href="#academic">Académique</a><a href="#attendance">Présences</a><a href="#evaluations">Évaluations</a><a href="#lms">LMS</a><a href="#finances">Finances</a><a href="#certificates">Certificats</a><a href="#teachers">Enseignants</a></nav>
<section id="summary"><h2>Résumé</h2><div class="stats-grid"><% [['Étudiants',overview.totalStudents],['Étudiants actifs',overview.activeStudents],['Enseignants',overview.activeTeachers],['Cohortes actives',overview.activeCohorts],['Groupes actifs',overview.activeGroups],['Cours publiés',overview.publishedCourses],['Séances prévues',overview.scheduledSessions],['Factures ouvertes',overview.unpaidInvoices],['Certificats délivrés',overview.issuedCertificates]].forEach(x=>{ %><article class="stat-card"><span><%= x[0] %></span><strong><%= x[1] %></strong></article><% }) %></div><% overview.finance.forEach(x=>{ %><p><strong><%= x.currency %></strong> encaissé <%= x._sum.paidAmount?.toFixed(2)||'0.00' %> · solde <%= x._sum.balanceAmount?.toFixed(2)||'0.00' %></p><% }) %></section>
<section id="students" class="card"><h2>Étudiants</h2><p>Total <%= studentReport.total %> · nouveaux <%= studentReport.newStudents %> · actifs <%= studentReport.active %> · suspendus <%= studentReport.suspended %> · terminés <%= studentReport.completed %></p><div class="simple-chart"><% studentReport.byLevel.forEach(x=>{ %><div><span><%= x.key %></span><meter min="0" max="<%= Math.max(1,studentReport.active) %>" value="<%= x.count %>"></meter><strong><%= x.count %></strong></div><% }) %></div></section>
<section id="academic" class="card"><h2>Académique</h2><p>Cohortes <%= academicReport.cohortsActive %> · groupes <%= academicReport.groupsActive %> · inscriptions <%= academicReport.activeEnrollments %> · transferts <%= academicReport.transfers %> · séances programmées <%= academicReport.scheduled %> · terminées <%= academicReport.completed %> · annulées <%= academicReport.cancelled %></p></section>
<section id="attendance" class="card"><h2>Présences</h2><p>Taux de présence <%= attendanceReport.attendanceRate.toFixed(1) %>% · absence <%= attendanceReport.absenceRate.toFixed(1) %>%</p><small>Dénominateur : <%= attendanceReport.denominatorDefinition %>. EXCUSED et TECHNICAL_ISSUE sont exclus.</small><div class="simple-chart"><% Object.entries(attendanceReport.counts).forEach(([key,value])=>{ %><div><span><%= key %></span><meter min="0" max="<%= Math.max(1,Object.values(attendanceReport.counts).reduce((a,b)=>a+b,0)) %>" value="<%= value %>"></meter><strong><%= value %></strong></div><% }) %></div></section>
<section id="evaluations" class="card"><h2>Évaluations</h2><p>Créées <%= evaluationReport.created %> · soumises <%= evaluationReport.submitted %> · corrigées <%= evaluationReport.graded %> · attente <%= evaluationReport.pendingGrading %> · réussite <%= evaluationReport.successRate.toFixed(1) %>%</p><% evaluationReport.evaluationsByMode.forEach(x=>{ %><p><%= x.mode %> : moyenne <%= Number(x.average).toFixed(2) %></p><% }) %></section>
<section id="lms" class="card"><h2>LMS</h2><p>Cours publiés <%= lmsReport.publishedCourses %> · étudiants commencés <%= lmsReport.studentsStarted %> · leçons terminées <%= lmsReport.completedLessons %> · temps <%= lmsReport.timeSpentSeconds %> s · accès suspendus <%= lmsReport.suspendedAccess %></p></section>
<section id="finances" class="card"><h2>Finances</h2><% financeReport.totals.forEach(x=>{ %><p><strong><%= x.currency %></strong> facturé <%= x._sum.totalAmount?.toFixed(2)||0 %> · payé <%= x._sum.paidAmount?.toFixed(2)||0 %> · solde <%= x._sum.balanceAmount?.toFixed(2)||0 %></p><% }) %><div class="simple-chart"><% financeReport.byType.forEach(x=>{ %><p><%= x.type %> <%= x.currency %> : <%= x._sum.amount?.toFixed(2)||0 %></p><% }) %></div></section>
<section id="certificates" class="card"><h2>Certificats</h2><p>Demandes <%= certificateReport.requests %> · payés <%= certificateReport.paid %> · délivrés <%= certificateReport.issued %> · révoqués <%= certificateReport.revoked %> · attente <%= certificateReport.pending %></p></section>
<section id="teachers" class="card"><h2>Enseignants</h2><p>Actifs <%= teacherReport.active %> · affectations <%= teacherReport.assignments %> · séances prévues <%= teacherReport.scheduled %> · terminées <%= teacherReport.completed %> · étudiants suivis <%= teacherReport.trackedStudents %> · charge <%= Math.round(teacherReport.estimatedMinutes) %> min</p></section>
<section><h2>Exports CSV</h2><div class="heading-actions"><% exportTypes.forEach(type=>{ %><a class="button button-small" href="/admin/reports/exports/<%= type %>?<%= new URLSearchParams(query).toString() %>"><%= type %></a><% }) %></div></section>
<%- include('../../partials/footer') %>
