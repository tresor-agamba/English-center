<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<section class="page-heading"><div><h1><%= teacher.firstName %> <%= teacher.lastName %></h1><p><%= teacher.phoneNumber %> · <%= teacher.isActive ? 'Actif' : 'Inactif' %></p></div><a class="button button-secondary" href="/admin/teachers/<%= teacher.id %>/edit">Modifier</a></section>
<section class="card"><h2>Sessions affectées</h2><% teacher.teachingAssignments.forEach(a => { %><div class="list-row"><span><strong><%= a.trainingSession.name %></strong> — <%= a.trainingSession.course.title %> <%= a.isLeadTeacher ? '(principal)' : '' %></span><form method="post" action="/admin/teachers/<%= teacher.id %>/sessions/<%= a.trainingSession.id %>/remove"><%- csrfField() %><button>Retirer</button></form></div><% }) %><% if (!teacher.teachingAssignments.length) { %><p>Aucune affectation.</p><% } %>
<form method="post" action="/admin/teachers/<%= teacher.id %>/sessions"><%- csrfField() %><select name="trainingSessionId" required><option value="">Choisir une session</option><% sessions.forEach(s => { %><option value="<%= s.id %>"><%= s.course.title %> — <%= s.name %></option><% }) %></select><label><input type="checkbox" name="isLeadTeacher"> Enseignant principal</label><button class="button">Affecter</button></form></section>
<section class="card"><h2>Sécurité</h2><form method="post" action="/admin/teachers/<%= teacher.id %>/toggle-status"><%- csrfField() %><button class="button button-secondary"><%= teacher.isActive ? 'Désactiver' : 'Réactiver' %></button></form><form method="post" action="/admin/teachers/<%= teacher.id %>/reset-password"><%- csrfField() %><input type="password" name="password" minlength="8" placeholder="Nouveau mot de passe" required><input type="password" name="passwordConfirmation" placeholder="Confirmation" required><button class="button">Réinitialiser</button></form></section>
<section class="card"><h2>Notifications WhatsApp</h2><p><%= teacher.whatsappPreference?.hasOptedIn ? 'Consentement actif' : 'Aucun consentement actif' %></p><% if (teacher.whatsappPreference?.hasOptedIn) { %><form method="post" action="/admin/whatsapp/users/<%= teacher.id %>/disable"><%- csrfField() %><button class="button button-secondary">Désactiver WhatsApp</button></form><% } else { %><form method="post" action="/admin/whatsapp/users/<%= teacher.id %>/enable"><%- csrfField() %><input type="hidden" name="source" value="ADMIN_RECORDED"><label>Numéro communiqué avec consentement</label><input name="phoneNumber" value="<%= teacher.phoneNumber %>" required><button class="button">Enregistrer le consentement</button></form><% } %></section>
<%- include('../../partials/footer') %>
