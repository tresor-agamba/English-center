<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow"><%= lesson.courseModule.title %></p><h1>Ressources — <%= lesson.title %></h1></div><a href="/admin/lessons/<%= lesson.id %>/edit">Retour à la leçon</a></header>
<section class="card wide-card"><h2>Ajouter une ressource</h2><% if(error){%><p class="form-error"><%= error %></p><%}%>
<form method="post" action="/admin/lessons/<%= lesson.id %>/resources" class="resource-form"><input name="title" placeholder="Titre" required value="<%= form.title || '' %>"><select name="type"><% resourceTypes.forEach(type => { %><option <%= form.type === type ? 'selected' : '' %>><%= type %></option><% }) %></select><input name="url" type="url" placeholder="https://…" required value="<%= form.url || '' %>"><input name="position" type="number" min="1" required value="<%= form.position || 1 %>"><button class="button" type="submit">Ajouter</button></form></section>
<section class="section-block"><% if(!lesson.resources.length){%><div class="empty-state">Aucune ressource.</div><%}%>
<div class="resource-list"><% lesson.resources.forEach(resource => { %><article><form method="post" action="/admin/resources/<%= resource.id %>" class="resource-form"><input name="title" required value="<%= resource.title %>"><select name="type"><% resourceTypes.forEach(type => { %><option <%= resource.type === type ? 'selected' : '' %>><%= type %></option><% }) %></select><input name="url" type="url" required value="<%= resource.url %>"><input name="position" type="number" min="1" required value="<%= resource.position %>"><button class="button button-small">Enregistrer</button></form><div class="resource-actions"><form method="post" action="/admin/resources/<%= resource.id %>/move-up"><button>↑</button></form><form method="post" action="/admin/resources/<%= resource.id %>/move-down"><button>↓</button></form><form method="post" action="/admin/resources/<%= resource.id %>/delete"><button class="button-danger">Supprimer</button></form></div></article><% }) %></div></section>
<%- include('../../partials/footer') %>
