<%- include('../../partials/header', { title }) %>
<section class="card wide-card">
  <p class="eyebrow">Administration</p><h1>Inscription confirmée</h1>
  <p><%= temporaryPassword ? 'Copiez ces informations maintenant : le mot de passe temporaire ne sera plus affiché.' : 'Le compte existant a été réutilisé; son mot de passe n’a pas été modifié.' %></p>
  <% const group = enrollment.registrationGroup; const credentialLine = temporaryPassword ? `\nMot de passe temporaire : ${temporaryPassword}\n\nVous devrez modifier votre mot de passe lors de votre première connexion.` : '\nUtilisez votre mot de passe actuel.'; const details = `Bonjour ${enrollment.user.firstName}, votre inscription à New Vision Academy est confirmée.\n\nFormation : ${enrollment.trainingSession.course.title}\nNiveau : ${enrollment.approvedLevel || enrollment.requestedLevel || 'À déterminer'}\nSession : ${enrollment.trainingSession.name}\nJours : ${group ? group.weekDays.join(' et ') : 'Selon la session'}\nHoraire : ${group ? `${group.startTime}–${group.endTime}` : `${enrollment.trainingSession.startTime}–${enrollment.trainingSession.endTime}`}\n\nIdentifiant : ${enrollment.user.phoneNumber}${credentialLine}\nConnexion : ${loginUrl}`; %>
  <dl><dt>Étudiant</dt><dd><%= enrollment.user.firstName %> <%= enrollment.user.lastName %></dd><dt>Identifiant</dt><dd><%= enrollment.user.phoneNumber %></dd><% if (temporaryPassword) { %><dt>Mot de passe temporaire</dt><dd><code><%= temporaryPassword %></code></dd><% } %><dt>Formation</dt><dd><%= enrollment.trainingSession.course.title %></dd><dt>Session / groupe</dt><dd><%= enrollment.trainingSession.name %><%= group ? ` — ${group.name}, ${group.startTime}–${group.endTime}` : '' %></dd></dl>
  <textarea id="credentials" rows="12" readonly><%= details %></textarea>
  <div class="form-actions"><button class="button" type="button" onclick="navigator.clipboard.writeText(document.getElementById('credentials').value)">Copier les informations</button><a class="button button-secondary" target="_blank" rel="noopener" href="https://wa.me/<%= (enrollment.user.whatsappNumber || enrollment.user.phoneNumber).replace(/\D/g, '') %>?text=<%= encodeURIComponent(details) %>">Envoyer via WhatsApp</a><a href="/admin/students/<%= enrollment.user.id %>">Voir l’étudiant</a></div>
</section>
<%- include('../../partials/footer') %>
