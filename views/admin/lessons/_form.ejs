<% if (error) { %><p class="form-error"><%= error %></p><% } %>
<form method="post" action="<%= action %>" class="learning-form"><%- csrfField() %>
  <label>Titre<input name="title" maxlength="180" required value="<%= form.title || '' %>"></label>
  <label>Description<textarea name="description" maxlength="2000" rows="4"><%= form.description || '' %></textarea></label>
  <label>Contenu texte<textarea name="content" maxlength="50000" rows="12"><%= form.content || '' %></textarea></label>
  <div class="form-grid">
    <label>Type<select name="type"><% ['TEXT','VIDEO','PDF','AUDIO','LINK','DOWNLOAD','EMBED','LIVE_SESSION'].forEach(type => { %><option value="<%= type %>" <%= form.type === type ? 'selected' : '' %>><%= type %></option><% }) %></select></label>
    <label>Lien externe<input name="externalUrl" type="url" value="<%= form.externalUrl || '' %>"></label>
  </div>
  <% const lessonModule = typeof module !== 'undefined' ? module : (typeof lesson !== 'undefined' ? lesson.courseModule : null); %>
  <label>Chapitre<select name="courseChapterId"><option value="">Sans chapitre</option><% ((lessonModule && lessonModule.chapters) || []).forEach(chapter => { %><option value="<%= chapter.id %>" <%= Number(form.courseChapterId) === chapter.id ? 'selected' : '' %>><%= chapter.title %></option><% }) %></select></label>
  <label>Règle de complétion<select name="completionRule"><option value="IMMEDIATE">Après le contenu</option><option value="AFTER_ASSESSMENT_SUBMISSION" <%= form.completionRule === 'AFTER_ASSESSMENT_SUBMISSION' ? 'selected' : '' %>>Après soumission</option><option value="AFTER_ASSESSMENT_PASS" <%= form.completionRule === 'AFTER_ASSESSMENT_PASS' ? 'selected' : '' %>>Après réussite</option></select></label>
  <label>Évaluation liée (identifiant)<input name="assessmentId" type="number" min="1" value="<%= form.assessmentId || '' %>"></label>
  <div class="form-grid"><label>Durée estimée (minutes)<input name="estimatedMinutes" type="number" min="1" value="<%= form.estimatedMinutes || '' %>"></label><label>Position<input name="position" type="number" min="1" required value="<%= form.position || 1 %>"></label></div>
  <label class="checkbox-label"><input name="isPublished" type="checkbox" <%= form.isPublished ? 'checked' : '' %>> Leçon publiée</label>
  <button class="button" type="submit"><%= submitLabel %></button>
</form>
