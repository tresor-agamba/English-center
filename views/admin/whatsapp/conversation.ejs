<%- include('../../partials/header', { title }) %>
<%- include('_chatbot-nav', { section: 'conversations' }) %>
<% const isEnrolled = Boolean(conversation.user?.enrollments?.length); const stateLabels = { BOT_ACTIVE: 'Bot actif', HUMAN_TAKEOVER: 'Prise en charge conseiller', BOT_PAUSED: 'Bot suspendu', OPTED_OUT: 'Contact ayant demandé l’arrêt', CLOSED: 'Conversation clôturée' }; const actionMessages = { handoff: 'La conversation est attribuée à votre compte. Les réponses ordinaires du bot et relances en attente sont suspendues.', paused: 'Le bot et les relances en attente sont suspendus.', resumed: 'Le bot a repris. Les anciens messages ne sont pas retraités.', queued: 'Votre réponse est enregistrée dans la file. Son statut sera mis à jour après traitement.' }; const ownsConversation = !conversation.assignedAdvisorId || conversation.assignedAdvisorId === currentAdminId; const canReply = whatsappEnabled && conversation.controlState === 'HUMAN_TAKEOVER' && conversation.assignedAdvisorId === currentAdminId && conversation.serviceWindow.open; const formatTime = value => value.toLocaleString('fr-FR', { timeZone: 'Africa/Kinshasa' }); %>
<section class="page-heading"><div><a href="/admin/whatsapp/conversations">← Toutes les conversations</a><h1><%= conversation.user ? `${conversation.user.firstName} ${conversation.user.lastName}` : 'Prospect' %></h1><p class="heading-copy"><%= maskPhoneNumber(conversation.phoneNumber) %> · <%= isEnrolled ? 'Utilisateur inscrit' : (conversation.user ? 'Prospect lié à un compte' : 'Prospect non lié à un compte') %></p></div><span class="wa-state wa-state-<%= conversation.controlState.toLowerCase().replace(/_/g, '-') %>"><%= stateLabels[conversation.controlState] || conversation.controlState %></span></section>
<% if (actionMessages[queryAction]) { %><p class="wa-notice" role="status"><%= actionMessages[queryAction] %></p><% } %>
<section class="card wa-contact-details"><h2>Contact et disponibilité</h2><p>WhatsApp : <strong><%= conversation.phoneNumber %></strong></p><p>Dernière activité : <%= conversation.lastMessageAt ? formatTime(conversation.lastMessageAt) : 'Aucun message' %> (Kinshasa)</p><p><strong><%= conversation.serviceWindow.open ? 'Fenêtre de service ouverte' : 'Fenêtre de service fermée' %></strong><% if (conversation.serviceWindow.expiresAt) { %> · échéance : <%= formatTime(conversation.serviceWindow.expiresAt) %> (Kinshasa)<% } %></p><p class="help-text">La fenêtre repose sur l’horodatage fournisseur du dernier message entrant. Elle sera vérifiée à nouveau lors de l’envoi.</p></section>
<section class="card"><h2>Suivi commercial</h2><p>Langue : <%= conversation.engineState?.preferredLanguage === 'en' ? 'English' : 'Français' %></p><p>Formation d’intérêt : <%= conversation.engineState?.selectedCourseSlug || 'Non précisée' %></p><p>Inscription : <%= isEnrolled ? 'Inscrit' : (conversation.admissionRequests?.some(r => ['PENDING','PROCESSING'].includes(r.status)) ? 'Validation administrative en cours' : 'Prospect') %></p></section>
<section class="card wa-admin-controls" aria-label="Contrôles de la conversation">
  <div><strong>Contrôle de l’automatisation</strong><p class="help-text">Toute action est enregistrée sur cette conversation et réservée aux administrateurs.</p><% if (conversation.assignedAdvisor) { %><p>Conseiller : <%= conversation.assignedAdvisor.firstName %> <%= conversation.assignedAdvisor.lastName %></p><% } %></div>
  <% if (!['OPTED_OUT', 'CLOSED'].includes(conversation.controlState) && ownsConversation) { %>
    <% if (conversation.controlState !== 'HUMAN_TAKEOVER' || !conversation.assignedAdvisorId) { %><form method="post" action="/admin/whatsapp/conversations/<%= conversation.id %>/takeover"><%- csrfField() %><button class="button" type="submit">Prendre la main</button></form><% } %>
    <% if (conversation.controlState === 'BOT_ACTIVE') { %><form method="post" action="/admin/whatsapp/conversations/<%= conversation.id %>/pause"><%- csrfField() %><button class="button button-secondary" type="submit">Suspendre le bot</button></form><% } %>
    <% if (['BOT_PAUSED', 'HUMAN_TAKEOVER'].includes(conversation.controlState)) { %><form method="post" action="/admin/whatsapp/conversations/<%= conversation.id %>/resume"><%- csrfField() %><button class="button button-secondary" type="submit">Reprendre le bot</button></form><% } %>
  <% } else { %><p class="wa-blocked"><%= !ownsConversation ? 'Cette conversation est attribuée à un autre administrateur.' : 'Aucune reprise ni réponse libre autorisée pour une conversation arrêtée ou clôturée.' %></p><% } %>
</section>
<div class="wa-detail-grid">
  <section class="card"><h2>Messages</h2><ol class="wa-message-list">
    <% conversation.messages.forEach((message) => { const incoming = message.direction === 'INBOUND'; %>
    <li class="wa-message wa-message-<%= incoming ? 'inbound' : 'outbound' %>"><div class="wa-message-heading"><strong><%= incoming ? 'Contact' : (message.sender ? `${message.sender.firstName} ${message.sender.lastName} · ${message.messageType === 'SYSTEM' ? 'Action administrative' : 'Réponse manuelle'}` : (message.messageType === 'SYSTEM' ? 'Accusé de transfert' : 'Chatbot NVA')) %></strong><time datetime="<%= message.createdAt.toISOString() %>"><%= formatTime(message.createdAt) %></time></div><p><%= message.body || `[${message.messageType}]` %></p><small>Message #<%= message.id %> · <%= message.deliveryStatus || message.processingStatus || message.messageType %><% if (message.attempts) { %> · <%= message.attempts %> tentative(s)<% } %><% if (message.failureCode) { %> · <%= message.failureCode %><% } %></small></li>
    <% }) %>
  </ol><% if (!conversation.messages.length) { %><p class="empty-state">Aucun message enregistré.</p><% } %><% if (conversation.olderMessagesCursor) { %><a href="/admin/whatsapp/conversations/<%= conversation.id %>?before=<%= conversation.olderMessagesCursor %>">Messages plus anciens</a><% } %><a href="/admin/whatsapp/conversations/<%= conversation.id %>">Messages récents</a>
  <section class="wa-manual-reply"><h2>Répondre au contact</h2><% if (manualError) { %><p class="wa-blocked" role="alert"><%= manualError %></p><% } %>
  <% if (canReply) { %><form method="post" action="/admin/whatsapp/conversations/<%= conversation.id %>/reply"><%- csrfField() %><input type="hidden" name="submissionId" value="<%= submissionId %>"><label for="manual-message">Votre réponse (maximum <%= maxManualLength %> caractères)</label><textarea id="manual-message" name="message" rows="5" maxlength="<%= maxManualLength %>" required><%= messageBody %></textarea><button class="button" type="submit">Enregistrer pour envoi</button><p class="help-text">Cette réponse sera envoyée par la file WhatsApp. Ne resoumettez pas un résultat incertain.</p></form>
  <% } else { %><p class="help-text"><%= !whatsappEnabled ? 'Le canal WhatsApp est désactivé.' : ['OPTED_OUT', 'CLOSED'].includes(conversation.controlState) ? 'Le contact a arrêté la conversation ou celle-ci est clôturée. Aucune réponse libre n’est autorisée.' : !conversation.serviceWindow.open ? 'La fenêtre de 24 heures est fermée. Attendez un nouveau message du contact ; aucun modèle commercial ne sera envoyé automatiquement.' : 'Prenez la conversation en charge avec votre compte pour répondre.' %></p><% } %></section></section>
  <aside class="wa-side-panels">
    <section class="card"><h2>Relances commerciales</h2><p class="help-text">Statut, échéance et tentatives enregistrés pour chaque relance.</p><% if (conversation.prospectFollowUps.length) { %><ul class="wa-follow-up-list"><% conversation.prospectFollowUps.forEach((item) => { %><li><strong><%= item.sequenceHours %> h · <%= item.status %></strong><time datetime="<%= item.scheduledFor.toISOString() %>"><%= item.scheduledFor.toLocaleString('fr-FR') %></time><small><%= item.attempts %> tentative(s)<% if (item.failureCode) { %> · <%= item.failureCode %><% } %></small></li><% }) %></ul><% } else { %><p>Aucune relance programmée.</p><% } %></section>
    <section class="card"><h2>Consentement commercial</h2><% if (conversation.consentEvents.length) { %><ul class="wa-follow-up-list"><% conversation.consentEvents.forEach((event) => { %><li><strong><%= event.decision === 'REVOKED' ? 'Révoqué' : 'Accordé' %></strong><time datetime="<%= event.occurredAt.toISOString() %>"><%= event.occurredAt.toLocaleString('fr-FR') %></time><small><%= event.scope %> · <%= event.source %><% if (event.noticeVersion) { %> · Version <%= event.noticeVersion %><% } %></small></li><% }) %></ul><% } else { %><p>Aucune preuve de consentement commercial enregistrée.</p><% } %></section>
  </aside>
</div>
<%- include('../../partials/footer') %>
