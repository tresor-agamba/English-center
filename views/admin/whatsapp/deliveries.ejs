<%- include('../../partials/header', { title }) %><%- include('../_nav') %><section class="page-heading"><h1>Livraisons WhatsApp</h1></section><form method="get" class="filters"><select name="status"><option value="">Tous les statuts</option><% statuses.forEach(s => { %><option <%= status === s ? 'selected' : '' %>><%= s %></option><% }) %></select><button class="button button-small">Filtrer</button></form><div class="table-wrap"><table><thead><tr><th>Utilisateur</th><th>Numéro</th><th>Type</th><th>Modèle</th><th>Statut</th><th>Tentatives</th><th>Action</th></tr></thead><tbody><% deliveries.forEach(d => { %><tr><td><%= d.user.firstName %> <%= d.user.lastName %></td><td><%= maskPhoneNumber(d.phoneNumber) %></td><td><%= d.notification?.type || '—' %></td><td><%= d.templateName %></td><td><%= d.status %></td><td><%= d.attempts %></td><td><% if (d.status === 'FAILED') { %><form method="post" action="/admin/whatsapp/deliveries/<%= d.id %>/retry"><button>Réessayer</button></form><% } %></td></tr><% }) %></tbody></table></div><% if (!deliveries.length) { %><p class="empty-state">Aucune livraison WhatsApp.</p><% } %><%- include('../../partials/footer') %>
