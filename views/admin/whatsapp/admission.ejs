<%- include('../../partials/header',{title}) %><div class="wa-chatbot wa-admissions"><h1>Demande WhatsApp #<%= row.id %></h1><%- include('_chatbot-nav',{section:'admissions'}) %><% if(error){ %><p role="alert"><%= error %></p><% } %>
<p><a href="/admin/whatsapp/conversations/<%= row.conversationId %>">Conversation d’origine</a> · Source WhatsApp · <%= {PENDING:'En attente',PROCESSING:'En cours de traitement',ENROLLED:'Inscrit',CANCELLED:'Annulé'}[row.status] %></p><p>Transmission confirmée le <%= row.consentAt.toLocaleString('fr-FR',{timeZone:'Africa/Kinshasa'}) %> (<%= row.consentVersion %>)</p>
<% const preference=row.events.find(e=>['CONSENT_CONFIRMED','RECONFIRMED'].includes(e.action)); if(preference?.metadata?.courseId){ %><p>Choix du prospect : formation <%= row.preference?.courseTitle || "#"+preference.metadata.courseId %><% if(preference.metadata.requestedSessionId){ %> · session <%= row.preference?.sessionName || "#"+preference.metadata.requestedSessionId %><% }else{ %> · session à déterminer<% } %>. Disponibilité et identité à vérifier avant validation.</p><% } %>
<% if(!['ENROLLED','CANCELLED'].includes(row.status)){ %><section class="card"><h2>Coordonnées et suivi</h2><form method="post" action="/admin/whatsapp/admissions/<%= row.id %>/update" class="form-grid"><%- csrfField() %><input type="hidden" name="action" value="edit"><label>Nom complet<input name="fullName" value="<%= row.fullName %>" maxlength="120" required></label><label>WhatsApp<input name="phoneNumber" value="<%= row.phoneNumber %>" required></label><label>E-mail<input name="email" value="<%= row.email %>" type="email" required></label><label>Niveau souhaité<select name="requestedLevel"><% Object.entries(levels).forEach(([v,t])=>{ %><option value="<%= v %>"<% if(v===row.requestedLevel){ %> selected<% } %>><%= t %></option><% }); %></select></label><button class="button" type="submit">Corriger les coordonnées</button></form>
<% ['claim','cancel','request-info'].forEach(action=>{ %><form method="post" action="/admin/whatsapp/admissions/<%= row.id %>/update"><%- csrfField() %><input type="hidden" name="action" value="<%= action %>"><% if(action!=='claim'){ %><label>Motif / informations attendues<input name="reason" required maxlength="1000"></label><% } %><button class="button button-secondary" type="submit"><%= {claim:'Prendre en charge',cancel:'Refuser la demande','request-info':'Demander un complément'}[action] %></button></form><% }); %>
<h3>Vérification de l’adresse e-mail</h3><p>Un code à usage unique sera envoyé à l’adresse indiquée. Le prospect doit le saisir sur la page de vérification. L’approbation reste bloquée avant cette vérification ; toute correction des coordonnées impose une nouvelle vérification.</p>
<p><a href="/whatsapp/admission-email">Page de vérification du prospect</a></p><form method="post" action="/admin/whatsapp/admissions/<%= row.id %>/verify-email"><%- csrfField() %><button class="button button-secondary" type="submit">Envoyer le code par e-mail</button></form></section>
<p><a class="button" href="#enroll">Inscrire cet étudiant</a></p><section class="card" id="enroll"><h2>Inscrire cet étudiant</h2><p>Corrigez les coordonnées, choisissez la session et vérifiez le compte existant avant de confirmer. Un e-mail appartenant à un autre numéro bloque la création ; aucune fusion automatique n’est effectuée.</p><% matches.forEach(u=>{ %><p>Compte repéré : <%= u.firstName %> <%= u.lastName %> · <%= u.phoneNumber %> · <%= u.email||'' %> · <%= u.role %> · <%= u.isActive?'Actif':'Inactif' %><% if(u.role==='STUDENT'){ %> · <a href="/admin/students/<%= u.id %>">Consulter</a><% } %></p><% }); %>
<form method="post" action="/admin/whatsapp/admissions/<%= row.id %>/convert" class="form-grid"><%- csrfField() %><label>Nom complet<input name="fullName" value="<%= row.fullName %>" required maxlength="120"></label><label>Téléphone du compte étudiant<input name="phoneNumber" value="<%= row.phoneNumber %>" required></label><label>E-mail<input type="email" name="email" value="<%= row.email %>" required></label><input type="hidden" name="requestedLevel" value="<%= row.requestedLevel %>">
<label>Session ouverte<select name="sessionId" required><option value="">Sélectionner</option><% courses.forEach(c=>{ if(c.session){ %><option value="<%= c.session.id %>"><%= c.title %> — <%= c.session.name %><%= c.session.levelNumber?' — niveau '+c.session.levelNumber:'' %></option><% }}); %></select></label><label>Créneau, si requis<select name="groupId"><option value="">Aucun / sélectionner</option><% courses.forEach(c=>(c.session?.registrationGroups||[]).filter(g=>g.isActive&&!g.isFull).forEach(g=>{ %><option value="<%= g.id %>"><%= c.title %> · <%= g.name %> · <%= g.startTime %>–<%= g.endTime %></option><% })); %></select></label><label>Niveau administratif confirmé<select name="academicLevel" required><option value="">À vérifier</option><% ['LEVEL_1','LEVEL_2','LEVEL_3'].forEach((l,i)=>{ %><option value="<%= l %>"><%= i+1 %></option><% }); %></select></label><label><input type="checkbox" name="confirm" required> Je confirme cette inscription et les coordonnées du compte.</label><button class="button" type="submit"<% if(!courses.length){ %> disabled<% } %>>Inscrire cet étudiant</button></form></section>
<% }else{ %><p><%= row.fullName %> · <%= row.phoneNumber %> · <%= row.email %> · <%= levels[row.requestedLevel] %></p><% } %>
<% if(row.enrollment){ %><p><a href="/admin/students/<%= row.enrollment.userId %>">Consulter l’étudiant inscrit</a></p><% } %><% if(row.confirmationDraft){ %><section class="card"><h2>Confirmation préparée — aucun envoi</h2><p class="wa-preserve"><%= row.confirmationDraft %></p><p>Utilisez la conversation et ses contrôles d’envoi lorsque le canal sera autorisé. Hors fenêtre de service, un modèle Meta approuvé est requis.</p></section><% } %>
<section class="card"><h2>Historique</h2><% row.events.forEach(e=>{ %><p><%= e.createdAt.toLocaleString('fr-FR',{timeZone:'Africa/Kinshasa'}) %> · <%= {CONSENT_CONFIRMED:'Demande confirmée',RECONFIRMED:'Coordonnées reconfirmées',IDENTITY_EDITED:'Coordonnées corrigées',ASSIGNED:'Prise en charge',CANCELLED:'Demande annulée',EMAIL_VERIFIED:'E-mail vérifié',EMAIL_CHALLENGE:'Vérification e-mail demandée',EMAIL_DELIVERY_FAILED:'Envoi e-mail en échec',INFORMATION_REQUESTED:'Complément demandé',ENROLLED:'Inscription validée'}[e.action]||e.action %> · <%= e.admin?e.admin.firstName+' '+e.admin.lastName:'Prospect' %><% if(e.metadata?.reason){ %> · <%= e.metadata.reason %><% } %></p><% }); %></section></div><%- include('../../partials/footer') %>
