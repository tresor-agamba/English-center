<%- include('../../partials/header',{title}) %><div class="wa-chatbot wa-admissions"><section class="page-heading"><div><h1>Demandes d’inscription WhatsApp</h1><p>Demandes consenties à examiner avant toute inscription officielle.</p></div></section><%- include('_chatbot-nav',{section:'admissions'}) %>
<% const names={PENDING:'En attente',PROCESSING:'En cours de traitement',ENROLLED:'Inscrit',CANCELLED:'Annulé'}; %>
<form method="get" class="form-grid"><label>Recherche<input name="q" value="<%= q %>" maxlength="100"></label><label>Statut<select name="status"><option value="">Tous</option><% statuses.forEach(s=>{ %><option value="<%= s %>"<% if(status===s){ %> selected<% } %>><%= names[s] %></option><% }); %></select></label><label>Tri<select name="sort"><option value="newest">Plus récentes</option><option value="oldest"<% if(sort==='asc'){ %> selected<% } %>>Plus anciennes</option></select></label><button class="button" type="submit">Filtrer</button></form>
<div class="wa-conversation-list"><% rows.forEach(row=>{ %><a class="wa-conversation-card" href="/admin/whatsapp/admissions/<%= row.id %>"><span><strong><%= row.fullName %></strong><br><%= row.phoneNumber %><br><%= row.email %><br><%= levels[row.requestedLevel] %><br>Formation : <%= row.preference?.courseTitle || (row.preference?.courseId ? "#"+row.preference.courseId : "Non choisie") %><br>Session : <%= row.preference?.sessionName || (row.preference?.requestedSessionId ? "#"+row.preference.requestedSessionId : "Non choisie") %></span><span><%= names[row.status] %><br><%= row.createdAt.toLocaleString('fr-FR',{timeZone:'Africa/Kinshasa'}) %><br>Source : WhatsApp<% if(row.assignedAdmin){ %><br><%= row.assignedAdmin.firstName %> <%= row.assignedAdmin.lastName %><% } %></span></a><% }); %><% if(!rows.length){ %><p>Aucune demande.</p><% } %></div>
<nav aria-label="Pagination"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(q) %>&status=<%= status %>&sort=<%= sort==='asc'?'oldest':'newest' %>&page=<%= page-1 %>">Précédentes</a><% } %> · Page <%= page %> <% if(rows.length===50){ %>· <a href="?q=<%= encodeURIComponent(q) %>&status=<%= status %>&sort=<%= sort==='asc'?'oldest':'newest' %>&page=<%= page+1 %>">Suivantes</a><% } %></nav></div><%- include('../../partials/footer') %>
