<%- include('../../../partials/header', { title }) %><%- include('../../_nav') %><section class="page-heading"><h1>Annonces internes</h1><a class="button" href="/admin/notifications/announcements/new">Nouvelle annonce</a></section><% announcements.forEach(a => { %><article class="card"><p class="eyebrow"><%= a.audienceType %> · <%= a.recipientCount %> destinataire(s)</p><h2><%= a.title %></h2><p><%= a.message %></p><small>Par <%= a.createdBy.firstName %> <%= a.createdBy.lastName %>, le <%= a.createdAt.toLocaleString('fr-FR') %></small></article><% }) %><% if (!announcements.length) { %><p class="empty-state">Aucune annonce publiée.</p><% } %><%- include('../../../partials/footer') %>
