<%- include('../../partials/header', { title }) %>
<section class="card wide-card">
  <div class="page-heading compact-heading">
    <div><p class="eyebrow">Administration</p><h1>Modifier la formation</h1><p class="heading-copy">/<%= course.slug %></p></div>
    <form action="/admin/courses/<%= course.id %>/toggle-published" method="post" onsubmit="return confirm('<%= course.isPublished ? 'Retirer cette formation du catalogue public ?' : 'Publier cette formation dans le catalogue public ?' %>')">
      <button class="button button-small <%= course.isPublished ? 'button-danger' : '' %>" type="submit"><%= course.isPublished ? 'Dépublier' : 'Publier' %></button>
    </form>
  </div>
  <p><strong>État :</strong> <%= ({READY:'Prête à publier', PUBLISHED:'Publiée', ARCHIVED:'Archivée', INCOMPLETE:'Configuration incomplète'})[course.publicationState] || 'Brouillon' %></p>
  <% if (course.publicationMissingFields.length) { %><p class="form-error">Informations manquantes avant publication : <%= course.publicationMissingFields.join(', ') %>.</p><% } %>
  <% if (course.publicationState !== 'ARCHIVED') { %><form action="/admin/courses/<%= course.id %>/archive" method="post" onsubmit="return confirm('Archiver cette formation et la retirer du catalogue public ?')"><button class="button button-small button-danger" type="submit">Archiver</button></form><% } %>
  <% if (success) { %><p class="success-message">La formation a été enregistrée.</p><% } %>
  <nav class="course-management-actions" aria-label="Gestion de la formation">
    <a class="button" href="/admin/sessions">Gérer les sessions</a>
    <a class="button" href="/admin/class-meetings?course=<%= course.id %>">Gérer les séances live</a>
    <a class="button" href="/admin/courses/<%= course.id %>/modules">Gérer le contenu pédagogique</a>
    <a class="button" href="/admin/courses/<%= course.id %>/assignments">Gérer les devoirs</a>
  </nav>
  <%- include('_form', { action: `/admin/courses/${course.id}`, form, error, courseTypes, durationUnits, currencies, submitLabel: 'Enregistrer' }) %>
</section>
<%- include('../../partials/footer') %>
