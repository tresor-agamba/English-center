<%- include('../_header') %>
<header class="page-heading"><div><p class="eyebrow">Travaux</p><h1>Mes devoirs</h1></div></header>
<section class="assignment-stats"><% [['À faire',stats.todo],['Soumis',stats.submitted],['En retard',stats.late],['Corrigés',stats.graded],['Progression',`${stats.completionPercentage} %`]].forEach(([label,value])=>{%><article><strong><%= value %></strong><span><%= label %></span></article><%})%></section>
<% if(!assignments.length){%><div class="empty-state">Aucun devoir publié.</div><%}else{%><div class="assignment-grid"><% assignments.forEach(item=>{const status=item.submission?.status||(item.fullAccess?'À faire':'Accès bloqué');%><article class="assignment-card"><div><span class="status assignment-status-<%= String(status).toLowerCase().replaceAll(' ','-') %>"><%= status %></span><h2><%= item.title %></h2><p><%= item.course.title %> · <%= item.lesson?.title||item.courseModule?.title||'Formation' %></p></div><dl><div><dt>Note maximale</dt><dd><%= item.maxScore %></dd></div><div><dt>Date limite</dt><dd><%= item.dueAt?item.dueAt.toLocaleString('fr-FR'):'Aucune' %></dd></div><% if(item.submission?.feedbackPublishedAt){%><div><dt>Note obtenue</dt><dd><strong><%= item.submission.score %> / <%= item.maxScore %></strong></dd></div><%}%></dl><% if(item.fullAccess){%><a class="button" href="/student/courses/<%= item.enrollmentId %>/assignments/<%= item.id %>">Consulter</a><%}else{%><span class="locked-label">Paiement requis</span><%}%></article><%})%></div><%}%>
<%- include('../../partials/footer') %>
