<%- include('../../partials/header',{title}) %><%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow"><%= course.title %></p><h1><%= assignment.title %></h1><p><%= assignment.lesson?.title||assignment.courseModule?.title||'Devoir de formation' %></p></div><span class="status"><%= submission?.status||'À faire' %></span></header>
<section class="assignment-meta"><span><strong><%= assignment.maxScore %></strong> points</span><span><strong><%= assignment.dueAt?assignment.dueAt.toLocaleString('fr-FR'):'Aucune' %></strong> date limite</span><span><strong><%= assignment.allowLateSubmission?'Oui':'Non' %></strong> retard autorisé</span></section>
<section><h2>Consignes</h2><div class="lesson-content"><%= assignment.instructions %></div></section>
<% if(submission?.feedbackPublishedAt){%><section class="published-feedback"><h2>Correction publiée</h2><strong class="published-score"><%= submission.score %> / <%= assignment.maxScore %></strong><div class="lesson-content"><%= submission.feedback||'Aucun commentaire.' %></div></section><%}%>
<% if(error){%><p class="form-error"><%= error %></p><%}%><% if(canSubmit){%><section class="card wide-card"><h2><%= submission?'Modifier ma soumission':'Envoyer mon travail' %></h2><form method="post" action="/student/courses/<%= enrollment.id %>/assignments/<%= assignment.id %>/submit"><label>Réponse texte<textarea name="answerText" maxlength="30000" rows="12"><%= submission?.answerText||'' %></textarea></label><label>Lien HTTP/HTTPS<input name="answerUrl" type="url" maxlength="2000" value="<%= submission?.answerUrl||'' %>"></label><button class="button">Envoyer la soumission</button></form></section><%}else{%><div class="trial-notice trial-notice-blocked"><strong>Soumission verrouillée</strong><span>La date limite est dépassée ou la correction a été publiée.</span></div><%}%>
<%- include('../../partials/footer') %>
