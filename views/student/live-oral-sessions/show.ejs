<%- include('../../partials/header', { title }) %><h1><%= item.assessment.title %></h1><article class="card"><p><%= item.scheduledStartAt.toLocaleString('fr-FR') %> – <%= item.scheduledEndAt.toLocaleString('fr-FR') %></p><p><%= item.assessment.instructions || '' %></p><% if (item.access.isOpen && ['SCHEDULED','READY','IN_PROGRESS'].includes(item.status)) { %><a class="button" href="/student/live-oral-sessions/<%= item.id %>/join">Rejoindre la visioconférence</a><% } else { %><p class="empty-state">Le lien sera accessible pendant la fenêtre autorisée.</p><% } %></article>
<% item.evaluations.forEach(e => { %><article class="card"><h2>Résultat publié</h2><p>Note : <%= e.overallScore %> / <%= item.assessment.totalPoints %></p><p>Décision : <%= e.decision %></p><p><%= e.feedback || '' %></p></article><% }) %><%- include('../../partials/footer') %>
