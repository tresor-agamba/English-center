<%- include('../../partials/header', { title }) %><h1>Mes oraux en direct</h1><div class="card-grid"><% items.forEach(item => { %><article class="card"><p class="eyebrow"><%= item.status %></p><h2><a href="/student/live-oral-sessions/<%= item.id %>"><%= item.assessment.title %></a></h2><p><%= item.scheduledStartAt.toLocaleString('fr-FR') %></p></article><% }) %></div><% if (!items.length) { %><p class="empty-state">Aucun oral planifié.</p><% } %><%- include('../../partials/footer') %>
