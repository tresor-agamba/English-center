<%- include('../_header') %>
<article class="lesson-page"><p class="eyebrow"><%= course.title %></p><h1><%= lesson.title %></h1><p class="heading-copy"><%= lesson.description || '' %></p>
<div class="lesson-content"><%- lesson.content || 'Aucun contenu texte.' %></div>
<% if (lesson.externalUrl) { %><p><a class="button" href="<%= lesson.externalUrl %>" target="_blank" rel="noopener noreferrer">Ouvrir le contenu externe</a></p><% } %>
<section class="lesson-resources"><h2>Ressources</h2><% if(!lesson.resources.length){%><p>Aucune ressource.</p><%}%><ul><% lesson.resources.forEach(resource => { const href=resource.isPrivate ? `/student/courses/${enrollment.id}/resources/${resource.publicId}` : resource.url; %><li><a href="<%= href %>" <%= resource.isPrivate ? '' : 'target="_blank" rel="noopener noreferrer"' %>><%= resource.title %></a> <span><%= resource.type %></span></li><% }) %></ul></section>
<% if (lesson.assessment) { const base=lesson.assessment.mode === 'WRITTEN' ? 'written-assessments' : lesson.assessment.mode === 'LIVE_VIDEO_ORAL' ? 'live-oral-sessions' : 'oral-assessments'; %><p><a class="button" href="/student/<%= base %>/<%= lesson.assessment.id %>">Lancer l’évaluation</a></p><% } %>
<% if (!lesson.lessonProgress[0]?.completedAt) { %><form method="post" action="/student/courses/<%= enrollment.id %>/lessons/<%= lesson.id %>/complete"><%- csrfField() %><button class="button" type="submit">Marquer comme terminée</button></form><% } else { %><p class="status status-active">Leçon terminée</p><% } %>
<nav class="lesson-navigation"><% if(previousLesson){%><a href="/student/courses/<%= enrollment.id %>/lessons/<%= previousLesson.id %>">← <%= previousLesson.title %></a><%}else{%><span></span><%}%><a href="/student/courses/<%= enrollment.id %>/learn">Sommaire</a><% if(nextLesson){%><a href="/student/courses/<%= enrollment.id %>/lessons/<%= nextLesson.id %>"><%= nextLesson.title %> →</a><%}%></nav></article>
<%- include('../../partials/footer') %>
