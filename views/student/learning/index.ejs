<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<header class="learning-hero"><div><p class="eyebrow">Apprentissage</p><h1><%= course.title %></h1><span class="status enrollment-status-<%= enrollment.status.toLowerCase() %>"><%= enrollment.status %></span></div><div class="progress-ring"><strong><%= progress.progressPercentage %>%</strong><span>progression</span></div></header>
<section class="learning-overview"><span><strong><%= progress.completedLessons %></strong> terminée(s)</span><span><strong><%= progress.remainingLessons %></strong> restante(s)</span><span><strong><%= progress.estimatedMinutes %></strong> minutes</span></section>
<% if (!access.canViewContent) { %><div class="trial-notice trial-notice-blocked"><strong>Vos trois séances gratuites sont terminées.</strong><span>Vous pouvez consulter le sommaire, mais le contenu et les ressources restent bloqués jusqu’au paiement.</span></div><% } %>
<% if (!modules.length) { %><div class="empty-state">Aucun contenu publié pour le moment.</div><% } %>
<div class="learning-modules"><% modules.forEach(module => { %><section><div class="section-heading"><div><p class="eyebrow">Module <%= module.position %></p><h2><%= module.title %></h2><p><%= module.description || '' %></p></div><strong><%= module.completedLessons %>/<%= module.lessons.length %></strong></div>
<ol class="learning-lessons"><% module.lessons.forEach(lesson => { const done=lesson.lessonProgress[0]?.completedAt; const live=lesson.classMeetings[0]; %><li><span class="lesson-state"><%= done ? '✓' : lesson.position %></span><div><strong><%= lesson.title %></strong><small><%= lesson.estimatedMinutes ? `${lesson.estimatedMinutes} min` : 'Durée libre' %> · <%= done ? 'Terminée' : 'À suivre' %></small><small class="live-program-link"><% if(live){%>Cours live : <%= live.startsAt.toLocaleString('fr-FR', { timeZone: enrollment.trainingSession.timezone }) %> · <%= live.status %> · <%= enrollment.trainingSession.timezone %><%}else{%>Aucune séance live programmée<%}%></small></div><% if(access.canViewContent){%><a href="/student/courses/<%= enrollment.id %>/lessons/<%= lesson.id %>">Ouvrir</a><% } else { %><span class="locked-label">Bloquée</span><% } %></li><% }) %></ol></section><% }) %></div>
<% if(progress.nextLesson && access.canViewContent){%><a class="button" href="/student/courses/<%= enrollment.id %>/lessons/<%= progress.nextLesson.id %>">Continuer avec <%= progress.nextLesson.title %></a><%}%>
<%- include('../../partials/footer') %>
