<%- include('../../partials/header', { title }) %>
<%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Compte</p><h1>Mon profil</h1></div></header>
<div class="profile-grid">
<section class="card wide-card"><h2>Informations personnelles</h2>
  <% if (profileError) { %><p class="form-error"><%= profileError %></p><% } %><% if (profileSuccess) { %><p class="success-message">Profil mis à jour.</p><% } %>
  <form method="post" action="/student/profile"><label>Prénom<input name="firstName" value="<%= student.firstName %>" required></label><label>Nom<input name="lastName" value="<%= student.lastName %>" required></label><label>Téléphone<input name="phoneNumber" value="<%= student.phoneNumber %>" required></label><label>Mot de passe actuel <small>(requis si le téléphone change)</small><input name="currentPassword" type="password" autocomplete="current-password"></label><button class="button" type="submit">Enregistrer</button></form>
</section>
<section class="card wide-card"><h2>Changer le mot de passe</h2>
  <% if (passwordError) { %><p class="form-error"><%= passwordError %></p><% } %><% if (passwordSuccess) { %><p class="success-message">Mot de passe modifié.</p><% } %>
  <form method="post" action="/student/profile/password"><label>Mot de passe actuel<input name="currentPassword" type="password" required autocomplete="current-password"></label><label>Nouveau mot de passe<input name="newPassword" type="password" minlength="10" required autocomplete="new-password"></label><label>Confirmation<input name="confirmPassword" type="password" minlength="10" required autocomplete="new-password"></label><button class="button" type="submit">Modifier le mot de passe</button></form>
</section></div>
<%- include('../../partials/footer') %>
