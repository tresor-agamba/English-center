<%- include('../_header') %><h1>Évaluations écrites</h1><div class="card-grid"><% items.forEach(item => { %><article class="card"><h2><a href="/student/written-assessments/<%= item.id %>"><%= item.title %></a></h2><p><%= item.course.title %></p><p><%= item.timeLimitMinutes ? `${item.timeLimitMinutes} minutes` : 'Sans limite' %></p></article><% }) %></div><% if (!items.length) { %><p class="empty-state">Aucune évaluation disponible.</p><% } %><%- include('../../partials/footer') %>
