<%- include('../_header') %><h1>Résultat : <%= item.assessment.title %></h1><article class="card"><p class="stat-value"><%= item.evaluation.overallScore %> / <%= item.assessment.totalPoints %></p><p><%= item.evaluation.decision %></p><p><%= item.evaluation.feedback || '' %></p></article>
<% item.responses.forEach(r => { const q = item.assessment.questions.find(x => x.id === r.assessmentQuestionId); %><article class="card"><h2><%= q.prompt %></h2><p>Votre réponse : <%= r.textResponse || JSON.stringify(r.selectedOptions) %></p><p>Note : <%= r.awardedPoints %> / <%= q.points %></p><p><%= r.gradingFeedback || '' %></p><% if (q.explanation) { %><p><strong>Explication :</strong> <%= q.explanation %></p><% } %></article><% }) %><%- include('../_footer') %>
