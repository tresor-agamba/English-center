<%- include('../../partials/header', { title }) %>
<%- include('../_nav') %>
<section class="card certificate">
  <p class="eyebrow"><%= certificate.centerNameSnapshot %></p>
  <h1><%= certificate.certificateTitleSnapshot %></h1>
  <p>Le présent certificat atteste que</p>
  <h2><%= certificate.studentNameSnapshot %></h2>
  <p><%= certificate.certificateTextSnapshot %></p>
  <h2><%= certificate.courseNameSnapshot %></h2>
  <p>Session : <%= certificate.sessionNameSnapshot %></p>
  <p>N° <%= certificate.serialNumber %> — Émis le <%= new Intl.DateTimeFormat('fr-FR').format(certificate.issuedAt) %></p>
  <div class="certificate-actions">
    <a class="button" href="/student/certificates/<%= certificate.id %>/download">Télécharger le PDF officiel</a>
    <a href="/certificates/verify/<%= certificate.verificationCode %>">Vérifier en ligne</a>
  </div>
</section>
<%- include('../../partials/footer') %>
