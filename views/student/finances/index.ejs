<%- include('../_header') %>
<header class="page-heading"><div><p class="eyebrow">Finances</p><h1>Ma situation financière</h1></div></header>
<div class="stats-grid"><% Object.entries(totals).forEach(([currency,total])=>{ %><article class="stat-card"><span><%= currency %></span><strong><%= total.balance.toFixed(2) %></strong><small>Facturé <%= total.invoiced.toFixed(2) %> · payé <%= total.paid.toFixed(2) %></small></article><% }) %></div>
<% if(!invoices.length){%><div class="empty-state">Aucune facture.</div><%}%>
<% invoices.forEach(invoice=>{ %><article class="card"><h2><%= invoice.number %></h2><ul><% invoice.lines.forEach(line=>{ %><li><%= line.label %> : <%= line.amount.toFixed(2) %> <%= line.currency %></li><% }) %></ul><p>Total <%= invoice.totalAmount.toFixed(2) %> · payé <%= invoice.paidAmount.toFixed(2) %> · solde <%= invoice.balanceAmount.toFixed(2) %> <%= invoice.currency %></p><% invoice.payments.forEach(p=>{ %><p><%= p.paidAt.toLocaleDateString('fr-FR') %> · <%= p.amount.toFixed(2) %> · <a href="/student/finances/receipts/<%= p.receipt.id %>">Reçu <%= p.receipt.number %></a></p><% }) %></article><% }) %>
<%- include('../_footer') %>
