<%- include('../../partials/header', { title }) %>

<section class="payment-page">
  <div class="payment-heading">
    <div>
      <p class="eyebrow">Paiement sécurisé</p>
      <h1><%= payment.enrollment.trainingSession.course.title %></h1>
      <p><%= payment.enrollment.trainingSession.name %></p>
    </div>
    <span class="status payment-status payment-status-<%= payment.status.toLowerCase() %>"><%= payment.status %></span>
  </div>

  <div class="online-banner">
    <strong>Formation 100 % en ligne</strong>
    <span>Cette page utilise actuellement le simulateur de paiement English Center.</span>
  </div>

  <dl class="payment-details">
    <div><dt>Référence</dt><dd><code><%= payment.reference %></code></dd></div>
    <div><dt>Formation</dt><dd><%= new Intl.NumberFormat('fr-FR', { style: 'currency', currency: payment.currency }).format(Number(payment.baseAmount)) %></dd></div>
    <div><dt>Frais d’inscription</dt><dd><%= new Intl.NumberFormat('fr-FR', { style: 'currency', currency: payment.currency }).format(Number(payment.registrationFee)) %></dd></div>
    <div><dt>Ce versement</dt><dd><strong><%= new Intl.NumberFormat('fr-FR', { style: 'currency', currency: payment.currency }).format(Number(payment.amount)) %></strong></dd></div>
    <div><dt>Prix total historique</dt><dd><%= payment.access.expectedTotalAmount %> <%= payment.access.expectedCurrency %></dd></div>
    <div><dt>Déjà confirmé</dt><dd><%= payment.access.confirmedPaidAmount %> <%= payment.access.expectedCurrency %></dd></div>
    <div><dt>Solde restant</dt><dd><%= payment.access.remainingAmount %> <%= payment.access.expectedCurrency %></dd></div>
    <div><dt>Pourcentage payé</dt><dd><%= payment.access.paidPercentage %> %</dd></div>
    <div><dt>Palier actuel</dt><dd><%= payment.access.accessStage %></dd></div>
    <div><dt>Créé le</dt><dd><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(payment.createdAt) %></dd></div>
    <div><dt>Expiration</dt><dd><%= payment.expiresAt ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(payment.expiresAt) : 'Aucune' %></dd></div>
  </dl>

  <% if (payment.failureReason) { %>
    <p class="form-error" role="alert"><%= payment.failureReason %></p>
  <% } %>

  <% if (simulationEnabled && ['PENDING', 'PROCESSING'].includes(payment.status)) { %>
    <section class="simulation-panel">
      <h2>Simulation de développement</h2>
      <p>Ces actions seront désactivées en production.</p>
      <div class="simulation-actions">
        <form action="/payments/<%= payment.reference %>/simulate-success" method="post">
          <button class="button" type="submit">Simuler un paiement réussi</button>
        </form>
        <form action="/payments/<%= payment.reference %>/simulate-failure" method="post">
          <button class="button button-danger" type="submit">Simuler un paiement échoué</button>
        </form>
      </div>
    </section>
  <% } %>

  <p class="payment-security-note">Le montant est calculé et vérifié par le serveur. Aucune donnée bancaire n’est enregistrée sur cette page.</p>
  <p><a href="/student/payments">← Retour à mes paiements</a></p>
</section>

<%- include('../../partials/footer') %>
