<%- include('../../partials/header', { title }) %>
<%- include('../_nav') %>
<header class="page-heading"><div><p class="eyebrow">Facturation</p><h1>Mes paiements</h1></div></header>
<% const labels={PENDING:'En attente',PROCESSING:'En traitement',SUCCESS:'Réussi',FAILED:'Échoué',CANCELLED:'Annulé',EXPIRED:'Expiré',REFUNDED:'Remboursé'}; %>
<% if (!payments.length) { %><div class="empty-state"><strong>Aucun paiement</strong><p>Votre historique de paiements apparaîtra ici.</p></div><% } else { %><div class="table-wrapper responsive-table"><table><thead><tr><th>Référence</th><th>Formation</th><th>Montant</th><th>Statut</th><th>Créé</th><th>Expiration / paiement</th><th></th></tr></thead><tbody>
<% payments.forEach(payment => { const active=['PENDING','PROCESSING'].includes(payment.status) && (!payment.expiresAt || payment.expiresAt > new Date()); %><tr>
  <td data-label="Référence"><%= payment.reference %></td><td data-label="Formation"><%= payment.enrollment.trainingSession.course.title %></td><td data-label="Montant"><%= Number(payment.amount).toLocaleString('fr-FR') %> <%= payment.currency %></td>
  <td data-label="Statut"><span class="status payment-status-<%= payment.status.toLowerCase() %>"><%= labels[payment.status] %></span><% if (payment.status === 'FAILED') { %><small class="generic-failure">La tentative n’a pas abouti.</small><% } %></td>
  <td data-label="Créé"><%= payment.createdAt.toLocaleString('fr-FR') %></td><td data-label="Échéance"><%= payment.paidAt ? payment.paidAt.toLocaleString('fr-FR') : (payment.expiresAt ? payment.expiresAt.toLocaleString('fr-FR') : '—') %></td>
  <td data-label="Action"><% if (active) { %><a href="/payments/<%= payment.reference %>">Reprendre</a><% } %></td>
</tr><% }) %></tbody></table></div><% } %>
<%- include('../../partials/footer') %>
