<%- include('../../partials/header', { title }) %><%- include('../_nav') %>
<article class="card"><p class="eyebrow">Évaluation orale enregistrée</p><h1><%= assessment.title %></h1><p><%= assessment.description || '' %></p><p><strong>Consignes :</strong> <%= assessment.instructions %></p><p><%= assessment.questions.length %> question(s) · <%= assessment.totalPoints %> points · <%= assessment.maxAttempts %> tentative(s) maximum</p><% if (assessment.closeAt) { %><p>Fermeture : <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(assessment.closeAt) %></p><% } %><form method="post" action="/student/oral-assessments/<%= assessment.id %>/attempts"><%- csrfField() %><button class="button">Démarrer ou reprendre</button></form></article>
<%- include('../../partials/footer') %>
