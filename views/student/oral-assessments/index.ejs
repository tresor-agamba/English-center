<%- include('../_header') %><h1>Évaluations orales</h1>
<div class="card-grid"><% items.forEach(item => { const latest = item.attempts[0]; %><article class="card"><p class="eyebrow"><%= item.trainingSession?.name || item.course.title %></p><h2><a href="/student/oral-assessments/<%= item.id %>"><%= item.title %></a></h2><p><%= item._count.questions %> question(s) · <%= item.totalPoints %> points</p><p>Tentatives : <%= item.attempts.length %>/<%= item.maxAttempts %></p><% if (latest?.evaluation?.status === 'PUBLISHED') { %><a href="/student/oral-attempts/<%= latest.id %>/result">Voir le résultat</a><% } %></article><% }) %></div>
<% if (!items.length) { %><p class="empty-state">Aucune évaluation orale n’est disponible actuellement.</p><% } %><%- include('../../partials/footer') %>
