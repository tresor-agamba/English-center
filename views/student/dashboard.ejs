<%- include('_header') %>
<header class="page-heading student-dashboard-intro">
  <div><h1>Salut <%= student.firstName %></h1><p class="heading-copy">Voici votre parcours aujourd’hui.</p></div>
</header>

<section class="student-dashboard-next<%= nextMeeting ? '' : ' is-empty' %>" aria-labelledby="next-meeting-title">
  <span class="student-dashboard-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span>
  <div class="student-dashboard-next__content">
    <p class="eyebrow">Prochaine séance</p>
    <% if (nextMeeting) { %>
      <p class="student-dashboard-course"><%= nextMeeting.course.title %><% if (progress?.level) { %> — <%= String(progress.level).replaceAll('_', ' ') %><% } %></p>
      <h2 id="next-meeting-title"><%= nextMeeting.lesson?.title || nextMeeting.title || 'Séance générale' %></h2>
      <p class="student-dashboard-date"><%= nextMeeting.startsAt.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: nextMeeting.session.timezone }) %> · <%= nextMeeting.startsAt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: nextMeeting.session.timezone }) %>–<%= nextMeeting.endsAt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: nextMeeting.session.timezone }) %></p>
      <div class="student-dashboard-badges"><span class="student-ui-badge <%= nextMeeting.access.canJoin ? 'student-ui-badge--success' : 'student-ui-badge--primary' %>"><%= nextMeeting.access.label %></span><% if (progress?.level) { %><span class="student-ui-badge student-ui-badge--light"><%= String(progress.level).replaceAll('_', ' ') %></span><% } %></div>
      <% if (nextMeeting.access.canJoin) { %><p class="student-dashboard-access is-open">La fenêtre d’accès est ouverte maintenant.</p>
      <% } else if (nextMeeting.access.code === 'UPCOMING') { %><p class="student-dashboard-access">Le bouton Rejoindre sera disponible à l’ouverture de la fenêtre d’accès.</p>
      <% } else { %><p class="student-dashboard-access"><%= nextMeeting.access.label %></p><% } %>
    <% } else { %>
      <h2 id="next-meeting-title">Aucune séance programmée</h2>
      <p class="student-dashboard-access">Votre prochaine séance apparaîtra ici dès qu’elle sera planifiée.</p>
    <% } %>
  </div>
  <% if (nextMeeting?.access.canJoin) { %><a class="button student-dashboard-join" href="/class-meetings/<%= nextMeeting.id %>/join?enrollment=<%= nextMeeting.enrollmentId %>">Rejoindre la séance</a><% } %>
</section>

<section class="student-dashboard-progress" aria-labelledby="student-progress-title">
  <div class="section-heading"><div><p class="eyebrow">Mon parcours</p><h2 id="student-progress-title">Ma progression</h2></div><% if (progress) { %><a href="/student/courses/<%= progress.enrollmentId %>">Voir la formation</a><% } %></div>
  <% if (progress) { %>
    <div class="student-dashboard-progress__summary"><div class="student-dashboard-progress__identity"><strong class="student-dashboard-progress__course"><%= progress.courseTitle %></strong><% if (progress.level) { %><span class="student-ui-badge student-ui-badge--primary student-dashboard-progress__level"><%= String(progress.level).replaceAll('_', ' ') %></span><% } %></div><% if (progress.completedSessions !== null && progress.totalSessions !== null) { %><p class="student-ui-badge student-ui-badge--light student-dashboard-progress__count"><strong><%= progress.completedSessions %></strong> séance<%= progress.completedSessions === 1 ? '' : 's' %> sur <%= progress.totalSessions %></p><% } %></div>
    <% if (progress.percentage !== null) { %><div class="student-dashboard-progress__meter"><progress value="<%= progress.percentage %>" max="100"><%= progress.percentage %> %</progress><strong><%= progress.percentage %> %</strong></div><p class="student-dashboard-progress__caption"><strong><%= progress.percentage %> %</strong> terminé</p><% } else { %><p class="student-dashboard-muted">La progression sera affichée dès que des séances terminées seront disponibles.</p><% } %>
  <% } else { %><p class="student-dashboard-muted">Aucune progression disponible pour le moment.</p><% } %>
</section>

<section class="student-dashboard-actions" aria-label="Actions prioritaires">
  <article class="student-dashboard-action student-dashboard-action--assignments"><div class="student-dashboard-action__content"><div class="student-dashboard-action__heading"><span class="student-dashboard-action__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h5"/></svg></span><p class="eyebrow">Devoirs</p></div><% if (priorities.assignments.todo) { %><span class="student-ui-badge student-ui-badge--warning"><%= priorities.assignments.todo %> à remettre</span><% } %><strong class="student-dashboard-action__status"><%= priorities.assignments.todo ? `${priorities.assignments.todo} à remettre` : 'Aucun devoir à remettre' %></strong><p class="student-dashboard-action__description"><%= priorities.assignments.nextDueAt ? `Prochaine échéance : ${priorities.assignments.nextDueAt.toLocaleDateString('fr-FR')}` : 'Aucune action requise actuellement.' %></p></div><a class="student-dashboard-action__cta" href="/student/assignments">Voir mes devoirs <span aria-hidden="true">→</span></a></article>
  <article class="student-dashboard-action student-dashboard-action--payment <%= priorities.payment.required || priorities.payment.pending ? 'is-warning' : 'is-success' %>"><div class="student-dashboard-action__content"><div class="student-dashboard-action__heading"><span class="student-dashboard-action__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span><p class="eyebrow">Paiement</p></div><span class="student-ui-badge <%= priorities.payment.required || priorities.payment.pending ? 'student-ui-badge--warning' : 'student-ui-badge--success' %>"><%= priorities.payment.required ? 'Action requise' : (priorities.payment.pending ? 'En attente' : 'À jour') %></span><strong class="student-dashboard-action__status"><%= priorities.payment.required ? 'Paiement requis' : (priorities.payment.pending ? `${priorities.payment.pending} paiement${priorities.payment.pending > 1 ? 's' : ''} en attente` : 'À jour ✓') %></strong><p class="student-dashboard-action__description"><%= priorities.payment.required ? 'Une action est nécessaire pour poursuivre le parcours.' : (priorities.payment.pending ? 'Votre paiement est en cours de traitement.' : 'Aucune action requise actuellement.') %></p></div><a class="student-dashboard-action__cta" href="/student/payments">Voir mes paiements <span aria-hidden="true">→</span></a></article>
  <article class="student-dashboard-action student-dashboard-action--certificate <%= priorities.certificate.available ? 'is-success' : '' %>"><div class="student-dashboard-action__content"><div class="student-dashboard-action__heading"><span class="student-dashboard-action__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="9" r="6"/><path d="m8.5 14-1 7 4.5-2 4.5 2-1-7"/><path d="m9.5 9 1.5 1.5L14.5 7"/></svg></span><p class="eyebrow">Certificat</p></div><span class="student-ui-badge <%= priorities.certificate.available ? 'student-ui-badge--success' : 'student-ui-badge--secondary' %>"><%= priorities.certificate.available ? 'Disponible' : 'En progression' %></span><strong class="student-dashboard-action__status"><%= priorities.certificate.available ? 'Disponible' : 'En progression' %></strong><p class="student-dashboard-action__description"><%= priorities.certificate.available ? `${priorities.certificate.available} certificat${priorities.certificate.available > 1 ? 's' : ''} disponible${priorities.certificate.available > 1 ? 's' : ''}.` : 'Continuez votre parcours pour devenir éligible.' %></p></div><a class="student-dashboard-action__cta" href="/student/certificates">Voir mes certificats <span aria-hidden="true">→</span></a></article>
</section>

<section class="student-dashboard-schedule">
  <div class="section-heading"><div><p class="eyebrow">Agenda</p><h2>Mes prochaines séances</h2></div><a href="/student/schedule">Voir le calendrier</a></div>
  <% if (!upcomingMeetings.length) { %><div class="empty-state"><strong>Aucune séance à venir</strong><p>Vos prochaines séances apparaîtront ici.</p></div><% } else { %>
    <div class="student-dashboard-meetings">
      <% upcomingMeetings.forEach(meeting => { %><article>
        <time datetime="<%= meeting.startsAt.toISOString() %>"><span><%= meeting.startsAt.toLocaleDateString('fr-FR', { weekday: 'short', timeZone: meeting.session.timezone }) %></span><strong><%= meeting.startsAt.toLocaleDateString('fr-FR', { day: 'numeric', timeZone: meeting.session.timezone }) %></strong><small><%= meeting.startsAt.toLocaleDateString('fr-FR', { month: 'short', timeZone: meeting.session.timezone }) %></small></time>
        <div><span class="student-dashboard-meeting-time"><%= meeting.startsAt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: meeting.session.timezone }) %>–<%= meeting.endsAt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: meeting.session.timezone }) %></span><strong><%= meeting.lesson?.title || meeting.title || 'Séance générale' %></strong><span><%= meeting.course.title %></span><span class="student-ui-badge <%= meeting.access.canJoin ? 'student-ui-badge--success' : 'student-ui-badge--primary' %>"><%= meeting.access.label %></span></div><a href="/student/class-meetings/<%= meeting.id %>">Détails</a>
      </article><% }) %>
    </div>
  <% } %>
</section>
<%- include('_footer') %>
