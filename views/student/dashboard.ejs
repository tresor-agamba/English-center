<%- include('../partials/header', { title }) %>
<%- include('_nav') %>
<header class="page-heading">
  <div><p class="eyebrow">Espace étudiant</p><h1>Bonjour <%= student.firstName %></h1><p class="heading-copy">Retrouvez votre parcours et vos prochaines séances.</p></div>
</header>
<section class="student-stats" aria-label="Résumé">
  <% const cards = [
    ['Inscriptions actives', stats.activeEnrollments], ['Accès complets', stats.confirmed],
    ['Essais actifs', stats.trials], ['Paiements requis', stats.paymentRequired],
    ['Prochaines séances', stats.upcomingMeetings], ['Paiements réussis', stats.successfulPayments],
    ['Paiements en attente', stats.pendingPayments]
  ]; %>
  <% cards.forEach(([label, value]) => { %><article class="stat-card"><span class="stat-label"><%= label %></span><strong class="stat-value"><%= value %></strong></article><% }) %>
</section>
<section class="next-access-card">
  <div>
    <span class="stat-label">Prochain cours accessible</span>
    <% if (nextAccessibleMeeting) { %>
      <strong><%= nextAccessibleMeeting.course.title %> — <%= nextAccessibleMeeting.lesson?.title || nextAccessibleMeeting.title || 'Séance générale' %></strong>
      <small>La fenêtre d’accès est ouverte maintenant.</small>
    <% } else { %>
      <strong>Aucun accès ouvert actuellement</strong>
      <small>Le bouton apparaîtra automatiquement pendant la fenêtre autorisée.</small>
    <% } %>
  </div>
  <% if (nextAccessibleMeeting) { %>
    <a class="button button-small" href="/class-meetings/<%= nextAccessibleMeeting.id %>/join?enrollment=<%= nextAccessibleMeeting.enrollmentId %>">Rejoindre le cours</a>
  <% } %>
</section>
<section class="dashboard-panel">
  <div class="section-heading"><div><p class="eyebrow">Agenda</p><h2>Mes prochaines séances</h2></div><a href="/student/schedule">Tout voir</a></div>
  <% if (!upcomingMeetings.length) { %><div class="empty-state"><strong>Aucune séance à venir</strong><p>Vos prochaines séances apparaîtront ici.</p></div><% } else { %>
    <div class="student-meeting-list">
      <% upcomingMeetings.forEach(meeting => { %><article>
        <div><strong><%= meeting.course.title %></strong><span><%= meeting.lesson?.title || meeting.title || 'Séance générale' %> · <%= meeting.startsAt.toLocaleString('fr-FR', { timeZone: meeting.session.timezone }) %></span><small><%= meeting.session.name %> · <%= meeting.session.platform.replaceAll('_', ' ') %> · <%= meeting.access.label %></small><a href="/student/class-meetings/<%= meeting.id %>">Voir le détail</a></div>
        <% if (meeting.access.canJoin) { %><a class="button button-small" href="/class-meetings/<%= meeting.id %>/join?enrollment=<%= meeting.enrollmentId %>">Accéder</a><% } %>
      </article><% }) %>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
