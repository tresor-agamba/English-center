<%- include('../partials/header', { title }) %><%- include('_nav') %><h1><%= assignment.title %></h1><% rows.forEach(r => { %><article class="card"><h2><%= r.user.firstName %> <%= r.user.lastName %></h2><% if (r.submission) { %><p><%= r.submission.status %></p><form method="post" action="/teacher/assignments/<%= assignment.id %>/submissions/<%= r.submission.id %>/grade"><%- csrfField() %><input type="number" name="score" min="0" max="<%= assignment.maxScore %>" step=".01" required><textarea name="feedback" placeholder="Commentaire"></textarea><button class="button">Noter</button></form><% } else { %><p>Non remis</p><% } %></article><% }) %><%- include('../partials/footer') %>
