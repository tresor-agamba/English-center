<%- include('../partials/header', { title }) %><%- include('_nav') %><h1>Mes sessions</h1><div class="card-grid"><% sessions.forEach(s => { %><article class="card"><p class="eyebrow"><%= s.course.title %></p><h2><%= s.name %></h2><p><%= s._count.enrollments %> inscription(s)</p><a class="button" href="/teacher/sessions/<%= s.id %>">Gérer</a></article><% }) %></div><% if (!sessions.length) { %><p class="empty-state">Aucune session ne vous est affectée.</p><% } %><%- include('../partials/footer') %>
