<%- include('../../partials/header', { title }) %><h1><%= item.assessment.title %></h1><article class="card"><p><strong><%= item.status %></strong> — <%= item.scheduledStartAt.toLocaleString('fr-FR') %></p><div class="action-row"><a class="button" href="/teacher/live-oral-sessions/<%= item.id %>/join">Rejoindre</a><% if (['SCHEDULED','READY'].includes(item.status)) { %><form method="post" action="/teacher/live-oral-sessions/<%= item.id %>/start"><%- csrfField() %><button class="button">Démarrer</button></form><% } %><% if (item.status === 'IN_PROGRESS') { %><form method="post" action="/teacher/live-oral-sessions/<%= item.id %>/complete"><%- csrfField() %><button class="button">Terminer</button></form><% } %></div></article>
<% item.participants.forEach(p => { const evaluation = item.evaluations.find(e => e.enrollmentId === p.enrollmentId); %><article class="card"><h2><%= p.enrollment.user.firstName %> <%= p.enrollment.user.lastName %></h2>
<form method="post" action="/teacher/live-oral-sessions/<%= item.id %>/attendance" class="form-stack"><%- csrfField() %><input type="hidden" name="participantId" value="<%= p.id %>"><label>Présence<select name="status"><% ['PRESENT','LATE','ABSENT','EXCUSED','TECHNICAL_ISSUE'].forEach(s => { %><option <%= p.attendance?.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label><button class="button">Enregistrer la présence</button></form>
<% if (['COMPLETED','GRADED'].includes(item.status) && evaluation?.status !== 'PUBLISHED') { %><form method="post" action="/teacher/live-oral-sessions/<%= item.id %>/grade" class="form-stack"><%- csrfField() %><input type="hidden" name="enrollmentId" value="<%= p.enrollmentId %>"><% item.assessment.criteria.forEach((c, index) => { %><input type="hidden" name="scores[<%= index %>][criterionId]" value="<%= c.id %>"><label><%= c.label %> / <%= c.maxScore %><input type="number" step="0.01" min="0" max="<%= c.maxScore %>" name="scores[<%= index %>][score]" required></label><% }) %><label>Décision<select name="decision"><option>PASSED</option><option>FAILED</option><option>UNDECIDED</option></select></label><label>Feedback<textarea name="feedback"></textarea></label><button class="button">Enregistrer la correction</button></form><% } %>
<% if (evaluation?.status === 'DRAFT') { %><form method="post" action="/teacher/oral-evaluations/<%= evaluation.id %>/publish"><%- csrfField() %><button class="button">Publier le résultat</button></form><% } %><% if (evaluation?.status === 'PUBLISHED') { %><p>Résultat publié.</p><% } %></article><% }) %><%- include('../../partials/footer') %>
