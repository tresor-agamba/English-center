<%- include('../../partials/header', { title }) %><div class="section-heading"><h1>Oraux en direct</h1><a class="button" href="/teacher/live-oral-sessions/new">Planifier</a></div><div class="card-grid"><% items.forEach(item => { %><article class="card"><p class="eyebrow"><%= item.status %></p><h2><a href="/teacher/live-oral-sessions/<%= item.id %>"><%= item.assessment.title %></a></h2><p><%= item.scheduledStartAt.toLocaleString('fr-FR') %></p></article><% }) %></div><% if (!items.length) { %><p class="empty-state">Aucun oral assigné.</p><% } %><%- include('../../partials/footer') %>
