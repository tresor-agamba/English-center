<%- include('../partials/header', { title }) %><%- include('_nav') %><h1><%= meeting.title || 'Séance' %></h1><p><%= meeting.startsAt.toLocaleString('fr-FR') %> — <%= meeting.status %></p><form method="post" action="/teacher/meetings/<%= meeting.id %>/attendance"><%- csrfField() %><% rows.forEach((r,i) => { %><div class="list-row"><span><%= r.user.firstName %> <%= r.user.lastName %></span><input type="hidden" name="rows[<%= i %>][enrollmentId]" value="<%= r.id %>"><select name="rows[<%= i %>][status]"><% ['PRESENT','ABSENT','EXCUSED'].forEach(s => { %><option <%= r.currentAttendanceStatus === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div><% }) %><% if (rows.length) { %><button class="button">Enregistrer les présences</button><% } else { %><p>Aucun étudiant éligible.</p><% } %></form><form method="post" action="/teacher/meetings/<%= meeting.id %>/cancel"><%- csrfField() %><button class="button button-secondary">Annuler la séance</button></form><%- include('../partials/footer') %>
