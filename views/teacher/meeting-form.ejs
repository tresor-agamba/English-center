<%- include('../partials/header', { title }) %>
<%- include('_nav') %>
<h1>Nouvelle séance</h1>
<form class="form-card" method="post" action="/teacher/sessions/<%= session.id %>/meetings"><%- csrfField() %>
  <label>Leçon</label>
  <select name="lessonId"><option value="">Séance générale</option><% lessons.forEach(l => { %><option value="<%= l.id %>"><%= l.courseModule.title %> — <%= l.title %></option><% }) %></select>
  <label>Titre</label><input name="title">
  <label>Date</label><input type="date" name="date" required>
  <label>Début</label><input type="time" name="startTime" required>
  <label>Fin</label><input type="time" name="endTime" required>
  <label>Plateforme</label><select name="platform"><option>GOOGLE_MEET</option><option>ZOOM</option><option>MICROSOFT_TEAMS</option><option>JITSI</option><option>OTHER</option></select>
  <label>Lien privé HTTPS</label><input type="url" name="privateMeetingUrl" required>
  <input type="hidden" name="status" value="SCHEDULED">
  <button class="button">Créer</button>
</form>
<%- include('../partials/footer') %>
