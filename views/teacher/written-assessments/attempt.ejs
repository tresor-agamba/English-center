<%- include('../../partials/header', { title }) %><h1>Correction de <%= item.enrollment.user.firstName %> <%= item.enrollment.user.lastName %></h1>
<article class="card"><h2><%= item.assessment.title %></h2><p>Statut : <%= item.status %></p></article>
<form method="post" action="<%= base %>/<%= item.id %>/grade" class="form-stack"><% const manual = item.responses.filter(r => ['SHORT_TEXT','LONG_TEXT','ESSAY','READING_COMPREHENSION','LISTENING_COMPREHENSION'].includes(r.assessmentQuestion.type)); manual.forEach((r, i) => { %><article class="card"><h3><%= r.assessmentQuestion.prompt %></h3><p><%= r.textResponse || JSON.stringify(r.selectedOptions) %></p><input type="hidden" name="scores[<%= i %>][questionId]" value="<%= r.assessmentQuestionId %>"><label>Note / <%= r.assessmentQuestion.points %><input type="number" step="0.01" min="0" max="<%= r.assessmentQuestion.points %>" name="scores[<%= i %>][score]" value="<%= r.awardedPoints ?? '' %>" required></label><label>Commentaire<textarea name="scores[<%= i %>][feedback]"><%= r.gradingFeedback || '' %></textarea></label></article><% }) %><label>Feedback global<textarea name="feedback"></textarea></label><label>Points forts<textarea name="strengths"></textarea></label><label>Axes d’amélioration<textarea name="improvements"></textarea></label><button class="button">Enregistrer la correction</button></form>
<% if (item.evaluation?.status === 'DRAFT') { %><form method="post" action="<%= evaluationBase %>/<%= item.evaluation.id %>/publish"><button class="button">Publier le résultat</button></form><% } %><%- include('../../partials/footer') %>
