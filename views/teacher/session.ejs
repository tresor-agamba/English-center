<%- include('../partials/header', { title }) %><%- include('_nav') %><h1><%= session.name %></h1><p><%= session.course.title %></p>
<section><div class="page-heading"><h2>Séances</h2><a class="button" href="/teacher/sessions/<%= session.id %>/meetings/new">Planifier</a></div><% meetings.forEach(m => { %><div class="list-row"><span><%= m.startsAt.toLocaleString('fr-FR') %> — <%= m.title || 'Séance' %> — <%= m.status %></span><a href="/teacher/meetings/<%= m.id %>">Présences</a></div><% }) %></section>
<section class="card"><h2>Nouveau devoir de cette cohorte</h2><form method="post" action="/teacher/sessions/<%= session.id %>/assignments"><%- csrfField() %><input name="title" placeholder="Titre" required><textarea name="instructions" placeholder="Consignes" required></textarea><input name="maxScore" type="number" min="1" step=".01" value="20" required><input name="dueAt" type="datetime-local"><label><input type="checkbox" name="isPublished"> Publier</label><label><input type="checkbox" name="allowLateSubmission"> Retard autorisé</label><button class="button">Créer</button></form></section>
<section><h2>Devoirs</h2><% assignments.forEach(a => { %><div class="list-row"><span><%= a.title %> — <%= a._count.submissions %> soumission(s)</span><a href="/teacher/assignments/<%= a.id %>/submissions">Corriger</a></div><% }) %></section>
<section><h2>Étudiants</h2><% students.forEach(e => { %><p><%= e.user.firstName %> <%= e.user.lastName %> — <%= e.status %></p><% }) %></section><%- include('../partials/footer') %>
