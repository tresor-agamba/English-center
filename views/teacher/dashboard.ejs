<%- include('../partials/header', { title }) %><%- include('_nav') %><h1>Espace enseignant</h1>
<div class="stats-grid"><article class="stat-card"><span>Sessions</span><strong><%= sessions.length %></strong></article><article class="stat-card"><span>Étudiants</span><strong><%= studentCount %></strong></article><article class="stat-card"><span>Devoirs</span><strong><%= assignmentCount %></strong></article><article class="stat-card"><span>Prochaines séances</span><strong><%= nextMeetings.length %></strong></article></div>
<section><h2>Prochaines séances</h2><div class="card-grid"><% nextMeetings.forEach(m => { %><article class="card"><h3><%= m.title || m.trainingSession.name %></h3><p><%= m.startsAt.toLocaleString('fr-FR') %></p><a href="/teacher/meetings/<%= m.id %>">Ouvrir</a></article><% }) %></div><% if (!nextMeetings.length) { %><p class="empty-state">Aucune séance à venir.</p><% } %></section><%- include('../partials/footer') %>
