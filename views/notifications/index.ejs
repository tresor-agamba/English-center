<%- include('../partials/header', { title }) %>
<section class="page-heading"><div><p class="eyebrow">Centre de messages</p><h1>Notifications</h1></div><form method="post" action="/notifications/read-all"><%- csrfField() %><button class="button button-secondary">Tout marquer comme lu</button></form></section>
<div class="notification-list"><% notifications.forEach(n => { %><article class="card <%= n.readAt ? '' : 'notification-unread' %>"><p class="eyebrow"><%= n.type.replaceAll('_',' ') %> · <%= n.priority %></p><h2><%= n.title %></h2><p><%= n.message %></p><time><%= n.createdAt.toLocaleString('fr-FR') %></time><div class="form-actions"><% if (n.actionUrl) { %><a class="button button-small" href="<%= n.actionUrl %>">Ouvrir</a><% } %><% if (!n.readAt) { %><form method="post" action="/notifications/<%= n.id %>/read"><%- csrfField() %><button>Marquer comme lue</button></form><% } %><form method="post" action="/notifications/<%= n.id %>/delete"><%- csrfField() %><button>Supprimer</button></form></div></article><% }) %></div>
<% if (!notifications.length) { %><div class="empty-state"><h2>Aucune notification</h2><p>Vos nouveaux messages apparaîtront ici.</p></div><% } %><%- include('../partials/footer') %>
