<%- include('../../partials/header', { title }) %>
<div class="nva-catalog" data-course-catalog>
  <section class="nva-catalog-hero"><div class="nva-catalog-container nva-catalog-hero__grid"><div><p class="nva-catalog-eyebrow" data-i18n="catalog.hero.eyebrow">Catalogue des formations</p><h1 data-i18n="catalogue.title">Nos formations</h1><p data-i18n="catalog.hero.copy">Des parcours pratiques et structurés pour progresser avec confiance, où que vous soyez.</p></div><img src="/images/public/course-online-learning.jpg" alt="" width="760" height="506"></div></section>
  <div class="nva-catalog-container nva-catalog-content">
    <section class="nva-catalog-tools" aria-labelledby="catalog-tools-title">
      <div class="nva-catalog-tools__heading"><div><p class="nva-catalog-eyebrow" data-i18n="catalog.tools.eyebrow">Trouvez votre parcours</p><h2 id="catalog-tools-title" data-i18n="catalog.tools.title">Explorez les programmes</h2></div><ul class="nva-catalog-legend" aria-label="Statut des inscriptions" data-i18n-aria="catalog.legend.label"><li><span class="nva-public-badge__dot nva-dot--open"></span><span data-i18n="course.status.open">Inscriptions ouvertes</span></li><li><span class="nva-public-badge__dot nva-dot--soon"></span><span data-i18n="course.status.soon">Bientôt disponible</span></li><li><span class="nva-public-badge__dot nva-dot--closed"></span><span data-i18n="course.status.closed">Aucune session ouverte</span></li></ul></div>
      <div class="nva-catalog-search"><label for="course-search" data-i18n="catalog.search.label">Rechercher une formation</label><input id="course-search" type="search" data-course-search-input data-i18n-placeholder="catalog.search.placeholder" placeholder="Titre, catégorie ou niveau…" autocomplete="off"></div>
      <div class="nva-catalog-filters" aria-label="Filtrer par catégorie" data-i18n-aria="catalog.filters.label"><button type="button" class="is-active" data-course-category-filter="ALL" aria-pressed="true" data-i18n="catalog.filters.all">Toutes</button><% categories.forEach((category) => { %><button type="button" data-course-category-filter="<%= category.value %>" aria-pressed="false" data-i18n="<%= category.labelKey %>"><%= category.label %></button><% }) %></div>
    </section>
    <% if (!courseCards.length) { %><div class="nva-catalog-empty"><strong data-i18n="courses.empty.title">Aucune formation n'est actuellement disponible.</strong><p data-i18n="courses.empty.copy">De nouveaux programmes seront publiés prochainement.</p></div><% } else { %><section class="nva-catalog-grid" aria-label="Catalogue des formations" data-i18n-aria="a11y.courseCatalogue"><% courseCards.forEach((courseCard) => { %><%- include('../../partials/public-course-card', { courseCard }) %><% }) %></section><div class="nva-catalog-empty" data-course-no-results hidden><strong data-i18n="catalog.noResults.title">Aucune formation ne correspond.</strong><p data-i18n="catalog.noResults.copy">Essayez une autre recherche ou affichez toutes les catégories.</p></div><% } %>
  </div>
</div>
<%- include('../../partials/footer') %>
