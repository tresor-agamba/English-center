<%- include('../../partials/header', { title }) %>

<section class="catalog-hero polished-hero">
  <p class="eyebrow" data-i18n="courses.eyebrow">Our programs</p>
  <h1 data-i18n="courses.title">Find the course that fits your goals</h1>
  <p data-i18n="courses.copy">Explore currently published programs and choose your next step.</p>
  <a class="button button-large" href="/register" data-i18n="courses.register">Register</a>
</section>

<% if (!courses.length) { %>
  <div class="empty-state catalog-empty">
    <strong data-i18n="courses.empty.title">No courses are currently available.</strong>
    <p data-i18n="courses.empty.copy">New programs will be published soon.</p>
  </div>
<% } else { %>
  <section class="course-grid" aria-label="Course catalogue" data-i18n-aria="a11y.courseCatalogue">
    <% courses.forEach((course) => { const typeLabel = formatCourseType(course.courseType); const durationLabel = formatDuration(course); %>
      <article class="course-card" data-course-id="<%= course.id %>">
        <div class="course-card-content">
          <div class="course-meta">
            <span <% if (!typeLabel) { %>data-i18n="fallback.category"<% } %>><%= typeLabel || 'Category not specified' %></span>
            <% if (course.level) { %><span><%= course.level %></span><% } else { %><span data-i18n="fallback.level">Level not specified</span><% } %>
            <span <% if (!durationLabel) { %>data-i18n="fallback.duration"<% } %>><%= durationLabel || 'Duration not specified' %></span>
          </div>
          <h2><%= course.title %></h2>
          <p><%= course.shortDescription || course.description || 'Découvrez cette formation proposée par English Center.' %></p>
          <% if (course.nextSessionStart) { %><small><span data-i18n="courses.nextSession">Next session</span> · <time data-local-date datetime="<%= course.nextSessionStart.toISOString() %>"><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(course.nextSessionStart) %></time></small><% } %>
        </div>
        <div class="course-card-footer">
          <div>
            <% if (course.price !== null) { %>
              <strong><%= new Intl.NumberFormat('fr-FR', { style: 'currency', currency: course.currency }).format(Number(course.price)) %></strong>
            <% } else { %>
              <span>Prix sur demande</span>
            <% } %>
            <small><%= course.upcomingSessionCount %> session<%= course.upcomingSessionCount > 1 ? 's' : '' %> disponible<%= course.upcomingSessionCount > 1 ? 's' : '' %></small>
          </div>
          <a class="button button-small button-outline" href="/formations/<%= course.slug %>" data-i18n="courses.view">View course</a>
          <a class="button button-small" href="/register?course=<%= course.id %>" data-i18n="courses.register">Register</a>
        </div>
        <p class="online-course-label" data-i18n="benefits.online">100% online learning</p>
      </article>
    <% }) %>
  </section>
<% } %>

<%- include('../../partials/footer') %>
