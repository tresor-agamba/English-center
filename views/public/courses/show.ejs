<%- include('../../partials/header', { title }) %>

<p class="back-link"><a href="/formations"><span aria-hidden="true">←</span> <span data-i18n="detail.back">All courses</span></a></p>

<section class="course-detail-hero">
  <p class="eyebrow"><%= formatCourseType(course.courseType) %></p>
  <h1><%= course.title %></h1>
  <p class="course-lead"><%= course.shortDescription || course.description || '' %></p>
  <div class="course-facts">
    <span><strong data-i18n="detail.level">Level</strong><%= course.level || 'To be confirmed' %></span>
    <span><strong data-i18n="detail.duration">Duration</strong><%= formatDuration(course) %></span>
    <span><strong data-i18n="detail.mode">Format</strong><span data-i18n="detail.online">100% online</span></span>
    <span><strong data-i18n="detail.price">Indicative price</strong><%= course.price !== null ? new Intl.NumberFormat('fr-FR', { style: 'currency', currency: course.currency }).format(Number(course.price)) : 'On request' %></span>
  </div>
</section>

<main class="course-detail-grid">
  <section class="content-section">
    <h2 data-i18n="detail.about">About this course</h2>
    <p class="formatted-copy"><%= course.description || 'Detailed information will be available soon.' %></p>
  </section>
  <section class="content-section detail-info-grid">
    <article><h2 data-i18n="detail.objectives">Objectives</h2><p class="formatted-copy"><%= course.objectives || 'To be confirmed.' %></p></article>
    <article><h2 data-i18n="detail.audience">Who it is for</h2><p class="formatted-copy"><%= course.targetAudience || 'Anyone who wants to improve their English.' %></p></article>
    <article><h2 data-i18n="detail.prerequisites">Prerequisites</h2><p class="formatted-copy"><%= course.prerequisites || 'No specific prerequisites.' %></p></article>
  </section>
</main>

<section class="section-block public-sessions" aria-labelledby="sessions-title">
  <div class="section-heading"><div><p class="eyebrow" data-i18n="detail.calendar">Schedule</p><h2 id="sessions-title" data-i18n="detail.sessions">Upcoming sessions</h2></div></div>
  <% if (!course.trainingSessions.length) { %>
    <div class="empty-state"><strong data-i18n="detail.empty">No sessions scheduled</strong><p data-i18n="detail.emptyCopy">New dates will be published soon.</p></div>
  <% } else { %>
    <div class="public-session-grid">
      <% course.trainingSessions.forEach((session) => { %>
        <article class="public-session-card">
          <span class="status <%= session.registrationOpen ? 'status-active' : 'status-inactive' %>" data-i18n="<%= session.registrationOpen ? 'detail.open' : 'detail.closed' %>"><%= session.registrationOpen ? 'Registration open' : 'Registration closed' %></span>
          <h3><%= session.name %></h3>
          <dl class="session-facts">
            <div><dt data-i18n="detail.start">Start</dt><dd><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(session.startDate) %></dd></div>
            <div><dt data-i18n="detail.end">End</dt><dd><%= new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(session.endDate) %></dd></div>
            <div><dt data-i18n="detail.seats">Seats</dt><dd><%= session.remainingPlaces %> / <%= session.capacity %></dd></div>
            <div><dt data-i18n="detail.days">Days</dt><dd><%= formatWeekDays(session.weekDays) %></dd></div>
            <div><dt data-i18n="detail.hours">Hours</dt><dd><%= session.startTime %> – <%= session.endTime %></dd></div>
            <div><dt data-i18n="detail.timezone">Time zone</dt><dd><%= session.timezone %></dd></div>
            <div><dt data-i18n="detail.platform">Platform</dt><dd><%= session.platform || 'Online' %></dd></div>
          </dl>
          <% if (session.registrationOpen) { %>
            <a class="button session-register-button" href="/register?session=<%= session.id %>" data-i18n="nav.register">Register</a>
            <a class="existing-account-link" href="/login?session=<%= session.id %>" data-i18n="detail.account">Already have an account? Sign in</a>
          <% } else { %>
            <span class="button session-register-button button-disabled" aria-disabled="true" data-i18n="detail.closed">Registration closed</span>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../../partials/footer') %>
