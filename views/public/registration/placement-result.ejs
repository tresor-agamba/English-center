<%- include('../../partials/header', { title }) %>
<section class="card placement-result">
  <p class="eyebrow">Test terminé</p>
  <h1>Votre niveau recommandé est <%= enrollment.recommendedLevel.replace('_', ' ') %></h1>
  <p>Score obtenu : <strong><%= enrollment.placementTestScore %> %</strong>.</p>
  <p>Vous aviez demandé <strong><%= enrollment.requestedLevel.replace('_', ' ') %></strong>. Votre niveau approuvé est <strong><%= enrollment.approvedLevel.replace('_', ' ') %></strong>.</p>
  <% if (enrollment.approvedLevel !== enrollment.requestedLevel) { %><p class="placement-explanation">Ce niveau vous permettra de consolider les compétences nécessaires avant de progresser vers le niveau demandé. Votre compte et votre inscription restent actifs.</p><% } %>
  <a class="button" href="/student">Accéder à mon tableau de bord</a>
</section>
<%- include('../../partials/footer') %>
