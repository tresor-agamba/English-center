<%- include('../../partials/header', { title }) %>

<section class="registration-success">
  <% const statusDisplay = {
    TRIAL_ACTIVE: { label: 'Inscription gratuite active', key: 'success.status.trial', className: 'status-active' },
    PAYMENT_REQUIRED: { label: 'Paiement requis', key: 'success.status.payment', className: 'status-pending' },
    CONFIRMED: { label: 'Inscription confirmée', key: 'success.status.confirmed', className: 'status-active' },
    CANCELLED: { label: 'Inscription annulée', key: 'success.status.cancelled', className: 'status-inactive' },
    PAYMENT_FAILED: { label: 'Paiement échoué', key: 'success.status.failed', className: 'status-inactive' }
  }[enrollment.status] || { label: enrollment.status, className: '' }; %>
  <% const latestPayment = enrollment.payments[0] || null; %>
  <% const successfulPayment = enrollment.payments.find((payment) => payment.status === 'SUCCESS') || null; %>

  <div class="success-icon" aria-hidden="true">✓</div>
  <p class="eyebrow" data-i18n="success.eyebrow">Inscription enregistrée</p>
  <h1 data-i18n="<%= enrollment.status === 'CONFIRMED' ? 'success.confirmedTitle' : 'success.reservedTitle' %>"><%= enrollment.status === 'CONFIRMED' ? 'Votre inscription est confirmée' : 'Votre place est réservée' %></h1>
  <p><span data-i18n="success.welcome">Bienvenue</span>, <strong><%= enrollment.user.firstName %> <%= enrollment.user.lastName %></strong>.</p>

  <div class="success-summary">
    <div><span data-i18n="success.course">Formation</span><strong><%= enrollment.trainingSession.course.title %></strong></div>
    <div><span data-i18n="success.session">Session</span><strong><%= enrollment.trainingSession.name %></strong></div>
    <div><span data-i18n="success.dates">Dates</span><strong><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(enrollment.trainingSession.startDate) %> – <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(enrollment.trainingSession.endDate) %></strong></div>
    <div><span data-i18n="success.hours">Horaires</span><strong><%= enrollment.trainingSession.startTime %> – <%= enrollment.trainingSession.endTime %></strong></div>
    <div><span data-i18n="success.price">Prix</span><strong><%= enrollment.trainingSession.course.price !== null ? new Intl.NumberFormat('fr-FR', { style: 'currency', currency: enrollment.trainingSession.course.currency }).format(Number(enrollment.trainingSession.course.price)) : 'Sur demande' %></strong></div>
    <div><span data-i18n="success.status">Statut</span><strong class="status <%= statusDisplay.className %>" <% if (statusDisplay.key) { %>data-i18n="<%= statusDisplay.key %>"<% } %>><%= statusDisplay.label %></strong></div>
  </div>

  <% if (enrollment.status === 'TRIAL_ACTIVE') { %>
    <div class="trial-notice trial-notice-active">
      <strong data-i18n="success.trialActive">Votre essai gratuit est actif.</strong>
      <span><span data-i18n="success.attended">Séances suivies</span> : <%= trialAccess.trialAttendanceCount %> / <%= trialAccess.trialLimit %></span>
      <span><span data-i18n="success.remaining">Séances gratuites restantes</span> : <%= trialAccess.remainingTrialAttendances %></span>
    </div>
  <% } else if (enrollment.status === 'PAYMENT_REQUIRED') { %>
    <div class="trial-notice trial-notice-blocked">
      <strong data-i18n="success.trialEnded">Votre période d’essai de 5 séances est terminée.</strong>
      <% if (trialAccess.accessStage === 'PAYMENT_REQUIRED_FULL') { %><span>Vous avez terminé les 10 premières séances autorisées. Veuillez payer le solde restant pour accéder aux 6 dernières séances du niveau.</span>
      <% } else { %><span data-i18n="success.payToContinue">Vous devez payer au moins 50 % du prix total pour accéder aux 5 séances suivantes.</span><% } %>
    </div>
  <% } else if (enrollment.status === 'CONFIRMED') { %>
    <div class="trial-notice trial-notice-confirmed">
      <strong data-i18n="success.fullAccess">Accès complet à la formation</strong>
      <span data-i18n="success.paymentConfirmedCopy">Votre paiement est confirmé et la limite d’essai ne s’applique plus.</span>
    </div>
  <% } %>

  <% if (successfulPayment) { %>
    <div class="payment-notice payment-notice-success">
      <strong data-i18n="success.paymentConfirmed">Paiement confirmé</strong>
      <span><span data-i18n="error.reference">Référence</span> : <%= successfulPayment.reference %></span>
      <% if (successfulPayment.paidAt) { %><span><span data-i18n="success.paidOn">Payé le</span> <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(successfulPayment.paidAt) %></span><% } %>
    </div>
  <% } else if (latestPayment && latestPayment.status === 'FAILED') { %>
    <div class="payment-notice payment-notice-failed">
      <strong data-i18n="success.lastPaymentFailed">La dernière tentative de paiement a échoué.</strong>
      <span data-i18n="success.retryCopy">Vous pouvez créer une nouvelle tentative.</span>
    </div>
  <% } else if (latestPayment && ['PENDING', 'PROCESSING'].includes(latestPayment.status)) { %>
    <div class="payment-notice">
      <strong data-i18n="success.paymentPending">Une tentative de paiement est en attente.</strong>
      <a href="/payments/<%= latestPayment.reference %>" data-i18n="success.resumePayment">Reprendre le paiement</a>
    </div>
  <% } %>

  <div class="success-actions">
    <% if (['TRIAL_ACTIVE', 'PAYMENT_REQUIRED'].includes(enrollment.status)) { %>
      <form action="/payments" method="post">
        <input type="hidden" name="enrollmentId" value="<%= enrollment.id %>" />
        <input type="hidden" name="currency" value="<%= trialAccess.expectedCurrency %>" />
        <label for="payment-amount">Montant à payer (<%= trialAccess.expectedCurrency %>)</label>
        <input id="payment-amount" name="amount" type="number" min="0.01" step="0.01" max="<%= trialAccess.remainingAmount %>" value="<%= trialAccess.nextRequiredPaymentAmount %>" required>
        <p>Inscription gratuite · Déjà payé : <strong><%= trialAccess.confirmedPaidAmount %></strong> · Solde : <strong><%= trialAccess.remainingAmount %> <%= trialAccess.expectedCurrency %></strong></p>
        <button class="button" type="submit" data-i18n="<%= latestPayment && latestPayment.status === 'FAILED' ? 'success.retryPayment' : 'success.payNow' %>"><%= latestPayment && latestPayment.status === 'FAILED' ? 'Réessayer le paiement' : 'Payer maintenant' %></button>
      </form>
    <% } %>
    <span class="future-link" aria-disabled="true" data-i18n="success.studentSoon">Espace étudiant — bientôt disponible</span>
    <a href="/" data-i18n="error.home">Retour à l’accueil</a>
  </div>

  <% if (classMeetings.length) { %>
    <section class="meeting-list">
      <h2 data-i18n="success.meetings">Séances de formation</h2>
      <% classMeetings.forEach((meeting) => { %>
        <article>
          <div>
            <strong><%= meeting.title || 'Séance de formation' %></strong>
            <span><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' }).format(meeting.startsAt) %></span>
          </div>
          <% if (meeting.access.canJoin) { %>
            <a class="button button-small" href="/class-meetings/<%= meeting.id %>/join?enrollment=<%= enrollment.id %>" data-i18n="success.join">Accéder au cours</a>
          <% } else { %>
            <span class="status status-inactive" data-i18n="success.blocked">Accès bloqué</span>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% } %>
</section>

<%- include('../../partials/footer') %>
