<%- include('../../partials/header', { title }) %>

<section class="registration-success">
  <% const statusDisplay = {
    TRIAL_ACTIVE: { label: 'Inscription gratuite active', className: 'status-active' },
    PAYMENT_REQUIRED: { label: 'Paiement requis', className: 'status-pending' },
    CONFIRMED: { label: 'Inscription confirmée', className: 'status-active' },
    CANCELLED: { label: 'Inscription annulée', className: 'status-inactive' },
    PAYMENT_FAILED: { label: 'Paiement échoué', className: 'status-inactive' }
  }[enrollment.status] || { label: enrollment.status, className: '' }; %>
  <% const latestPayment = enrollment.payments[0] || null; %>
  <% const successfulPayment = enrollment.payments.find((payment) => payment.status === 'SUCCESS') || null; %>

  <div class="success-icon" aria-hidden="true">✓</div>
  <p class="eyebrow">Inscription enregistrée</p>
  <h1><%= enrollment.status === 'CONFIRMED' ? 'Votre inscription est confirmée' : 'Votre place est réservée' %></h1>
  <p>Bienvenue, <strong><%= enrollment.user.firstName %> <%= enrollment.user.lastName %></strong>.</p>

  <div class="success-summary">
    <div><span>Formation</span><strong><%= enrollment.trainingSession.course.title %></strong></div>
    <div><span>Session</span><strong><%= enrollment.trainingSession.name %></strong></div>
    <div><span>Dates</span><strong><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(enrollment.trainingSession.startDate) %> – <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(enrollment.trainingSession.endDate) %></strong></div>
    <div><span>Horaires</span><strong><%= new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(enrollment.trainingSession.startDate) %> – <%= new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(enrollment.trainingSession.endDate) %></strong></div>
    <div><span>Prix</span><strong><%= enrollment.trainingSession.course.price !== null ? new Intl.NumberFormat('fr-FR', { style: 'currency', currency: enrollment.trainingSession.course.currency }).format(Number(enrollment.trainingSession.course.price)) : 'Sur demande' %></strong></div>
    <div><span>Statut</span><strong class="status <%= statusDisplay.className %>"><%= statusDisplay.label %></strong></div>
  </div>

  <% if (enrollment.status === 'TRIAL_ACTIVE') { %>
    <div class="trial-notice trial-notice-active">
      <strong>Votre essai gratuit est actif.</strong>
      <span>Séances suivies : <%= trialAccess.trialAttendanceCount %> sur <%= trialAccess.trialLimit %></span>
      <span>Séances gratuites restantes : <%= trialAccess.remainingTrialAttendances %></span>
    </div>
  <% } else if (enrollment.status === 'PAYMENT_REQUIRED') { %>
    <div class="trial-notice trial-notice-blocked">
      <strong>Vos trois séances gratuites sont terminées.</strong>
      <span>Payez la formation pour continuer à accéder aux cours.</span>
    </div>
  <% } else if (enrollment.status === 'CONFIRMED') { %>
    <div class="trial-notice trial-notice-confirmed">
      <strong>Accès complet à la formation</strong>
      <span>Votre paiement est confirmé et la limite d’essai ne s’applique plus.</span>
    </div>
  <% } %>

  <% if (successfulPayment) { %>
    <div class="payment-notice payment-notice-success">
      <strong>Paiement confirmé</strong>
      <span>Référence : <%= successfulPayment.reference %></span>
      <% if (successfulPayment.paidAt) { %><span>Payé le <%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(successfulPayment.paidAt) %></span><% } %>
    </div>
  <% } else if (latestPayment && latestPayment.status === 'FAILED') { %>
    <div class="payment-notice payment-notice-failed">
      <strong>La dernière tentative de paiement a échoué.</strong>
      <span>Vous pouvez créer une nouvelle tentative.</span>
    </div>
  <% } else if (latestPayment && ['PENDING', 'PROCESSING'].includes(latestPayment.status)) { %>
    <div class="payment-notice">
      <strong>Une tentative de paiement est en attente.</strong>
      <a href="/payments/<%= latestPayment.reference %>">Reprendre le paiement</a>
    </div>
  <% } %>

  <div class="success-actions">
    <% if (['TRIAL_ACTIVE', 'PAYMENT_REQUIRED'].includes(enrollment.status)) { %>
      <form action="/payments" method="post">
        <input type="hidden" name="enrollmentId" value="<%= enrollment.id %>" />
        <button class="button" type="submit"><%= latestPayment && latestPayment.status === 'FAILED' ? 'Réessayer le paiement' : 'Payer maintenant' %></button>
      </form>
    <% } %>
    <span class="future-link" aria-disabled="true">Espace étudiant — bientôt disponible</span>
    <a href="/">Retour à l’accueil</a>
  </div>

  <% if (classMeetings.length) { %>
    <section class="meeting-list">
      <h2>Séances de formation</h2>
      <% classMeetings.forEach((meeting) => { %>
        <article>
          <div>
            <strong><%= meeting.title || 'Séance de formation' %></strong>
            <span><%= new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' }).format(meeting.startsAt) %></span>
          </div>
          <% if (trialAccess.hasCourseAccess) { %>
            <a class="button button-small" href="/class-meetings/<%= meeting.id %>/join?enrollment=<%= enrollment.id %>">Accéder au cours</a>
          <% } else { %>
            <span class="status status-inactive">Accès bloqué</span>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% } %>
</section>

<%- include('../../partials/footer') %>
