<%- include('../../partials/header', { title }) %>
<section class="nva-register" data-register-page>
  <div class="nva-register-container nva-register-layout">
    <aside class="nva-register-intro">
      <div><p class="nva-register-eyebrow" data-i18n="register.eyebrow">Inscription</p><h1 data-i18n="register.hero.title">Une inscription simple, claire et sécurisée.</h1><p data-i18n="register.hero.copy">Choisissez une formation ouverte, créez votre compte étudiant et rejoignez la prochaine session admissible.</p></div>
      <div class="nva-register-photo"><picture><source type="image/webp" srcset="/images/optimized/pic-8-480.webp 480w, /images/optimized/pic-8-768.webp 768w, /images/optimized/pic-8-1024.webp 1024w" sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 480px"><img src="/images/nva/pic-8.png" alt="" width="1024" height="1024" loading="eager" fetchpriority="high"></picture></div>
      <ul class="nva-register-promises"><li><span aria-hidden="true">01</span><span data-i18n="register.promise.open">Formations réellement ouvertes</span></li><li><span aria-hidden="true">02</span><span data-i18n="register.promise.secure">Données et mot de passe protégés</span></li><li><span aria-hidden="true">03</span><span data-i18n="register.promise.guided">Parcours guidé selon votre niveau</span></li></ul>
    </aside>

    <div class="nva-register-card">
      <header class="nva-register-card__heading"><p class="nva-register-eyebrow" data-i18n="register.form.eyebrow">Votre demande</p><h2 data-i18n="form.title">Créez votre compte étudiant</h2><p data-i18n="form.copy">Choisissez votre formation et votre niveau. Votre téléphone sera votre identifiant.</p></header>
      <% if (error) { %><div class="nva-register-alert" role="alert"><strong data-i18n="register.error.title">Vérifiez les informations saisies</strong><p data-public-error><%= error %></p><% if (accountExists) { %><a href="/login<%= session ? `?session=${session.id}` : '' %>" data-i18n="login.button">Se connecter</a><% } %></div><% } %>
      <form class="nva-register-form public-stitch-form" action="/register" method="post" data-public-registration-form data-multistep-register><%- csrfField() %>
        <div class="nva-register-field nva-register-field--full">
          <% if (session) { %><input type="hidden" name="sessionId" value="<%= session.id %>"><input type="hidden" name="courseId" value="<%= session.course.id %>" data-course-title="<%= session.course.title %>" data-price="<%= session.course.price || 0 %>" data-fee="<%= session.course.registrationFee || 0 %>" data-currency="<%= session.course.currency %>"><span class="nva-register-label" data-i18n="form.course">Formation</span><div class="nva-register-selection"><strong><%= session.course.title %></strong><span><%= session.name %></span></div><% } else { %><label for="courseId" data-i18n="form.course">Formation</label><div class="nva-register-select-wrap"><select id="courseId" name="courseId" required data-register-course><option value="" data-i18n="form.course.placeholder">Sélectionnez une formation</option><% courses.forEach((course) => { %><option value="<%= course.id %>" data-session-name="<%= course.session?.name || '' %>" data-session-start="<%= course.session?.startDate?.toISOString() || '' %>" data-price="<%= course.price || 0 %>" data-fee="<%= course.registrationFee || 0 %>" data-currency="<%= course.currency || 'USD' %>" <%= String(form.courseId) === String(course.id) ? 'selected' : '' %>><%= course.title %></option><% }) %></select></div><% } %>
        </div>
        <% if (!session) { %><section class="nva-register-session" data-register-session aria-live="polite"><p class="nva-register-session__eyebrow" data-i18n="register.session.title">Session disponible</p><strong data-register-session-name data-i18n="register.session.choose">Choisissez d’abord une formation</strong><time data-register-session-date hidden></time></section><% } %>
        <div class="nva-register-grid">
          <span class="sr-only">Nom complet / Full name</span><input type="hidden" name="fullName" value="<%= form.fullName || [form.firstName, form.lastName].filter(Boolean).join(' ') %>">
          <div class="nva-register-field"><label for="firstName">Prénom</label><input id="firstName" name="firstName" value="<%= form.firstName || '' %>" autocomplete="given-name" maxlength="100" required></div>
          <div class="nva-register-field"><label for="lastName">Nom</label><input id="lastName" name="lastName" value="<%= form.lastName || '' %>" autocomplete="family-name" maxlength="100" required></div>
          <div class="nva-register-field"><label for="phoneNumber" data-i18n="form.phone">Numéro de téléphone</label><input id="phoneNumber" name="phoneNumber" type="tel" inputmode="tel" autocomplete="tel" value="<%= form.phoneNumber %>" placeholder="0821671174" aria-describedby="phone-help" required><small id="phone-help" data-i18n="form.phone.help">Ce numéro sera utilisé pour vous connecter.</small></div>
          <div class="nva-register-field"><label for="whatsappNumber">Numéro WhatsApp</label><input id="whatsappNumber" name="whatsappNumber" type="tel" inputmode="tel" autocomplete="tel" value="<%= form.whatsappNumber || '' %>" placeholder="+243812345678"></div>
          <div class="nva-register-field"><label for="email"><span data-i18n="form.email">Adresse email</span> <span class="optional" data-i18n="form.optional">(facultative)</span></label><input id="email" name="email" type="email" autocomplete="email" value="<%= form.email || '' %>"></div>
          <div class="nva-register-field"><label for="requestedLevel" data-i18n="form.level">Niveau demandé</label><div class="nva-register-select-wrap"><select id="requestedLevel" name="requestedLevel" required data-requested-level><option value="LEVEL_1" <%= form.requestedLevel === 'LEVEL_1' ? 'selected' : '' %> data-i18n="register.level.1">Niveau 1</option><option value="LEVEL_2" <%= form.requestedLevel === 'LEVEL_2' ? 'selected' : '' %> data-i18n="register.level.2">Niveau 2</option><option value="LEVEL_3" <%= form.requestedLevel === 'LEVEL_3' ? 'selected' : '' %> data-i18n="register.level.3">Niveau 3</option></select></div></div>
        </div>
        <div class="nva-register-field nva-register-field--full">
          <label for="groupId">Session et créneau</label>
          <div class="nva-register-select-wrap"><select id="groupId" name="groupId" <%= ((session?.registrationGroups || []).length || courses.some(c => c.session?.registrationGroups?.length)) ? 'required' : '' %>>
            <option value="">Sélectionnez un créneau</option>
            <% const groupCourses = session ? [{ id: session.course.id, title: session.course.title, session }] : courses; groupCourses.forEach((course) => { (course.session?.registrationGroups || []).forEach((group) => { %>
              <% if (!group.isFull) { %><option value="<%= group.id %>" data-course-id="<%= course.id %>" data-group-name="<%= group.name %>" data-days="<%= group.weekDays.join(' + ') %>" data-time="<%= group.startTime %>–<%= group.endTime %>" <%= String(form.groupId || '') === String(group.id) ? 'selected' : '' %>><%= course.title %> — <%= group.name %> — <%= group.weekDays.join(' + ') %> — <%= group.startTime %>–<%= group.endTime %> — <%= group.remainingPlaces %> places disponibles</option><% } %>
            <% }); }); %>
          </select></div>
        </div>
        <div class="level-guidance" aria-live="polite"><p data-level-message="LEVEL_1" data-i18n="form.level1">Aucun test de niveau obligatoire.</p><p data-level-message="LEVEL_2" data-i18n="form.level2" hidden>Un test est obligatoire avant votre admission au niveau 2.</p><p data-level-message="LEVEL_3" data-i18n="form.level3" hidden>Un test est obligatoire avant votre admission au niveau 3.</p></div>
        <div class="nva-register-field nva-register-field--full"><label for="learningObjective"><span data-i18n="register.objective">Objectif d’apprentissage</span> <span class="optional" data-i18n="form.optional">(facultatif)</span></label><textarea id="learningObjective" name="learningObjective" rows="4" maxlength="1000" data-i18n-placeholder="register.objective.placeholder" placeholder="Expliquez brièvement ce que vous souhaitez apprendre ou améliorer."><%= form.learningObjective || '' %></textarea><small data-i18n="register.objective.help">Cette précision aide à préparer votre parcours ; elle ne modifie pas votre admissibilité.</small></div>
        <div class="nva-register-grid nva-register-passwords"><div class="nva-register-field"><label for="password" data-i18n="form.password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required></div><div class="nva-register-field"><label for="passwordConfirmation" data-i18n="form.confirm">Confirmation du mot de passe</label><input id="passwordConfirmation" name="passwordConfirmation" type="password" autocomplete="new-password" minlength="8" required></div></div>
        <p class="nva-register-hint" data-i18n="form.password.help">Utilisez au moins 8 caractères. Les mots de passe ne sont jamais réaffichés.</p>
        <label class="nva-register-consent"><input type="checkbox" name="whatsappConsent" value="yes" <%= form.whatsappConsent ? 'checked' : '' %>><span><strong data-i18n="register.consent.title">Contact WhatsApp facultatif</strong><small data-i18n="register.consent.copy">J’accepte de recevoir sur WhatsApp les informations liées à mon inscription.</small></span></label>
        <input type="hidden" name="termsPresented" value="yes"><label class="nva-register-consent"><input type="checkbox" name="termsAccepted" value="yes" required><span><strong>Conditions d’inscription</strong><small>J’accepte les conditions d’inscription et confirme l’exactitude des informations.</small></span></label>
        <button class="nva-public-button nva-public-button-primary nva-register-submit" type="submit" data-registration-submit data-i18n="form.create">Créer mon compte</button>
      </form>
      <p class="nva-register-login"><span data-i18n="form.existing">Vous avez déjà un compte ?</span> <a href="/login<%= session ? `?session=${session.id}` : '' %>" data-i18n="login.button">Se connecter</a></p>
    </div>
  </div>
</section>
<%- include('../../partials/footer') %>
