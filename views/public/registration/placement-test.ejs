<%- include('../../partials/header', { title }) %>
<section class="placement-test">
  <p class="eyebrow">Admission — <%= enrollment.trainingSession.course.title %></p>
  <h1>Test de niveau obligatoire</h1>
  <p>Vous avez demandé <strong><%= enrollment.requestedLevel.replace('_', ' ') %></strong>. Répondez aux questions pour recevoir votre niveau recommandé.</p>
  <form method="post" action="/placement-test/<%= enrollment.id %>">
    <% questions.forEach((question, index) => { %>
      <fieldset class="card placement-question"><legend><%= index + 1 %>. <%= question.prompt %></legend>
        <% question.options.forEach((option) => { %><label><input type="radio" name="<%= question.id %>" value="<%= option %>" required> <%= option %></label><% }) %>
      </fieldset>
    <% }) %>
    <button class="button" type="submit">Valider mon test</button>
  </form>
</section>
<%- include('../../partials/footer') %>
