<%- include('../partials/header', { title }) %>
<section class="polished-hero public-page-hero">
  <p class="eyebrow" data-i18n="about.eyebrow">About the academy</p>
  <h1 data-i18n="about.title">Language learning built around practical progress</h1>
  <p class="hero-lead" data-i18n="about.intro">New Vision Academy provides structured language programs designed for personal, academic and professional development.</p>
</section>
<section class="landing-section about-pillars" aria-labelledby="mission-title">
  <article class="content-card"><span class="feature-icon" aria-hidden="true">01</span><h2 id="mission-title" data-i18n="about.mission.title">Our mission</h2><p data-i18n="about.mission.copy">Help learners build useful language skills through clear pathways, guided practice and measurable progression.</p></article>
  <article class="content-card"><span class="feature-icon" aria-hidden="true">02</span><h2 data-i18n="about.vision.title">Our vision</h2><p data-i18n="about.vision.copy">Make quality language learning accessible online while keeping teaching human, structured and accountable.</p></article>
  <article class="content-card"><span class="feature-icon" aria-hidden="true">03</span><h2 data-i18n="about.values.title">Our values</h2><p data-i18n="about.values.copy">Clarity, practical learning, learner support, integrity and continuous progress guide the academy.</p></article>
</section>
<section class="landing-section method-section">
  <div class="section-intro"><p class="eyebrow" data-i18n="about.method.eyebrow">Our approach</p><h2 data-i18n="about.method.title">A structured path from level choice to certification</h2><p data-i18n="about.method.copy">Published programs define their objectives, audience, prerequisites and schedule. Learners follow courses, activities and assessments from a dedicated student space.</p></div>
  <div class="audience-section"><div class="expect-card"><h3 data-i18n="about.audience.title">Who we support</h3><p data-i18n="about.audience.copy">Learners seeking personal improvement, academic support or professional language skills.</p></div><div class="expect-card"><h3 data-i18n="about.quality.title">Our quality commitment</h3><p data-i18n="about.quality.copy">We publish only available programs and sessions, protect learner information and provide verifiable certificates when issued.</p></div></div>
</section>
<section class="final-cta"><div><h2 data-i18n="about.cta.title">Explore the programs currently available</h2><p data-i18n="about.cta.copy">Compare published courses and choose the learning path that matches your goal.</p></div><a class="button button-large button-gold" href="/formations" data-i18n="hero.secondary">Explore Courses</a></section>
<%- include('../partials/footer') %>
