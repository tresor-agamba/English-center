NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
SESSION_SECRET=
SESSION_POOL_MAX=5
PUBLIC_APP_URL=
# Password recovery email (no delivery until explicitly configured)
# Origin only; HTTPS required in production, HTTP localhost allowed in development/tests.
APP_BASE_URL=
SMTP_HOST=
# Integer 1–65535. false requires STARTTLS; true uses direct TLS (usually port 465).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# One plain mailbox, without a display name
EMAIL_FROM=
PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_ENABLED=false
WHATSAPP_WORKERS_ENABLED=false
WHATSAPP_FAKE_MODE=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Incoming-only durable inbox. Two explicit flags are required for production.
META_WHATSAPP_INBOX_ENABLED=false
META_INBOX_PRODUCTION_AUTHORIZED=false
META_INBOX_ENVIRONMENT=test
# No fallback to DATABASE_URL. Test: 127.0.0.1:55432/nva_whatsapp_test,
# role nva_meta_inbox_ingress. Production: 127.0.0.1:5432/english_center,
# role nva_meta_inbox_ingress_prod. Inject credentials from a secret store.
META_INBOX_DATABASE_URL=
META_INBOX_ENDPOINT_ID=
META_INBOX_APPLICATION_KEY=
META_INBOX_APP_ID=
META_INBOX_AUTH_KEY_VERSION=
META_INBOX_LOOKUP_KEYS_JSON=
META_INBOX_LOOKUP_KEY_VERSION=
META_INBOX_STREAM_KEY_HEX=
META_INBOX_STREAM_KEY_VERSION=
META_INBOX_ENCRYPTION_KEYS_JSON=
META_INBOX_ENCRYPTION_KEY_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=243
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BATCH_SIZE=50
PRIVATE_STORAGE_ROOT=storage/private
TRUST_PROXY=1
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_MAX_SIZE_MB=2048
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_CONFIRMATION=
BACKUP_RESTORE_CONFIRMATION_INPUT=
BACKUP_TYPE=MANUAL
SHUTDOWN_TIMEOUT_MS=15000

# Développement et tests uniquement
TEST_DATABASE_URL=
CSRF_ENFORCE=false

# WhatsApp Chatbot ? aucune activation des envois
NVA_CHATBOT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
NVA_CHATBOT_AI_DAILY_CALL_LIMIT=50
